--! lore.pipe — RAG layer for world consistency in "Die Ruine von Aldenmoor"
--! Builds a vector index over the world lore once at startup and serves
--! small context snippets for look/talk_to. With the opencode provider
--! embed falls back to the local hash embedder — no API cost.

LORE_FILES: ["world/lore_history.txt", "world/lore_factions.txt", "world/npcs/waechter.txt"]
LORE_INDEX: [nil]

--! Reads all lore documents, embeds them once, caches the index.
fn build_lore_index _
    docs: []
    for f in LORE_FILES
        push docs (read_file f)
    vecs: embed_batch docs
    idx: {docs: docs, vectors: vecs}
    set LORE_INDEX 0 idx
    idx

--! Returns the most relevant lore snippet(s) for a query.
fn lore_context query
    idx: at LORE_INDEX 0
    if idx == nil
        ""
    else
        qv: embed query
        top: nearest qv (get idx "vectors") 1
        out: ""
        for i in top
            out: out ++ "\n---\n" ++ (at (get idx "docs") i)
        out
