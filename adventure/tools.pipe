--! tools.pipe — AI-callable game actions for "Die Ruine von Aldenmoor"
--! The LLM never mutates state directly: every ai_tool below goes through
--! pure functions in state.pipe, so the DB stays the single source of truth.

import "state.pipe"
import "lore.pipe"

-- Static NPC placement (room id per NPC).
NPC_AT: {waechter: "halle"}
WIN_ITEM: "muenze"

--! Joins a list of strings with a separator.
fn join_list lst sep
    out: ""
    n: 0
    for item in lst
        if n > 0
            out: out ++ sep
        out: out ++ item
        n: n + 1
    out

--! Factual description of the current room (the narrator LLM wraps this).
fn look _
    p: (get_player 0)
    room: get_room (get p "room")
    if room == nil
        "Du schwebst im Nichts. (Fehler: Raum unbekannt)"
    else
        fl: get_flavor (get p "room")
        basis: get room "description"
        if fl != ""
            basis: fl
        beschr: "== " ++ (get room "id") ++ " ==\n" ++ basis
        items: parse_json (get room "items")
        if len items > 0
            beschr: beschr ++ "\nHier liegt: " ++ (join_list items ", ")
        ms: monsters_in_room (get p "room")
        if len ms > 0
            namen: []
            for m in ms
                push namen (get m "name")
            beschr: beschr ++ "\nUntier hier: " ++ (join_list namen ", ")
        exits: parse_json (get room "exits")
        if len exits > 0
            beschr: beschr ++ "\nAusgänge: " ++ (join_list (keys exits) ", ")
        beschr

--! Moves through an exit; returns the new room description.
fn move_to exit_name
    p: (get_player 0)
    room: get_room (get p "room")
    if room == nil
        "Dein Ort ist unbekannt. (Fehler)"
    else
        exits: parse_json (get room "exits")
        if contains (keys exits) exit_name
            set_player_room (get exits exit_name)
            look 0
        else
            "Dorthin führt kein Weg."

--! Picks up an item from the current room.
fn take_item item_name
    p: (get_player 0)
    if inventory_has item_name
        "Das trägst du bereits."
    else
        if room_take_item (get p "room") item_name
            inventory_add item_name
            "Du nimmst: " ++ item_name
        else
            "Das liegt hier nicht."

--! Offers an item to an NPC. Giving the win item to the waechter breaks his curse.
fn give_item item_name npc
    p: (get_player 0)
    npc_room: get NPC_AT npc
    if npc_room != (get p "room")
        "Hier ist niemand namens " ++ npc ++ "."
    else
        if !inventory_has item_name
            "Das trägst du nicht bei dir."
        else
            inventory_remove item_name
            rep_add "alte_ordnung" 1
            meldung: npc ++ " betrachtet " ++ item_name ++ " schweigend und legt es beiseite."
            if item_name == WIN_ITEM && npc == "waechter"
                set_won 0
                quest_set "hauptquest" "erledigt"
                meldung: "Der Wächter nimmt die Münze mit beiden Handschuhen entgegen. Ein Riss läuft über seinen Harnisch -- wie Glas im Morgenlicht. \"Die Schuld kehrt heim\", raunt er, und für einen Herzschlag siehst du nicht Rost, sondern einen jungen Ritter lächeln. Der Fluch ist gelöst."
            else
                if item_name == "fackel" && npc == "waechter"
                    quest_set "lichtblick" "erledigt"
                    meldung: "Der Wächter nimmt die Fackel entgegen. Zum ersten Mal flackert Licht über sein Visier. \"Wache ist dunkel\", raunt er, \"Licht ist Gabe.\" Etwas in seiner Haltung wirkt weniger versteinert."
                else
                    if item_name == "heilkraut" && npc == "waechter"
                        meldung: "Der Wächter betrachtet das Heilkraut lange. \"Beifuß für die Wunden der Ordnung\", raunt er. Es klingt, als hätte er das Wort Dank im Sinn -- wenn er es noch dürfte."
            meldung

--! Finds an alive monster in the current room matching the given name/id.
fn find_monster name_or_id
    p: (get_player 0)
    ms: monsters_in_room (get p "room")
    found: [nil]
    for m in ms
        if (at found 0) == nil
            if (get m "id") == name_or_id
                set found 0 m
            else
                if contains (lower (get m "name")) (lower name_or_id)
                    set found 0 m
    at found 0

--! Attacks a monster in the current room; the monster strikes back.
fn attack_enemy target
    p: (get_player 0)
    m: find_monster target
    if m == nil
        "Hier gibt es kein Untier dieses Namens."
    else
        bonus: 0
        if inventory_has "schwert"
            bonus: 2
        dmg: (random_range 1 6) + bonus - (get m "defense")
        if dmg < 0
            dmg: 0
        hp: monster_hit (get m "id") dmg
        bericht: "Dein Angriff trifft für " ++ (to_str dmg) ++ " Schaden."
        if hp <= 0
            monster_defeat (get m "id")
            bericht: bericht ++ "\nDas Untier ist tot! Sein Fall legt frei: " ++ (get m "loot") ++ "."
        else
            rache: random_range 1 3
            php: (get p "hp") - rache
            set_player_hp php
            bericht: bericht ++ "\nEs schlägt zurück für " ++ (to_str rache) ++ " Schaden. (Deine HP: " ++ (to_str php) ++ ")"
            if php <= 0
                (respawn_player 0)
                bericht: bericht ++ "\nSchwarz wird es vor deinen Augen. Du erwachst am Eingang der Ruine -- die Dörfler haben dich hereingetragen, murmelnd über den Fluch der Ruine."
        bericht

--! Lists the quest log with states.
fn show_quests _
    qs: (all_quests 0)
    if len qs == 0
        "Keine Einträge im Quest-Log."
    else
        out: ""
        for qst in qs
            mark: "[ ]"
            if (get qst "state") == "erledigt"
                mark: "[x]"
            out: out ++ "\n" ++ mark ++ " " ++ (get qst "name") ++ ": " ++ (get qst "description")
        "Quest-Log:" ++ out

--! Shows what the player carries.
fn show_inventory _
    p: (get_player 0)
    inv: parse_json (get p "inventory")
    if len inv > 0
        "Du trägst bei dir: " ++ (join_list inv ", ")
    else
        "Deine Hände sind leer."

--! Talks to an NPC; reply comes from the LLM, memory is compressed via summarize.
fn talk_to npc last_message
    p: (get_player 0)
    npc_room: get NPC_AT npc
    if npc_room != (get p "room")
        "Hier ist niemand namens " ++ npc ++ "."
    else
        alt: get_npc_memory npc
        turns: npc_turns npc
        if (turns % 3) == 2
            mem: summarize (alt ++ "\nSpieler: " ++ last_message)
        else
            mem: alt
        lore: lore_context npc
        rep: rep_get "alte_ordnung"
        ton: "Der Wächter ist Fremden gegenüber misstrauisch und einsilbig."
        if rep >= 1
            ton: "Der Wächter hat eine Gabe von dir angenommen; er ist weniger verschlossen, fast respektvoll."
        if rep >= 3
            ton: "Der Wächter vertraut dir; er würde dir folgen, wenn er könnte."
        reply: ask ("Du bist der Wächter von Aldenmoor (Ser Aldric), ein verfluchter Ritter in rostendem Harnisch. Hintergrund:\n" ++ lore ++ "\n\nDeine Haltung: " ++ ton ++ "\n\nBisherige Erinnerung an dieses Gespräch:\n" ++ mem ++ "\nLetzte Äußerung des Abenteurers (muss in deine Erinnerung einfließen): \"" ++ last_message ++ "\"\n\nDer Abenteurer sagt: \"" ++ last_message ++ "\"\n\nAntworte in Charakter: rätselhaft, knapp, 1-3 Sätze. Verrate NIEMALS direkt die Lösung des Fluchs (ein freiwillig zurückgegebenes Stück des Erbes); du darfst nur andeuten.")
        set_npc_memory npc (summarize ("Gespräch mit dem Abenteurer. " ++ mem ++ "\nSpieler: " ++ last_message ++ "\nWächter: " ++ reply))
        reply

--! Extracts all words after the first as lowercase item/target name.
fn first_word s
    ws: split s " "
    if len ws > 0
        at ws 0
    else
        ""

fn rest_words cmd
    w: split cmd " "
    out: []
    i: 1
    if len w > 1
        a: lower (at w 1)
        if a == "die" || a == "den" || a == "der" || a == "das" || a == "ein" || a == "eine" || a == "the"
            i: 2
    while i < (len w)
        push out (lower (at w i))
        i: i + 1
    join_list out " "

--! Handles common commands locally (no AI): returns {handled, text}.
fn fast_command cmd
    t: lower (trim cmd)
    w: split t " "
    erstes: at w 0
    if erstes == "norden" || erstes == "n" || (erstes == "geh" && contains t "norden")
        {handled: true, out: move_to "norden"}
    else
        if erstes == "sueden" || erstes == "süden" || erstes == "s" || (erstes == "geh" && contains t "sueden")
            {handled: true, out: move_to "sueden"}
        else
            if erstes == "osten" || erstes == "o" || (erstes == "geh" && contains t "osten")
                {handled: true, out: move_to "osten"}
            else
                if erstes == "westen" || erstes == "w" || (erstes == "geh" && contains t "westen")
                    {handled: true, out: move_to "westen"}
                else
                    if erstes == "nimm" && len w > 1
                        {handled: true, out: take_item (rest_words t)}
                    else
                        if erstes == "inventar" || erstes == "inv" || erstes == "i"
                            {handled: true, out: show_inventory 0}
                        else
                            if erstes == "quests" || erstes == "aufgaben" || erstes == "log"
                                {handled: true, out: show_quests 0}
                            else
                                if (erstes == "schau" || erstes == "umschauen" || erstes == "look")
                                    {handled: true, out: look 0}
                                else
                                    if (erstes == "greife" || erstes == "angriff" || erstes == "kämpfe") && len w > 1
                                        {handled: true, out: attack_enemy (first_word (rest_words t))}
                                    else
                                        {handled: false, out: ""}

-- ---- Tool registration for ai_with_tools ----

ai_tool "look" "Beschreibe die aktuelle Umgebung" {} look
ai_tool "move_to" "Bewege den Spieler durch einen Ausgang (z.B. norden, sueden, osten, westen)" {exit_name: "Himmelsrichtung des Ausgangs"} move_to
ai_tool "take_item" "Hebe einen Gegenstand aus dem Raum auf" {item_name: "Name des Gegenstands, z.B. fackel"} take_item
ai_tool "give_item" "Biete einem NPC einen Gegenstand an" {item_name: "Name des Gegenstands", npc: "Name des NPC, z.B. waechter"} give_item
ai_tool "show_inventory" "Zeige das Inventar des Spielers" {} show_inventory
ai_tool "talk_to" "Sprich mit einem NPC im Raum" {npc: "Name des NPC, z.B. waechter", last_message: "Was der Spieler sagen möchte"} talk_to
ai_tool "attack_enemy" "Greife ein Untier im aktuellen Raum mit der Waffe an" {target: "Name des Untiers, z.B. kammerling"} attack_enemy
ai_tool "show_quests" "Zeige das Quest-Log" {} show_quests
ai_tool "save_game" "Speichere den Spielstand unter einem Namen" {name: "Name des Spielstands"} save_game
ai_tool "load_game" "Lade einen gespeicherten Spielstand" {name: "Name des Spielstands"} load_game
