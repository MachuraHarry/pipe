-- AI Pipeline Demo: GitHub Repo Analyzer
-- Combines: pipe-http + jpipe + pipe-tpl + AI
-- Install: pipe -get pipe-http && pipe -get jpipe && pipe -get pipe-tpl

import "pipe-http"
import "jpipe"
import "pipe-tpl"

print "=== AI Pipeline Demo: GitHub Repo Analyzer ==="
print ""

ai_provider "deepseek"
ai_model "deepseek-chat"

-- Set your API key via env: export DEEPSEEK_KEY=sk-...
-- or replace the line below:
ai_set_key "deepseek" (env "DEEPSEEK_KEY")

--- === 1. Fetch GitHub repos === ---

print "--- 1. Fetching repos from GitHub API ---"
auth: auth_bearer ""
r: hget "https://api.github.com/users/MachuraHarry/repos" auth
repos: parse_json (get r "body")
count: 0
if type_of repos == "LIST"
    count: len repos
print ("  Found " ++ (to_str count) ++ " repos")
if type_of repos == "MAP"
    msg: get repos "message"
    if msg != nil
        print ("  API message: " ++ msg)
        print "  Using mock repo data instead."
        print ""
        -- Mock data when rate-limited
        repos: []
        r1: {}
        set r1 "name" "pipe"
        set r1 "description" "Semantic Pipeline Runtime — AI-native scripting language"
        set r1 "language" "Go"
        push repos r1
        r2: {}
        set r2 "name" "Crisix"
        set r2 "description" "Minimal operating system kernel"
        set r2 "language" "Kotlin"
        push repos r2
        r3: {}
        set r3 "name" "CrisixDNS"
        set r3 "description" "Custom DNS resolver"
        set r3 "language" "Python"
        push repos r3
        count: 3
print ""

--- === 2. Extract with jpipe === ---

print "--- 2. Extracting repo data ---"
limit: count
if count > 5
    limit: 5

repo_list: []
i: 0
while i < limit
    repo: at repos i
    name: get repo "name"
    lang: get repo "language"
    desc: get repo "description"
    if lang == nil
        lang: "unknown"
    if desc == nil
        desc: ""

    entry: {}
    set entry "name" name
    set entry "language" lang
    set entry "description" desc
    push repo_list entry

    print ("  " ++ name ++ " (" ++ lang ++ ")")
    i: i + 1
print ""

--- === 3. AI analysis === ---

print "--- 3. AI: Summarizing repos ---"
summary_text: "GitHub repos:"
i: 0
while i < (len repo_list)
    r2: at repo_list i
    line: "  - "
    line: line ++ (get r2 "name")
    line: line ++ " ("
    line: line ++ (get r2 "language")
    line: line ++ ")"
    d: get r2 "description"
    if d != ""
        line: line ++ ": "
        line: line ++ d
    summary_text: summary_text ++ "\n" ++ line
    i: i + 1

prompt: summary_text ++ "\n\nAnalyze these GitHub repositories. What is the main focus? What technologies? Keep it under 3 sentences."
analysis: ask prompt
print ("  " ++ analysis)
print ""

--- === 4. Render report === ---

print "--- 4. Rendering report with pipe-tpl ---"
report_tpl: "=== GitHub Repo Report ===

Repositories: {{ total }}
Languages: {{ languages }}

{{ for repo in repos }}
  * {{ repo.name }} ({{ repo.language }})
    {{ repo.description }}
{{ end }}

=== AI Analysis ===
{{ analysis }}

Generated by Pipe SPR v0.8"

-- Collect languages
langs: ""
i: 0
while i < (len repo_list)
    r3: at repo_list i
    l: get r3 "language"
    if !(contains langs l)
        if langs != ""
            langs: langs ++ ", "
        langs: langs ++ l
    i: i + 1

report_data: {}
set report_data "total" limit
set report_data "languages" langs
set report_data "repos" repo_list
set report_data "analysis" analysis

report: render report_tpl report_data
print report
print ""

--- === 5. AI recommendation === ---

print "--- 5. AI: Project recommendations ---"
rec_prompt: "Based on these repos: " ++ summary_text ++ "\n\nWhat would be a good next project for this developer? One sentence."
rec: ask rec_prompt
print ("  " ++ rec)
print ""

print "=== Demo complete ==="
