--! Smoke test for the ask builtin with DeepSeek. Requires DEEPSEEK_API_KEY.

ai_provider "deepseek"

print "═══ TEST ═══"
print ""

ts: now
ask "Was sind die Vorteile von Pipeline-basierten Skriptsprachen? Antworte in 3 Stichpunkten auf Deutsch."
    > print
print ""
d: (now) - ts
print ("Dauer: " ++ (to_str d) ++ "s")
print ""
print "═══ DONE ═══"
