--! Simple calculator: one arithmetic function with symbol operators and print output.

--! Applies an operator to a and b; op is one of +, -, *, /, or %.
fn calc a op b
    match op
        | "+" -> a + b
        | "-" -> a - b
        | "*" -> a * b
        | "/" -> a / b
        | "%" -> a % b
        | _   -> 0

print "Rechner:"
print "10 + 5  = "
print (calc 10 "+" 5)
print "10 - 5  = "
print (calc 10 "-" 5)
print "10 * 5  = "
print (calc 10 "*" 5)
print "10 / 5  = "
print (calc 10 "/" 5)
print "10 % 3  = "
print (calc 10 "%" 3)
