--! docs-pipe dashboard: pipe-web + docs-pipe + sqlite + DeepSeek.
--! Indexes a Markdown documentation tree (PIPE_DOCS_DIR, default docs/en)
--! and serves a web UI for hybrid search + cited AI answers.
--! Web mode (default): PIPE_DOCS_DIR=docs/en ./bin/pipe examples/docs_pipe_dashboard.pipe
--! MCP mode:          PIPE_MODE=mcp DEEPSEEK_API_KEY=... ./bin/pipe examples/docs_pipe_dashboard.pipe

import "docs-pipe"
import "pipe-web"

ai_provider "deepseek"

--- === State === ---

__state: {idx: nil, dir: "", recent: []}

fn init _
    dir: env "PIPE_DOCS_DIR"
    if dir == nil || dir == ""
        dir: "docs/en"
    idx: doc_index dir {lang: "en", db: ":memory:"}
    set __state "idx" idx
    set __state "dir" dir

fn log_query q
    if q == nil || q == ""
        return nil
    recent: get __state "recent"
    if recent == nil
        recent: []
    push recent q
    if (len recent) > 20
        trimmed: []
        i: 1
        while i < (len recent)
            push trimmed (at recent i)
            i: i + 1
        recent: trimmed
    set __state "recent" recent
    nil

--- === Helpers === ---

fn esc_html s
    if s == nil
        s: ""
    s: replace_all s "&" "&amp;"
    s: replace_all s "<" "&lt;"
    s: replace_all s ">" "&gt;"
    s: replace_all s "\"" "&quot;"
    s

fn nl2br s
    s: replace_all s "\n" "<br>"
    s

fn lang_of path
    if contains path "/de/"
        return "de"
    if contains path "/en/"
        return "en"
    "auto"

fn lang_selected cur val
    if cur == val
        " selected"
    else
        ""

fn nav_cls active name
    if active == name
        " class=active"
    else
        ""

--- === Search highlighting === ---

fn tokenize_terms q
    low: lower q
    cleaned: regex_replace "[^a-z0-9äöüß_]+" " " low
    parts: split cleaned " "
    stops: split "a an the and or but if of in on at to for with about into is are was were be been being do does did doing how what which who this that these those it its as from by can could should would will not no nor your you we they he she has have had i me my them their there here when where why then than so too very just also using use der die das den dem des ein eine einer einem eines und oder aber wenn von im auf an zu zur zum für mit über ist sind war waren bin bist sein wird werden wie was welche wer dieser diese dieses es ich du er sie wir ihr man nicht kein keine auch als aus bei nach nur schon noch dann da hier dort warum wann" " "
    out: []
    i: 0
    while i < (len parts)
        t: at parts i
        if (len t) > 1 && (not (contains stops t))
            push out t
        i: i + 1
    out

fn mark_terms text terms
    low: lower text
    out: ""
    pos: 0
    while pos < (len text)
        best: -1
        blen: 0
        i: 0
        while i < (len terms)
            t: at terms i
            idx: index_of (substring low pos (len low)) t
            if idx >= 0
                if best < 0 || idx < best
                    best: pos + idx
                    blen: len t
            i: i + 1
        if best < 0
            out: out ++ (substring text pos (len text))
            pos: len text
        else
            out: out ++ (substring text pos best)
            out: out ++ "<mark>" ++ (substring text best (best + blen)) ++ "</mark>"
            pos: best + blen
    out

--- === Page chrome === ---

fn page_top title subtitle active
    "<!doctype html><html><head><title>" ++ title ++ "</title><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>
<style>
:root{--bg:#07070c;--bg2:#0d0d16;--bg3:#141420;--card:#11111c;--fg:#e8e8f0;--fg2:#9090a8;--fg3:#606078;--accent:#a855f7;--accent2:#7c3aed;--green:#3ce096;--red:#fc5c7c;--cyan:#5ce0fc;--border:#1e1e2e;--radius:10px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,sans-serif;line-height:1.6;overflow-x:hidden}
#pbar{position:fixed;top:0;left:0;right:0;height:3px;z-index:999;pointer-events:none;display:none}
#pbar.on{display:block}
#pbar.on::after{content:'';position:absolute;top:0;left:0;height:100%;width:40%;background:linear-gradient(90deg,transparent,var(--accent),var(--cyan),transparent);animation:pbar 1s linear infinite;border-radius:2px}
@keyframes pbar{0%{transform:translateX(-100%)}100%{transform:translateX(350%)}}
nav{position:sticky;top:0;z-index:100;background:rgba(7,7,12,0.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.nav-inner{max-width:900px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;height:56px}
.logo{font-weight:800;font-size:1.15rem;letter-spacing:-0.5px;text-decoration:none;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.nav-links{display:flex;gap:4px;align-items:center}
.nav-links a{color:var(--fg2);text-decoration:none;font-size:0.85rem;padding:6px 12px;border-radius:7px;transition:all .15s}
.nav-links a:hover{color:var(--fg);background:var(--bg3)}
.nav-links a.active{color:#fff;background:var(--accent)}
.hamburger{display:none;background:none;border:1px solid var(--border);color:var(--fg);font-size:1.2rem;cursor:pointer;border-radius:7px;padding:4px 10px}
header{position:relative;padding:48px 20px 8px;text-align:center;overflow:hidden}
header::before{content:'';position:absolute;top:-40%;left:-20%;width:140%;height:160%;background:radial-gradient(ellipse at 50% 0%,rgba(168,85,247,0.12) 0%,transparent 60%);pointer-events:none}
header h1{margin:0;font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;letter-spacing:-1px;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;position:relative;z-index:1}
header p{color:var(--fg2);font-size:0.85rem;margin:6px 0 0;position:relative;z-index:1}
.container{max-width:900px;margin:0 auto;padding:20px}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:22px;margin:16px 0;box-shadow:0 0 0 1px rgba(168,85,247,0.04),0 16px 48px rgba(0,0,0,0.4)}
.card h2{margin:0 0 12px;color:var(--accent2);font-size:0.8rem;text-transform:uppercase;letter-spacing:1px}
input[type=text],select{width:100%;box-sizing:border-box;background:var(--bg3);color:var(--fg);border:1px solid var(--border);border-radius:8px;padding:11px 14px;font-size:0.95rem;font-family:inherit}
input:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(168,85,247,0.15)}
.btn{display:inline-block;margin-top:12px;padding:10px 24px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:0.9rem;cursor:pointer;font-weight:600;box-shadow:0 4px 20px rgba(124,92,252,0.3);transition:all .15s}
.btn:hover{background:#8e72fc;transform:translateY(-1px)}
.btn.second{background:var(--bg3);color:var(--fg);border:1px solid var(--border);box-shadow:none}
.btn.second:hover{border-color:var(--accent);background:var(--bg3)}
.filters{display:flex;gap:8px;align-items:center;margin:10px 0}
.filters input[type=text]{flex:1}.filters select{width:auto}
.result{background:var(--bg2);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:0 8px 8px 0;padding:14px 16px;margin:12px 0}
.rtitle{font-weight:700;color:var(--fg)}
.src{color:var(--accent2);font-size:0.82rem;margin-top:2px}
.src a{color:#a78bfa;text-decoration:none}.src a:hover{text-decoration:underline}
.score{color:var(--green);font-weight:700;font-size:0.82rem;margin-top:2px}
.snip{color:var(--fg2);font-size:0.85rem;line-height:1.6;margin-top:8px}
mark{background:rgba(168,85,247,0.22);color:var(--fg);padding:0 2px;border-radius:3px}
.copy{margin-left:8px;background:none;border:1px solid var(--border);color:var(--fg3);border-radius:6px;font-size:0.72rem;padding:2px 8px;cursor:pointer;transition:all .12s}
.copy:hover{color:var(--accent);border-color:var(--accent)}
.answer{background:var(--bg2);border:1px solid var(--border);border-left:3px solid var(--green);border-radius:0 8px 8px 0;padding:18px;margin:16px 0;line-height:1.7}
.muted{color:var(--fg2);font-size:0.85rem}
.faint{color:var(--fg3);font-size:0.8rem}
.big-q{color:var(--fg);font-size:1.05rem;font-weight:600;margin:6px 0 0}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
.stat{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px;text-align:center}
.stat-num{font-size:1.4rem;font-weight:700;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.stat-label{font-size:0.7rem;color:var(--fg3);text-transform:uppercase;letter-spacing:.5px;margin-top:4px}
.recent{list-style:none;padding:0;margin:0}
.recent li{padding:7px 0;border-bottom:1px solid var(--border);font-size:0.85rem;color:var(--fg2)}
.recent li:last-child{border-bottom:none}
.file{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:12px;font-family:'JetBrains Mono','Fira Code',ui-monospace,monospace;font-size:0.8rem;line-height:1.7;overflow-x:auto}
.ln{white-space:pre;border-left:3px solid transparent;padding:0 8px}
.no{color:var(--fg3);display:inline-block;min-width:3em;text-align:right;margin-right:14px;user-select:none}
.hl{background:rgba(168,85,247,0.12);border-left-color:var(--accent)}
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--card);border:1px solid var(--accent);color:var(--fg);padding:10px 20px;border-radius:8px;font-size:0.85rem;opacity:0;pointer-events:none;transition:all .25s;z-index:1000}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
footer{border-top:1px solid var(--border);margin-top:30px;padding:20px;text-align:center;color:var(--fg3);font-size:0.75rem}
@media(max-width:680px){
.hamburger{display:block}
.nav-links{display:none;position:absolute;top:56px;left:0;right:0;background:rgba(7,7,12,0.98);border-bottom:1px solid var(--border);flex-direction:column;padding:12px 20px;gap:4px}
.nav-links.open{display:flex}
.nav-links a{padding:10px 12px}
}
</style></head>
<body>
<div id=pbar></div>
<div id=toast></div>
<nav><div class=nav-inner>
<a class=logo href='/'>docs-pipe</a>
<button id=hamburger class=hamburger aria-label=Menu>&#9776;</button>
<div id=navlinks class=nav-links>
<a href='/'" ++ (nav_cls active "home") ++ ">Home</a>
<a href='/search'" ++ (nav_cls active "search") ++ ">Search</a>
<a href='/ask'" ++ (nav_cls active "ask") ++ ">Ask</a>
<a href='/stats'" ++ (nav_cls active "stats") ++ ">Stats</a>
<a href='/reindex'" ++ (nav_cls active "reindex") ++ ">Reindex</a>
</div>
</div></nav>
<header><h1>" ++ subtitle ++ "</h1><p>" ++ title ++ "</p></header>
<div class=container>"

fn page_bottom _
    "<footer>docs-pipe dashboard · pipe-web + docs-pipe + sqlite + DeepSeek</footer>
<script>
(function(){
var $=function(s){return document.querySelector(s)};
window.__bar=function(on){var b=$('#pbar');if(b){b.classList.toggle('on',!!on)}};
window.__toast=function(msg){var t=$('#toast');if(!t){return}t.textContent=msg;t.classList.add('show');setTimeout(function(){t.classList.remove('show')},2200)};
var hb=$('#hamburger');var nl=$('#navlinks');
if(hb&&nl){hb.addEventListener('click',function(){nl.classList.toggle('open')})}
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&nl){nl.classList.remove('open')}});
document.addEventListener('keydown',function(e){if(e.key==='/'&&document.activeElement&&document.activeElement.tagName!=='INPUT'&&document.activeElement.tagName!=='TEXTAREA'){var s=$('#live-input')||$('input[name=q]');if(s){e.preventDefault();s.focus()}}});
document.addEventListener('click',function(e){var b=e.target.closest('[data-copy]');if(b){var t=b.getAttribute('data-copy');if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(function(){window.__toast('Copied: '+t)})}else{window.__toast('Copy failed')}}});
window.__esc=function(s){if(s==null){return ''}return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')};
window.__highlight=function(text,terms){if(!terms||!terms.length){return text}var low=text.toLowerCase();var out='';var pos=0;while(pos<text.length){var best=-1;var blen=0;for(var i=0;i<terms.length;i++){var t=terms[i].toLowerCase();var idx=low.indexOf(t,pos);if(idx>=0&&(best<0||idx<best)){best=idx;blen=t.length}}if(best<0){out+=text.slice(pos);break}out+=text.slice(pos,best)+'<mark>'+text.slice(best,best+blen)+'</mark>';pos=best+blen}return out};
window.__renderResult=function(r,terms){var title=window.__esc(r.heading);if(!title){title=window.__esc((r.path||'').split('/').pop())}var src=window.__esc(r.path)+':'+r.line_start;var href='/doc?path='+encodeURIComponent(r.path)+'&line='+r.line_start+'#L'+r.line_start;var snip=window.__esc(r.text);if(snip.length>220){snip=snip.slice(0,220)+'...'}snip=window.__highlight(snip,terms);return '<div class=result><div class=rtitle>'+title+'</div><div class=src><a href='+href+'>'+src+'</a><button class=copy data-copy='+src+'>copy</button></div><div class=score>score '+r.score+'</div><div class=snip>'+snip+'</div></div>'};
var li=$('#live-input');var lr=$('#live-results');var lm=$('#live-meta');
if(li&&lr){var timer=null;li.addEventListener('input',function(){var q=li.value.trim();if(timer){clearTimeout(timer)}if(!q){lr.innerHTML='';lm.textContent='';return}timer=setTimeout(function(){var t0=Date.now();window.__bar(true);fetch('/api/search?q='+encodeURIComponent(q)).then(function(resp){return resp.json()}).then(function(d){var ms=Date.now()-t0;var rs=(d.results)||[];var terms=q.toLowerCase().split(/[^a-z0-9äöüß_]+/).filter(function(w){return w.length>2});if(!rs.length){lr.innerHTML='<p class=muted>No matches.</p>';lm.textContent='';return}var html='';for(var i=0;i<rs.length;i++){html+=window.__renderResult(rs[i],terms)}lr.innerHTML=html;lm.textContent=rs.length+' results · '+ms+' ms · <a href=/search?q='+encodeURIComponent(q)+'>filters</a>'}).catch(function(){lr.innerHTML='<p class=muted>Search failed.</p>';lm.textContent=''}).then(function(){window.__bar(false)})},250)})}
})();
</script>
</div>
</body></html>"

fn index_status idx
    doc_index_status idx

fn render_result r terms
    title: esc_html (get r "heading")
    if title == ""
        title: esc_html (path_base (get r "path"))
    rawsrc: (get r "path") ++ ":" ++ (to_str (get r "line_start"))
    src: esc_html rawsrc
    href: "/doc?path=" ++ (url_encode (get r "path")) ++ "&line=" ++ (to_str (get r "line_start")) ++ "#L" ++ (to_str (get r "line_start"))
    snip: esc_html (get r "text")
    if (len snip) > 220
        snip: (substring snip 0 220) ++ "..."
    snip: mark_terms snip terms
    out: "<div class=result>"
    out: out ++ "<div class=rtitle>" ++ title ++ "</div>"
    out: out ++ "<div class=src><a href='" ++ href ++ "'>" ++ src ++ "</a><button class=copy data-copy='" ++ src ++ "'>copy</button></div>"
    out: out ++ "<div class=score>score " ++ (to_str (get r "score")) ++ "</div>"
    out: out ++ "<div class=snip>" ++ snip ++ "</div>"
    out: out ++ "</div>"
    out

fn stat_tile label value
    "<div class=stat><div class=stat-num>" ++ (to_str value) ++ "</div><div class=stat-label>" ++ label ++ "</div></div>"

--- === Pages === ---

fn landing_page req
    idx: get __state "idx"
    s: index_status idx
    recent: get __state "recent"
    out: page_top ("indexed " ++ (get __state "dir")) "docs-pipe" "home"
    out: out ++ "<div class=card><h2>Search</h2>"
    out: out ++ "<input type=text id=live-input placeholder='Search the docs — just start typing (hint: press / )'>"
    out: out ++ "<p class=muted id=live-meta></p><div id=live-results></div></div>"
    out: out ++ "<div class=card><h2>Ask the docs</h2>"
    out: out ++ "<form action=/ask method=get onsubmit='__bar(true)'><input type=text name=q placeholder='Ask a question — the answer cites its sources...'><button class=btn type=submit>Ask AI</button></form></div>"
    out: out ++ "<div class=card><h2>Overview</h2><div class=stats-grid>"
    out: out ++ (stat_tile "Files" (get s "files"))
    out: out ++ (stat_tile "Chunks" (get s "chunks"))
    out: out ++ (stat_tile "Language" (get s "lang"))
    out: out ++ (stat_tile "Vector dim" (get idx "vec_dim"))
    out: out ++ "</div></div>"
    if (len recent) > 0
        out: out ++ "<div class=card><h2>Recent queries</h2><ul class=recent>"
        i: (len recent) - 1
        while i >= 0
            out: out ++ "<li>" ++ (esc_html (at recent i)) ++ "</li>"
            i: i - 1
        out: out ++ "</ul></div>"
    out: out ++ (page_bottom 0)
    html 200 out

fn search_page req
    query: get req "query"
    q: get query "q"
    if q == nil
        q: ""
    idx: get __state "idx"
    k: get query "k"
    if k == nil
        k: 8
    else
        k: to_num k
        if k < 1
            k: 8
    file_filter: get query "file"
    if file_filter == nil
        file_filter: ""
    lang_filter: get query "lang"
    if lang_filter == nil || lang_filter == ""
        lang_filter: "all"
    out: page_top ("indexed " ++ (get __state "dir")) "Search" "search"
    if q == ""
        out: out ++ "<div class=card><h2>Search</h2>"
        out: out ++ "<form action=/search method=get onsubmit='__bar(true)'><input type=text name=q placeholder='Search by meaning + keywords...'><button class=btn type=submit>Search</button></form></div>"
        out: out ++ (page_bottom 0)
        html 200 out
    else
        log_query q
        t0: (time_ms)
        try
            all: doc_search idx q 40
            t1: (time_ms)
            terms: tokenize_terms q
            filtered: []
            i: 0
            while i < (len all)
                r: at all i
                ok: true
                if file_filter != "" && (not (contains (get r "path") file_filter))
                    ok: false
                if ok && lang_filter != "all" && (lang_of (get r "path")) != lang_filter
                    ok: false
                if ok
                    push filtered r
                i: i + 1
            total: len filtered
            results: []
            j: 0
            while j < k && j < (len filtered)
                push results (at filtered j)
                j: j + 1
            out: out ++ "<p class=big-q>Search: " ++ (esc_html q) ++ "</p>"
            out: out ++ "<form action=/search method=get class=filters onsubmit='__bar(true)'>"
            out: out ++ "<input type=hidden name=q value='" ++ (esc_html q) ++ "'>"
            out: out ++ "<input type=text name=file placeholder='filter by file...' value='" ++ (esc_html file_filter) ++ "'>"
            out: out ++ "<select name=lang><option value=all>all languages</option>"
            out: out ++ "<option value=en" ++ (lang_selected lang_filter "en") ++ ">english</option>"
            out: out ++ "<option value=de" ++ (lang_selected lang_filter "de") ++ ">deutsch</option></select>"
            out: out ++ "<button class='btn second' type=submit>Filter</button></form>"
            out: out ++ "<p class=muted>" ++ (to_str total) ++ " matches · " ++ (to_str (t1 - t0)) ++ " ms</p>"
            if (len results) == 0
                out: out ++ "<p class=muted>No matches.</p>"
            else
                i: 0
                while i < (len results)
                    out: out ++ (render_result (at results i) terms)
                    i: i + 1
            out: out ++ (page_bottom 0)
            html 200 out
        catch e
            html 500 (page_top "search failed" "Error" "home" ++ "<p class=muted>" ++ (esc_html e) ++ "</p>" ++ (page_bottom 0))

fn ask_page req
    query: get req "query"
    q: get query "q"
    if q == nil
        q: ""
    idx: get __state "idx"
    out: page_top ("indexed " ++ (get __state "dir")) "Ask" "ask"
    if q == ""
        out: out ++ "<div class=card><h2>Ask the docs</h2>"
        out: out ++ "<form action=/ask method=get onsubmit='__bar(true)'><input type=text name=q placeholder='Ask a question — the answer cites its sources...'><button class=btn type=submit>Ask AI</button></form></div>"
        out: out ++ (page_bottom 0)
        html 200 out
    else
        log_query q
        try
            res: doc_ask idx q 4
            out: out ++ "<p class=big-q>Question: " ++ (esc_html q) ++ "</p>"
            out: out ++ "<div class=answer>" ++ (nl2br (esc_html (get res "answer"))) ++ "</div>"
            srcs: get res "sources"
            if (len srcs) > 0
                terms: tokenize_terms q
                out: out ++ "<div class=card><h2>Sources</h2>"
                i: 0
                while i < (len srcs)
                    out: out ++ (render_result (at srcs i) terms)
                    i: i + 1
                out: out ++ "</div>"
            out: out ++ (page_bottom 0)
            html 200 out
        catch e
            html 500 (page_top "ask failed" "Error" "home" ++ "<p class=muted>" ++ (esc_html e) ++ "</p>" ++ (page_bottom 0))

fn stats_page req
    idx: get __state "idx"
    s: index_status idx
    cost: ai_cost
    recent: get __state "recent"
    out: page_top ("indexed " ++ (get __state "dir")) "Stats" "stats"
    out: out ++ "<div class=stats-grid>"
    out: out ++ (stat_tile "Files" (get s "files"))
    out: out ++ (stat_tile "Chunks" (get s "chunks"))
    out: out ++ (stat_tile "Language" (get s "lang"))
    out: out ++ (stat_tile "Vector dim" (get idx "vec_dim"))
    out: out ++ (stat_tile "AI calls" (get cost "calls"))
    out: out ++ (stat_tile "AI cost $" (get cost "cost_usd"))
    out: out ++ "</div>"
    out: out ++ "<div class=card><h2>Recent queries</h2>"
    if (len recent) == 0
        out: out ++ "<p class=muted>No queries yet.</p>"
    else
        out: out ++ "<ul class=recent>"
        i: (len recent) - 1
        while i >= 0
            out: out ++ "<li>" ++ (esc_html (at recent i)) ++ "</li>"
            i: i - 1
        out: out ++ "</ul>"
    out: out ++ "</div>"
    out: out ++ (page_bottom 0)
    html 200 out

fn reindex_page req
    idx: get __state "idx"
    try
        doc_reindex idx
        print "reindexed"
    catch e
        print ("reindex error: " ++ e)
    redirect 302 "/"

--- === Source viewer === ---

fn render_file_lines lines target
    out: ""
    i: 0
    while i < (len lines)
        lineno: i + 1
        cls: "ln"
        if lineno == target
            cls: "ln hl"
        out: out ++ "<div id='L" ++ (to_str lineno) ++ "' class='" ++ cls ++ "'><span class=no>" ++ (to_str lineno) ++ "</span>" ++ (esc_html (at lines i)) ++ "</div>"
        i: i + 1
    out

fn doc_page req
    query: get req "query"
    p: get query "path"
    ln: get query "line"
    if p == nil || p == ""
        return (json 404 {error: "missing path"})
    if contains p ".."
        return (json 404 {error: "invalid path"})
    if (path_ext p) != ".md"
        return (json 404 {error: "not a markdown file"})
    if !(file_exists p)
        return (json 404 {error: "file not found"})
    try
        target: 0
        if ln != nil && ln != ""
            target: to_num ln
        lines: read_lines p
        out: page_top (esc_html p) "Source" "home"
        out: out ++ "<p class=muted><a href='/'>← back</a></p>"
        out: out ++ "<div class=file>"
        out: out ++ (render_file_lines lines target)
        out: out ++ "</div>"
        out: out ++ (page_bottom 0)
        html 200 out
    catch e
        json 500 {error: e}

--- === JSON API === ---

fn health req
    idx: get __state "idx"
    s: index_status idx
    ok {status: "ok", dir: (get __state "dir"), files: (get s "files"), chunks: (get s "chunks"), lang: (get s "lang")}

fn api_search req
    query: get req "query"
    q: get query "q"
    idx: get __state "idx"
    if q == nil || q == ""
        ok {query: q, results: []}
    else
        try
            ok {query: q, results: (doc_search idx q 8)}
        catch e
            json 500 {error: e}

fn api_ask req
    query: get req "query"
    q: get query "q"
    idx: get __state "idx"
    if q == nil || q == ""
        ok {question: q, answer: "", sources: []}
    else
        log_query q
        try
            res: doc_ask idx q 4
            ok {question: q, answer: (get res "answer"), sources: (get res "sources")}
        catch e
            json 500 {error: e}

fn api_recent req
    ok {recent: (get __state "recent")}

fn notfound req
    json 404 {error: "Not Found", path: (get req "path")}

--- === MCP tools === ---

fn mcp_search query
    idx: get __state "idx"
    if query == nil || query == ""
        return []
    results: doc_search idx query 5
    out: []
    i: 0
    while i < (len results)
        r: at results i
        item: {}
        set item "path" (get r "path")
        set item "heading" (get r "heading")
        set item "line" (get r "line_start")
        set item "score" (get r "score")
        snippet: get r "text"
        if (len snippet) > 300
            snippet: (substring snippet 0 300) ++ "..."
        set item "snippet" snippet
        push out item
        i: i + 1
    out

fn mcp_ask question
    idx: get __state "idx"
    if question == nil || question == ""
        return {answer: "", sources: []}
    doc_ask idx question 4

fn mcp_read path
    if path == nil || path == ""
        return "missing path"
    if contains path ".."
        return "invalid path"
    if !(file_exists path)
        return "file not found: " ++ path
    read_file path

--- === Start === ---

mode: env "PIPE_MODE"

init 0

if mode == "mcp"
    ai_tool "search_docs" "Semantic + keyword search across the Pipe documentation. Returns the top matches with path, heading, line number and a snippet." {query: "Search query"} mcp_search
    ai_tool "ask_docs" "Answer a question using the Pipe documentation as context, returning the answer and the cited source chunks." {question: "Question about Pipe"} mcp_ask
    ai_tool "read_doc" "Read a documentation file by its relative path (e.g. docs/en/25-mcp.md)." {path: "Documentation file path"} mcp_read
    mcp_server "Pipe Docs" "1.0.0"
    mcp_serve_stdio
else
    api: app "docs-pipe-dashboard"
    route_get api "/"          landing_page
    route_get api "/search"    search_page
    route_get api "/ask"       ask_page
    route_get api "/stats"     stats_page
    route_get api "/reindex"   reindex_page
    route_get api "/doc"       doc_page
    route_get api "/health"    health
    route_get api "/api/search" api_search
    route_get api "/api/ask"   api_ask
    route_get api "/api/recent" api_recent
    route_get api "/*"        notfound
    print ("docs-pipe dashboard -- indexed " ++ (get __state "dir"))
    serve api "0.0.0.0:8090" 3600000
