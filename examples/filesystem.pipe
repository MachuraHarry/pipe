--! Filesystem demo: create, read, append, and inspect files.

--! Checks whether a filename contains "pipe_".
fn has_pipe f
    contains f "pipe_"

print "=== Datei erstellen und schreiben ==="
write_file "/tmp/pipe_demo.txt" "Hallo Welt\nDies ist Zeile 2"
print (read_file "/tmp/pipe_demo.txt")

print ""
print "=== Datei-Info ==="
print "Existiert:  "
print (file_exists "/tmp/pipe_demo.txt")
print "Typ:        "
print (file_type "/tmp/pipe_demo.txt")
print "Size:       "
print (file_size "/tmp/pipe_demo.txt")

print ""
print "=== Zeilenweise ==="
lines: read_lines "/tmp/pipe_demo.txt"
print "Zeilen: "
print (len lines)

print ""
print "=== Append ==="
append_file "/tmp/pipe_demo.txt" "\nAppended line"
print (read_file "/tmp/pipe_demo.txt")

print ""
print "=== Kopieren + Umbenennen ==="
file_copy "/tmp/pipe_demo.txt" "/tmp/pipe_copy.txt"
file_move "/tmp/pipe_copy.txt" "/tmp/pipe_final.txt"

print ""
print "=== Verzeichnisliste ==="
files: list_dir "/tmp"
matching: filter files has_pipe
print "Pipe-Dateien in /tmp:"
print matching

print ""
print "=== Pfad-Operationen ==="
p: "/home/user/docs/report.txt"
print "Pfad:       "
print p
print "Dateiname:  "
print (path_base p)
print "Verzeichnis:"
print (path_dir p)
print "Endung:     "
print (path_ext p)
print "Join:       "
print (path_join "/tmp" "sub" "file.txt")

print ""
print "=== Verzeichnis anlegen ==="
make_dir "/tmp/pipe_testdir"
print "Existiert:  "
print (file_exists "/tmp/pipe_testdir")
print "Typ:        "
print (file_type "/tmp/pipe_testdir")

print ""
print "=== Cleanup ==="
file_delete "/tmp/pipe_demo.txt"
file_delete "/tmp/pipe_final.txt"
remove_dir "/tmp/pipe_testdir"
print "Fertig."
