--! FizzBuzz: replaces multiples of 3, 5, and 15 with Fizz, Buzz, and FizzBuzz.

--! Applies the FizzBuzz rules to n.
fn fizzbuzz n
    if n % 15 == 0
        "FizzBuzz"
    else if n % 3 == 0
        "Fizz"
    else if n % 5 == 0
        "Buzz"
    else
        n

print (fizzbuzz 1)
print (fizzbuzz 3)
print (fizzbuzz 5)
print (fizzbuzz 15)
