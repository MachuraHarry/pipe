-- for-in Demo: All new Phase-1 Features

print "===== FOR-IN LOOP ====="
-- Calculate sum
sum: 0
for n in (range 1 6)
    sum: sum + n
print "Sum 1..5 = "
print sum

-- Iterate list
print "Colors:"
for color in ["red", "green", "blue"]
    print color

-- for-in mit break
print "countdown:"
for i in [5, 4, 3, 2, 1, 0]
    print i
    if i <= 2
        break

print ""
print "===== REGEX ====="
print "Numbers in text?"
print (regex_match "[0-9]+" "abc123")
print "Email?"
print (regex_match "^\\S+@\\S+$" "test@example.com")
print "Mask numbers:"
print (regex_replace "[0-9]" "#" "Tel: 0123-45678")

print ""
print "===== DATE/TIME ====="
ts: now
print "Unix:   "
print ts
print "Date:  "
print (format_time ts "2006-01-02")
print "Time:   "
print (format_time ts "15:04:05")

print ""
print "===== RANDOM ====="
print "Dice (1-6):"
for i in (range 1 4)
    print (random_range 1 7)

print ""
print "===== ALL PHASE-1 FEATURES OK! ====="
