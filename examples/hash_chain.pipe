--! Hash chain and proof-of-work: links chained through sha256, PoW mines a prefix.

--! Builds a chain of length hashes starting from seed.
fn build_chain seed length
    chain: [seed]
    i: 0
    while i < length
        prev: at chain i
        chain: push chain (sha256 (prev ++ (to_str i)))
        i: i + 1
    chain

--! Verifies that every chain link matches its predecessor's hash.
fn verify_chain chain
    i: 0
    while i < ((len chain) - 1)
        prev: at chain i
        expected: sha256 (prev ++ (to_str i))
        actual: at chain (i + 1)
        if expected != actual
            return false
        i: i + 1
    true

--! Mines a nonce so the hash starts with the target prefix.
fn mine_pow data target
    nonce: 0
    found: false
    while !found
        candidate: sha256 (data ++ (to_str nonce))
        if contains candidate target
            nonce: nonce + 1
        else
            found: true
    nonce

--- === Demo ===

print "--- Hash Chain ---"

chain: build_chain "genesis" 4

--- Verify chain through pipeline → if
verify_chain chain
    > print

--- Tamper detection
print ""
print "--- Tamper: Insert fake hash ---"
chain: set chain 2 "hacked"

verified: verify_chain chain
if verified
    print "VALID (bad)"
else
    print "INVALID (expected)"

--- Proof of Work
print ""
print "--- Proof of Work ---"
t1: now
nonce: mine_pow "pipe-pow" "00"
t2: now
print ("Time:  " ++ (to_str (t2 - t1)) ++ " sec")
print ("Tries: " ++ (to_str nonce))

"pipe-pow" ++ (to_str nonce)
    > sha256
    > print
