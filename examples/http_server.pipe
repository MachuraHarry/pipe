--! HTTP server demo: routes /, /api/time, and 404 fallback.

--! Serves the landing page.
fn handle_root _
    html: "<!DOCTYPE html><html><head><title>Pipe Server</title><meta charset=utf-8><style>"
    html: html ++ "body{font-family:sans-serif;max-width:600px;margin:60px auto;background:#0a0a0f;color:#e0e0e8}"
    html: html ++ "h1{color:#7c5cfc}code{background:#1a1a24;padding:2px 6px}</style></head><body>"
    html: html ++ "<h1>Pipe HTTP Server</h1>"
    html: html ++ "<p>Your Pipe server is running!</p>"
    html: html ++ "<p>Try: <code>/hello</code> or <code>/api/time</code></p>"
    html: html ++ "</body></html>"
    {status: 200, headers: {ContentType: "text/html; charset=utf-8"}, body: html}

--! Serves the current Unix timestamp.
fn handle_time _ 
    t: now
    {status: 200, headers: {ContentType: "text/plain"}, body: "Time: " ++ (to_str t)}

--! Returns a 404 response for unknown paths.
fn handle_notfound path
    {status: 404, headers: {ContentType: "text/plain"}, body: "404: " ++ path}

--! Routes a request to the matching handler.
fn handle_request req
    path: get req "path"
    if path == "/"
        handle_root 0
    else
        if path == "/api/time"
            handle_time 0
        else
            handle_notfound path

print "Pipe HTTP Server — http://localhost:8080"
print ""

server: http_server "0.0.0.0:8080" handle_request
print "Server running... (auto-close in 300s)"
sleep 300000
http_close server
print "Server stopped."
