--! A minimal tokenizer module used as a test fixture.

--! Builds a token map with a type and text.
fn make_token typ text
  t: {}
  set t "type" typ
  set t "text" text
  t

--! Tokenizes a string into a fixed list of tokens.
fn tokenize s
  st: {}
  set st "src" s
  set st "pos" 0
  set st "tokens" ([])
  push (get st "tokens") (make_token "kw" "CREATE")
  push (get st "tokens") (make_token "id" "tasks")
  get st "tokens"

--! Runs the tokenizer and prints the result.
export fn runtest
  tokens: tokenize "CREATE tasks"
  print ("len=" ++ to_str(len tokens))
  t0: at tokens 0
  t1: at tokens 1
  print ("tok0 type=" ++ (get t0 "type") ++ " text=" ++ (get t0 "text"))
  print ("tok1 type=" ++ (get t1 "type") ++ " text=" ++ (get t1 "text"))
