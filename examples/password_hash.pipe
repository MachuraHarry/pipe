--- Password Hashing — Iterated SHA-256 with Salt
--- Hash result chains through > print at the end.

fn hash_password password salt
    iterations: 10000
    result: sha256 (password ++ salt)
    i: 0
    while i < (iterations - 1)
        result: sha256 (result ++ salt)
        i: i + 1
    result

--- === Demo ===

print "--- Password Hashing ---"

password: "mySecret123"
salt: "NaCl-random-salt"

--- The hash flows through a pipeline to print
hash_password password salt
    > print

--- Verify
print ""
print "--- Verification ---"

fn check pw
    if (hash_password pw salt) == (hash_password password salt)
        print ("CORRECT: " ++ pw)
    else
        print ("WRONG:   " ++ pw)

check "mySecret123"
check "wrongPassword"
