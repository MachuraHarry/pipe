--- Password Hashing
--- Iterated SHA-256 with salt.
--- Not as strong as bcrypt/PBKDF2, but demonstrates
--- how to build key derivation with available primitives.

--- === Hash a password with salt ===

fn hash_password password salt
    iterations: 10000
    combined: password ++ salt
    result: sha256 combined
    i: 0
    while i < (iterations - 1)
        result: sha256 (result ++ salt)
        i: i + 1
    result

--- === Verify a password ===

fn verify_password password salt expected_hash
    (hash_password password salt) == expected_hash

--- === Demo ===

print "--- Password Hashing ---"

password: "mySecret123"
salt: "NaCl-random-salt"

--- Generate a hash
hashed: hash_password password salt
print ("Password: " ++ password)
print ("Salt:     " ++ salt)
print ("Hash:     " ++ hashed)

--- Verify correct password
print ""
print "--- Verification ---"
if verify_password password salt hashed
    print "CORRECT password"
else
    print "WRONG password"

if verify_password "wrongPassword" salt hashed
    print "CORRECT password (unexpected)"
else
    print "WRONG password (expected)"

--- === Timing information ===

print ""
print "--- Timing ---"
tdiff: 0
t1: now
hash_password password salt
t2: now
tdiff: t2 - t1
print ("Hash time: " ++ (to_str tdiff) ++ " seconds (10000 iterations)")
