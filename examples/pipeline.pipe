--! Vertical pipeline demonstration: values flow through function stages with >.

--! Adds two numbers.
fn add a b
    a + b

--! Doubles a number.
fn double x
    x * 2

--! Checks whether a number is greater than zero.
fn is_positive x
    x > 0

42
    > double    -- vertikale Pipeline: double(42)
    > add 10    -- add(double(42), 10)
    > print     -- print(94)

100
    > is_positive
    > print     -- print(true)
