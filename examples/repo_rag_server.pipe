--! repo-rag — a generic MCP server exposing RAG over ANY Git repository.
--! Sibling of pipe_docs_server.pipe: instead of hardcoding the Pipe repo it
--! takes a repository URL, clones it shallow, prunes junk directories and
--! builds THREE persistent SQLite indexes in the cache dir:
--!   code.db     — source declarations (Go, Pipe, Python, JS/TS, Rust +
--!                 generic fallback), synced incrementally per-file by
--!                 SHA-256 (repo_rag_lib)
--!   docs-kw.db  — heading-aware Markdown chunks for keyword-only search,
--!                 works WITHOUT any API key (repo_rag_lib)
--!   docs.db     — docs-pipe semantic index with embeddings; only built
--!                 when an AI key is configured, auto-reindexed when the
--!                 checkout HEAD changes
--! AI agents can then search_docs / ask_docs / search_code / read_source and
--! friends without digging through the repository themselves.
--!
--! Config (env):
--!   REPO_RAG_URL                        — required, e.g. https://github.com/user/repo
--!   REPO_RAG_REF                        — optional branch/tag (default branch otherwise)
--!   REPO_RAG_CACHE                      — cache dir (default ~/.pipe/cache/repo-rag/<owner>__<repo>)
--!   DEEPSEEK_API_KEY | OPENAI_API_KEY   — enables semantic search + ask_docs;
--!                                         without a key search_docs falls
--!                                         back to keyword-only mode
--!
--! Run: REPO_RAG_URL=... pipe examples/repo_rag_server.pipe
--! The first run clones the repo and builds all indexes (a few minutes for
--! large repositories); subsequent runs reuse the SQLite databases and only
--! hash-check files incrementally. A ref change triggers a fresh clone and
--! index wipe automatically; other repository updates require deleting the
--! cache dir or restarting.

import "docs-pipe"
import "lib/pipe_docs_lib.pipe"
import "lib/repo_rag_lib.pipe"

--- === Sandbox profiles === ---
-- Two profiles: rag-build (clone/prune/index phase) and rag-serve (serve
-- phase). After init completes we switch to rag-serve and lock it so the MCP
-- server runs least-privilege: read-only FS, no exec, AI + network for
-- provider calls only.
-- NOTE: env vars must be captured BEFORE set_sandbox — under an active
-- profile the env builtin only reads from the profile's Env allowlist, and
-- API keys containing KEY/SECRET/TOKEN are additionally blocked by
-- secretEnvMarkers.

sandbox_profile "rag-build" {fs: "full", exec: true, exec_whitelist: ["git", "rm"], network: true, network_whitelist: ["github.com", "gitlab.com", "bitbucket.org", "raw.githubusercontent.com", "api.deepseek.com", "api.openai.com", "api.anthropic.com"], ai: true}
sandbox_profile "rag-serve" {fs: "read-only", exec: false, network: true, network_whitelist: ["api.deepseek.com", "api.openai.com", "api.anthropic.com"], ai: true}

--- === Global state === ---

ST: {url: "", ref: "", owner: "", name: "", slug: "", src: "", home: "", cache: "", deepseek_key: "", openai_key: "", idx_docs: nil, idx_code: nil, idx_kw: nil, all_files: [], md_files: [], code_symbols: [], code_files: [], languages: {}, sync_code: nil, sync_kw: nil, has_ai: false, ready: false, ai_ready: false, err: ""}

-- Capture env vars before sandbox activation
_env_url: env "REPO_RAG_URL"
if _env_url != nil && _env_url != ""
    set ST "url" _env_url
_env_ref: env "REPO_RAG_REF"
if _env_ref != nil && _env_ref != ""
    set ST "ref" _env_ref
_env_home: env "HOME"
if _env_home != nil
    set ST "home" _env_home
_ds_key: env "DEEPSEEK_API_KEY"
if _ds_key != nil && _ds_key != ""
    set ST "deepseek_key" _ds_key
_oai_key: env "OPENAI_API_KEY"
if _oai_key != nil && _oai_key != ""
    set ST "openai_key" _oai_key
_env_cache: env "REPO_RAG_CACHE"
if _env_cache != nil && _env_cache != ""
    set ST "cache" _env_cache

set_sandbox "rag-build"

--- === Input validation ===
-- The URL ends up inside double-quoted shell commands (git clone, rm -rf),
-- so only a fixed safe charset may pass: no quotes, dollar, backtick,
-- whitespace or shell metacharacters. Also rejects option-style leading
-- dashes so the value can never be parsed as a git flag.

fn valid_repo_url url
    if url == nil || url == ""
        return false
    n: len url
    if n < 4 || n > 300
        return false
    if (substring url 0 1) == "-"
        return false
    allowed: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-/:@~+"
    i: 0
    while i < n
        if not (contains allowed (substring url i (i + 1)))
            return false
        i: i + 1
    true

--- === Cache & fetch ===

fn cache_dir
    d: get ST "cache"
    if d == nil || d == ""
        home: get ST "home"
        if home != nil && home != ""
            d: home ++ "/.pipe/cache/repo-rag"
        else
            d: "/tmp/repo-rag-cache"
    make_dir d
    d

-- Current HEAD commit of the checkout ("" when unavailable). Used to detect
-- upstream updates of the same ref so the semantic docs index can reindex.
fn git_head src
    r: exec ("git -C \"" ++ src ++ "\" rev-parse HEAD")
    if (get r "status") != 0
        return ""
    trim (get r "output")

-- Returns {ok: true, src: <path>} on success or {ok: false, err: <reason>}.
fn ensure_src
    cfg: slug_parts (get ST "url")
    if (get cfg "ok") == false
        return {ok: false, err: "REPO_RAG_URL is missing or not a valid Git repository URL"}
    set ST "owner" (get cfg "owner")
    set ST "name" (get cfg "repo")
    set ST "slug" (get cfg "slug")
    cd: cache_dir 0
    root: path_join cd (get cfg "slug")
    make_dir root
    src: path_join root "src"
    want_ref: get ST "ref"
    if want_ref == nil
        want_ref: ""
    marker_path: path_join src ".repo-rag-ref"
    if file_exists (path_join src ".git")
        marker: ""
        if file_exists marker_path
            marker: trim (read_file marker_path)
        if marker == want_ref
            return {ok: true, src: src}
        -- A different ref is requested: wipe the stale checkout.
        exec ("rm -rf \"" ++ src ++ "\"")
    cmd: "git clone --depth 1 "
    if want_ref != ""
        cmd: cmd ++ "--branch \"" ++ want_ref ++ "\" "
    cmd: cmd ++ "\"" ++ (get ST "url") ++ "\" \"" ++ src ++ "\""
    r: exec cmd
    if (get r "status") != 0
        return {ok: false, err: ("git clone failed: " ++ (get r "error"))}
    if not (file_exists src)
        return {ok: false, err: "git clone produced no repository"}
    write_file marker_path want_ref
    {ok: true, src: src}

--- === Junk pruning === ---
-- The docs-pipe indexer walks without exclusions, so build/vendor noise is
-- removed physically right after clone. Deep junk dirs (nested node_modules
-- etc.) are collected recursively; dotted directories are never entered.

fn collect_junk_dirs path acc
    entries: list_dir path
    i: 0
    n: len entries
    while i < n
        e: at entries i
        el: len e
        if (substring e (el - 1) el) == "/"
            name: substring e 0 (el - 1)
            p: path_join path name
            if is_junk_dir name
                push acc p
            else if (substring name 0 1) != "."
                collect_junk_dirs p acc
        i: i + 1
    acc

fn prune_junk src
    junk: []
    collect_junk_dirs src junk
    i: 0
    n: len junk
    while i < n
        exec ("rm -rf \"" ++ (at junk i) ++ "\"")
        i: i + 1
    n

--- === Provider === ---

fn configure_provider
    key: get ST "deepseek_key"
    if key != nil && key != ""
        ai_provider "deepseek"
        ai_set_key "deepseek" key
        ai_model "deepseek-v4-flash"
        set ST "has_ai" true
        return nil
    okey: get ST "openai_key"
    if okey != nil && okey != ""
        ai_provider "openai"
        ai_set_key "openai" okey
        set ST "has_ai" true
        return nil
    set ST "has_ai" false
    nil

--- === Docs index (semantic, docs-pipe; requires AI) === ---

fn build_docs
    src: get ST "src"
    cd: cache_dir 0
    db: path_join cd "docs.db"
    head_path: path_join cd "docs.head"
    head_now: git_head src
    stored_head: ""
    if file_exists head_path
        stored_head: trim (read_file head_path)
    if not (file_exists db)
        tmp: doc_index src {db: db}
        doc_close tmp
    set ST "idx_docs" (doc_index src {db: db})
    -- Same ref but newer commits upstream: incrementally re-embed only the
    -- changed Markdown files instead of leaving a stale index behind.
    if stored_head != "" && head_now != "" && stored_head != head_now
        doc_reindex (get ST "idx_docs")
    if head_now != ""
        write_file head_path head_now
    nil

--- === Persistent indexes (code.db + docs-kw.db; work without AI) === ---

fn build_all_files
    set ST "all_files" (walk_tree (get ST "src"))
    nil

fn build_md_list
    src: get ST "src"
    files: get ST "all_files"
    md: []
    i: 0
    while i < (len files)
        f: at files i
        e: path_ext f
        if e == ".md" || e == ".mdx"
            push md (rel_path src f)
        i: i + 1
    set ST "md_files" md
    nil

fn load_code_state ch
    loaded: code_load ch
    set ST "code_symbols" (get loaded "symbols")
    set ST "code_files" (get loaded "files")
    set ST "languages" (get loaded "languages")
    nil

fn open_code_db
    code_db_open (path_join (cache_dir 0) "code.db") (get ST "url") (get ST "ref")

fn open_kw_db
    md_db_open (path_join (cache_dir 0) "docs-kw.db")

-- The pure-Pipe sqlite module persists ONLY on db_close, while the serve
-- handles stay open for the whole process lifetime. Each index therefore
-- runs through a throwaway build handle whose close() flushes to disk,
-- followed by a fresh serve handle loaded from the persisted file. Under
-- the locked rag-serve profile (read-only FS) the final close fails; the
-- catch falls back to an in-memory resync on the serving handle.
fn sync_code_index
    src: get ST "src"
    try
        hb: open_code_db 0
        set ST "sync_code" (code_sync hb src)
        load_code_state hb
        rr_db_close hb
        set ST "idx_code" (open_code_db 0)
    catch e
        ch: get ST "idx_code"
        if ch != nil
            set ST "sync_code" (code_sync ch src)
            load_code_state ch
    nil

fn sync_kw_index
    src: get ST "src"
    try
        kb: open_kw_db 0
        set ST "sync_kw" (md_sync kb src)
        rr_db_close kb
        set ST "idx_kw" (open_kw_db 0)
    catch e
        kh: get ST "idx_kw"
        if kh != nil
            set ST "sync_kw" (md_sync kh src)
    nil

fn build_persistent
    -- Open (or create) both SQLite indexes and incrementally sync them
    -- against the checkout. Works without any AI key: code.db holds the
    -- declaration index for search_code, docs-kw.db holds Markdown chunks
    -- for keyword-only search_docs. Both syncs skip unchanged files via
    -- SHA-256, so warm starts cost a few hash checks per file only.
    sync_code_index 0
    sync_kw_index 0
    nil

fn resync_persistent
    -- Re-run the incremental syncs (refresh_index tool).
    sync_code_index 0
    sync_kw_index 0
    nil

--- === Tool implementations === ---

fn normalize_results results
    out: []
    i: 0
    while i < (len results)
        r: at results i
        item: {}
        set item "path" (get r "path")
        set item "heading" (get r "heading")
        set item "line" (get r "line_start")
        set item "score" (get r "score")
        set item "snippet" (truncate_utf8_safe (get r "text") 400)
        push out item
        i: i + 1
    out

fn _significant_tokens question
    ql: lower question
    raw: split ql " "
    sig: []
    i: 0
    while i < (len raw)
        hy_parts: split (at raw i) "-"
        h: 0
        while h < (len hy_parts)
            us_parts: split (at hy_parts h) "_"
            u: 0
            while u < (len us_parts)
                t: at us_parts u
                if (len t) >= 4
                    push sig t
                u: u + 1
            h: h + 1
        i: i + 1
    sig

fn _chunk_keyword_hits text_lower heading_lower sig
    hits: 0
    i: 0
    while i < (len sig)
        t: at sig i
        if (contains text_lower t) || (contains heading_lower t)
            hits: hits + 1
        i: i + 1
    hits

fn mcp_search_docs query
    if query == nil || query == ""
        return []
    -- Semantic hybrid search when an AI key is configured...
    if (get ST "has_ai") == true
        idx: get ST "idx_docs"
        if idx != nil
            try
                return (normalize_results (doc_search idx query 8))
            catch e
                return ("search failed: " ++ (to_str e))
    -- ...keyword-only fallback over the persistent Markdown chunk index,
    -- which needs no API key and always exists.
    kw: get ST "idx_kw"
    if kw == nil
        return "No documentation index is available (no Markdown found or indexing failed)."
    try
        normalize_results (md_search kw query 8)
    catch e
        "search failed: " ++ (to_str e)

fn mcp_ask_docs question
    if (get ST "has_ai") == false
        return {answer: "Semantic search is unavailable: set DEEPSEEK_API_KEY (or OPENAI_API_KEY) and restart.", sources: []}
    if question == nil || question == ""
        return {answer: "", sources: []}
    idx: get ST "idx_docs"
    if idx == nil
        return {answer: "No documentation index is available (no Markdown found or indexing failed).", sources: []}
    try
        raw: doc_search idx question 6
        sig: _significant_tokens question
        needed: 1
        if (len sig) > 1
            needed: 2
        filtered: []
        fi: 0
        while fi < (len raw)
            r: at raw fi
            keep: true
            if (len sig) > 0
                hits: _chunk_keyword_hits (lower (get r "text")) (lower (get r "heading")) sig
                keep: hits >= needed
            if keep && (get r "score") >= 0.1
                push filtered r
            fi: fi + 1
        if (len filtered) == 0
            return {answer: (ai_chat "You are a documentation assistant. Answer based on your general knowledge." question), sources: []}
        context: ""
        ci: 0
        while ci < (len filtered)
            r: at filtered ci
            context: context ++ "[" ++ (to_str (ci + 1)) ++ "] " ++ (get r "path") ++ ":" ++ (to_str (get r "line_start")) ++ " — " ++ (get r "heading") ++ "\n"
            context: context ++ (get r "text") ++ "\n---\n"
            ci: ci + 1
        system: "You are a documentation assistant. Answer the user's question thoroughly and in detail, based ONLY on the context provided. Explain clearly and completely, step by step where the question asks how to do something. Include code examples exactly as shown in the context when they are relevant. Do not omit details. Cite the source number [n] after every factual statement. If the context does not contain the answer, say so explicitly and do not guess."
        user: "Context:\n" ++ context ++ "\nQuestion: " ++ question
        answer: ai_chat system user
        {answer: answer, sources: filtered}
    catch e
        {answer: ("ask failed: " ++ (to_str e)), sources: []}

fn mcp_read_doc path
    r: safe_resolve_path (get ST "src") path
    if (get r "ok") == false
        return (get r "err")
    read_file (get r "full")

fn mcp_list_docs
    md: get ST "md_files"
    {count: (len md), files: md}

fn _code_score_token symbol content file tok
    s: 0
    if symbol == tok
        s: 100
    else
        if contains symbol tok
            s: s + 60
        if contains content tok
            s: s + 10
        if contains file tok
            s: s + 5
    s

-- Schema keys are passed positionally in SORTED order ("limit" before
-- "query") and omitted optionals shift remaining args left, so a call with
-- only a query arrives as limit=<query string>, query=nil. The header of
-- this handler normalizes both shapes.
fn mcp_search_code limit query
    if (is_str limit) && (query == nil)
        query: limit
        limit: nil
    lim: 20
    if is_num limit
        lim: limit
    if lim < 1
        lim: 1
    if query == nil || query == ""
        return []
    q: lower query
    raw_tokens: split q " "
    tokens: []
    ti: 0
    while ti < (len raw_tokens)
        t: at raw_tokens ti
        if (len t) > 0
            push tokens t
            underscore_parts: split t "_"
            pi: 0
            while pi < (len underscore_parts)
                hyphen_parts: split (at underscore_parts pi) "-"
                hi: 0
                while hi < (len hyphen_parts)
                    frag: at hyphen_parts hi
                    if (len frag) >= 2 && frag != t
                        push tokens frag
                    hi: hi + 1
                pi: pi + 1
        ti: ti + 1
    if (len tokens) == 0
        return []
    syms: get ST "code_symbols"
    scored: []
    i: 0
    while i < (len syms)
        s: at syms i
        -- lowercase copies are precomputed at index time; fall back for
        -- rows that predate the SQLite schema
        symbol: get s "symbol_lower"
        if symbol == nil
            symbol: lower (get s "symbol")
        content: get s "content_lower"
        if content == nil
            content: lower (get s "content")
        file: lower (get s "file")
        score: 0
        tj: 0
        while tj < (len tokens)
            score: score + (_code_score_token symbol content file (at tokens tj))
            tj: tj + 1
        if score > 0
            push scored {s: s, score: score}
        i: i + 1
    ordered: sorted_by scored (fn x: (0 - (get x "score")))
    if lim > (len ordered)
        lim: (len ordered)
    out: []
    j: 0
    while j < lim
        e: at ordered j
        s: get e "s"
        item: {}
        set item "file" (get s "file")
        set item "kind" (get s "kind")
        set item "symbol" (get s "symbol")
        set item "line" (get s "line_start")
        set item "content" (get s "content")
        push out item
        j: j + 1
    out

-- Render "line-number<TAB>text" rows for lines [start_line, start_line+max_lines),
-- mirroring pipe_docs_lib's read_with_numbers output format but with a
-- start offset so agents can page through long files.
fn read_slice_numbers path start_line max_lines
    lines: read_lines path
    n: len lines
    from: start_line - 1
    if from < 0
        from: 0
    if from > n
        from: n
    to: from + max_lines
    if to > n
        to: n
    parts: []
    i: from
    while i < to
        push parts ((to_str (i + 1)) ++ "\t" ++ (at lines i))
        i: i + 1
    text: ""
    if (len parts) > 0
        text: (join parts "\n") ++ "\n"
    {text: text, total: n, truncated: to < n}

-- Same sorted-schema note as mcp_search_code: keys arrive as
-- ("offset", "path"); a call with only a path arrives shifted.
fn mcp_read_source offset path
    if (is_str offset) && (path == nil)
        path: offset
        offset: nil
    start_line: 1
    if is_num offset
        start_line: offset
    if start_line < 1
        start_line: 1
    r: safe_resolve_path (get ST "src") path
    if (get r "ok") == false
        return (get r "err")
    res: read_slice_numbers (get r "full") start_line 500
    text: get res "text"
    if (get res "truncated") == true
        return text ++ "\n... (truncated, showing lines " ++ (to_str start_line) ++ "-" ++ (to_str (start_line + 499)) ++ " of " ++ (to_str (get res "total")) ++ "; use the offset parameter or search_code to locate the relevant symbol)"
    text

fn mcp_list_sources
    files: get ST "code_files"
    {count: (len files), files: files}

-- Outline of one source file: all indexed declarations in line order.
-- Works on the in-memory symbol list loaded from code.db, so it answers
-- without touching the filesystem (safe under the locked rag-serve profile).
fn mcp_file_symbols path
    if path == nil || path == ""
        return {error: "missing required argument: path"}
    syms: get ST "code_symbols"
    out: []
    i: 0
    while i < (len syms)
        s: at syms i
        f: get s "file"
        if f == path || ("./" ++ f) == path
            entry: {kind: (get s "kind"), symbol: (get s "symbol"), line: (get s "line_start")}
            content: get s "content"
            if content != nil
                set entry "content" content
            push out entry
            if (len out) >= 200
                break
        i: i + 1
    {count: (len out), symbols: out}

fn mcp_repo_info
    info: {}
    set info "url" (get ST "url")
    set info "ref" (get ST "ref")
    set info "owner" (get ST "owner")
    set info "name" (get ST "name")
    set info "slug" (get ST "slug")
    set info "ready" (get ST "ready")
    set info "has_ai" (get ST "has_ai")
    set info "ai_ready" (get ST "ai_ready")
    set info "err" (get ST "err")
    set info "languages" (get ST "languages")
    set info "markdown_files" (len (get ST "md_files"))
    set info "source_files" (len (get ST "code_files"))
    set info "code_symbols" (len (get ST "code_symbols"))
    set info "search_mode" "semantic+keyword"
    if (get ST "has_ai") == false
        set info "search_mode" "keyword-only"
    info

fn mcp_index_status
    syms: get ST "code_symbols"
    files: get ST "code_files"
    idx: get ST "idx_docs"
    kw: get ST "idx_kw"
    status: {}
    set status "ready" (get ST "ready")
    set status "has_ai" (get ST "has_ai")
    set status "ai_ready" (get ST "ai_ready")
    set status "err" (get ST "err")
    set status "source_files" (len files)
    set status "code_symbols" (len syms)
    set status "markdown_files" (len (get ST "md_files"))
    set status "languages" (get ST "languages")
    if kw != nil
        set status "docs_kw" (md_status kw)
    if idx != nil
        set status "docs_semantic" (doc_index_status idx)
    set status "sync_code" (get ST "sync_code")
    set status "sync_kw" (get ST "sync_kw")
    status

-- Rebuild-only: under sandbox_lock "rag-serve" exec is permanently blocked,
-- so a network re-fetch (git pull) is impossible here by design. Indexes are
-- synced incrementally from the cached checkout (SHA-256 per file, so only
-- changed files are rescanned); repository updates require a server restart
-- (a ref change re-clones automatically).
fn mcp_refresh
    resync_persistent 0
    if (get ST "has_ai") == true
        idx: get ST "idx_docs"
        if idx != nil
            doc_reindex idx
    out: {code: (get ST "sync_code"), docs_kw: (get ST "sync_kw")}
    if (get ST "has_ai") == true
        set out "docs_semantic" "reindexed"
    out

--- === Startup === ---

fn init_all
    url: get ST "url"
    if url == nil || url == ""
        set ST "err" "REPO_RAG_URL is not set — point it at e.g. https://github.com/user/repo and restart."
        return nil
    if (valid_repo_url url) == false
        set ST "err" "REPO_RAG_URL contains characters outside the allowed set (letters, digits, . _ - / : @ ~ +) — refusing to pass it to the shell."
        return nil
    res: ensure_src 0
    if (get res "ok") == false
        set ST "err" (get res "err")
        return nil
    src: get res "src"
    set ST "src" src
    prune_junk src
    build_all_files 0
    build_md_list 0
    configure_provider 0
    set ST "ai_ready" (get ST "has_ai")
    -- Persistent code + keyword-docs indexes: no AI key required.
    try
        build_persistent 0
    catch e
        set ST "err" ("index build failed: " ++ (to_str e))
        return nil
    if (get ST "has_ai") == true
        try
            build_docs 0
        catch e
            -- Semantic search stays optional; keyword mode keeps serving.
            nil
    set ST "ready" true
    nil

init_all 0

--- Harden: switch to read-only profile and lock it ---
set_sandbox "rag-serve"
sandbox_lock "rag-serve"

server_name: "Repo RAG"
owner: get ST "owner"
repo_name: get ST "name"
if owner != "" && repo_name != ""
    server_name: "Repo RAG (" ++ owner ++ "/" ++ repo_name ++ ")"

ai_tool "search_docs" "Search across ALL Markdown documentation in the repository (README, docs/, wikis). With an AI key configured this is a semantic hybrid search; without one it falls back to keyword-only matching. Returns top matches with path, heading, line number and a snippet." {query: "Search query"} mcp_search_docs
ai_tool "ask_docs" "Answer a question about the repository using its documentation as context, returning the answer and cited source chunks. Requires DEEPSEEK_API_KEY." {question: "Question about the repository"} mcp_ask_docs
ai_tool "read_doc" "Read any file from the repository by relative path (e.g. README.md, docs/architecture.md)." {path: "Repository-relative file path"} mcp_read_doc
ai_tool "list_docs" "List all discovered Markdown files (.md/.mdx) in the repository." {} mcp_list_docs
ai_tool "search_code" "Find functions, types, classes, structs, enums and tests in the repository source (Go, Pipe, Python, JS/TS, Rust + generic fallback) by name or keyword. Returns file, kind, symbol, line and the declaration. Supports up to 200 results via limit." {limit: "Maximum number of results to return, 1-200 (default 20)", query: "Symbol or keyword to find"} mcp_search_code
ai_tool "read_source" "Read a source file with line numbers by relative path. Shows up to 500 lines per call; use offset to page through longer files." {offset: "1-based line number to start reading from (default 1)", path: "Repository-relative source file path"} mcp_read_source
ai_tool "list_sources" "List all recognized source files in the repository." {} mcp_list_sources
ai_tool "file_symbols" "Outline of ONE source file: every indexed declaration (function, type, class, struct, test) with kind, name, line number and the declaration line, in file order. Use it to understand a file's structure before reading it; find candidate paths via search_code or list_sources." {path: "Repository-relative source file path"} mcp_file_symbols
ai_tool "repo_info" "Report which repository is indexed: URL, ref, detected languages, file counts, search mode and readiness." {} mcp_repo_info
ai_tool "index_status" "Report index statistics: source files, code symbols, markdown files, keyword chunks, docs chunks and last sync counts." {} mcp_index_status
ai_tool "refresh_index" "Incrementally re-sync the code and keyword-docs indexes from the cached checkout (no network, only changed files are reprocessed). Repository updates require a server restart." {} mcp_refresh

mcp_server server_name "1.1.0"
mcp_serve_stdio
