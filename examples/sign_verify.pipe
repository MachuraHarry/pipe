--- Message Authentication with HMAC Pipeline
--- Messages flow through hmac_sha256. Verify with compare.

fn sign key message
    hmac_sha256 key message

--- === Demo ===

print "--- Message Authentication ---"

secret: "shared-secret-2024"
msg: "Transfer 100 EUR to Alice"

sig: sign secret msg
print ("Message:   " ++ msg)
print ("Signature: " ++ sig)

--- Verify through pipeline
print ""
(sign secret msg) == sig
    > print

(sign secret "Transfer 999 EUR to Mallory") == sig
    > print

--- Structured data
print ""
print "--- Structured Data Signing ---"

fn sign_pair key user amount
    hmac_sha256 key (key ++ "|" ++ user ++ "|" ++ amount)

data_sig: sign_pair secret "alice" "100.00"
print ("Data hash: " ++ data_sig)

(sign_pair secret "alice" "100.00") == data_sig
    > print

(sign_pair secret "alice" "999.00") == data_sig
    > print
