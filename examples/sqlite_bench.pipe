-- SQLite Benchmark: Pipe (5000 rows)
import "sqlite.pipe"

N: 5000
h: db_open ":memory:"

print ("Pipe SQLite Benchmark (" ++ (to_str N) ++ " rows)")
print "================================="

-- CREATE TABLE
start: now
db_exec h "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER, city TEXT)"
elapsed: (now) - start
print (("create: " ++ (to_str elapsed)) ++ " ms")

-- INSERT N rows
start: now
i: 0
while i < N
  nm: "user_" ++ (to_str i)
  db_exec h ("INSERT INTO users (name, age, city) VALUES ('" ++ nm ++ "', " ++ (to_str (20 + (i % 50))) ++ ", 'city_" ++ (to_str (i % 10)) ++ "')")
  i: i + 1
elapsed: (now) - start
print (("insert: " ++ (to_str elapsed)) ++ " ms")
print (("Inserted: " ++ (to_str N)))

-- SELECT *
start: now
all_rows: db_query h "SELECT * FROM users"
elapsed: (now) - start
print (("select *: " ++ (to_str elapsed)) ++ " ms")
print (("Rows: " ++ (to_str (len all_rows))))

-- WHERE
start: now
filtered: db_query h "SELECT * FROM users WHERE age > 40"
elapsed: (now) - start
print (("select where: " ++ (to_str elapsed)) ++ " ms")
print (("Filtered: " ++ (to_str (len filtered))))

-- GROUP BY
start: now
grouped: db_query h "SELECT city, COUNT(*) as cnt FROM users GROUP BY city"
elapsed: (now) - start
print (("select group: " ++ (to_str elapsed)) ++ " ms")
print (("Groups: " ++ (to_str (len grouped))))

print "================================="
db_close h
