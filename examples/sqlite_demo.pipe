-- SQLite Demo: embedded relational database via the native 'sqlite' Pipe module
-- (db_open, db_exec, db_query, db_close)
--
-- NOTE: requires the 'sqlite' module (see SQLite.md — currently being
-- implemented in pure Pipe; until then db_* builtins are unavailable).

import "sqlite.pipe"

print "═══ SQLITE DEMO ═══"
print ""

-- Open in-memory database (use a file path for persistent storage)
h: db_open ":memory:"

-- Create table
db_exec h "CREATE TABLE tasks (
    id INTEGER PRIMARY KEY,
    title TEXT,
    priority TEXT,
    done INTEGER DEFAULT 0
)"
print "Table created."
print ""

-- Insert data
db_exec h "INSERT INTO tasks (title, priority) VALUES ('Fix login bug', 'high'), ('Update docs', 'medium'), ('Ship v2.0', 'high')"
db_exec h "INSERT INTO tasks (title, priority, done) VALUES ('Old task', 'low', 1)"
print "4 rows inserted."
print ""

-- Query all tasks
print "─── All Tasks ───"
rows: db_query h "SELECT * FROM tasks"
for row in rows
    print ("#" ++ (to_str (get row "id")) ++ " " ++ (get row "title") ++ " [" ++ (get row "priority") ++ "]")

print ""

-- Filtered query
print "─── High Priority ───"
high: db_query h "SELECT title FROM tasks WHERE priority = 'high'"
for row in high
    print ("  ⚡ " ++ (get row "title"))

print ""

-- Aggregate query
print "─── Stats ───"
stats: db_query h "SELECT priority, COUNT(*) as cnt FROM tasks GROUP BY priority"
for row in stats
    print ((get row "priority") ++ ": " ++ (to_str (get row "cnt")))

print ""

-- Update
db_exec h "UPDATE tasks SET done = 1 WHERE title = 'Fix login bug'"
updated: db_query h "SELECT title, done FROM tasks WHERE title = 'Fix login bug'"
for row in updated
    print ((get row "title") ++ " → done: " ++ (to_str (get row "done")))

print ""

-- Close
db_close h

print "═══ DONE ═══"