--! TCP echo server and client demo.

--! Starts an echo server on port 9999 and prints one received message.
fn run_server
    print "Echo-Server auf :9999..."
    ln: tcp_listen "0.0.0.0" 9999
    conn: tcp_accept ln
    msg: tcp_read conn
    print "Empfangen:"
    print msg
    tcp_write conn ("ECHO: " ++ msg)
    tcp_close conn
    tcp_close ln

--! Connects to the echo server, sends a message, and prints the reply.
fn run_client message
    print "Verbinde zu :9999..."
    conn: tcp_connect "127.0.0.1" 9999
    tcp_write conn message
    reply: tcp_read conn
    print "Antwort:"
    print reply
    tcp_close conn

print "=== TCP Echo-Demo ==="
print "Starte Server im Hintergrund..."
print "(kein Hintergrund-Support — starte manuell)"
print ""
print "Server command:"
print "  pipe -e 'tcp_listen' 0.0.0.0 9999"
