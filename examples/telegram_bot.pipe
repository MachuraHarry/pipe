--- ============================================================
--- telegram_bot.pipe - Echo + AI bot for Telegram
--- Requires: Pipe v0.8+ and the "telegram" module
--- Sandbox: needs network -> run with --sandbox-profile networked
--- Usage:
---   export TELEGRAM_BOT_TOKEN="123456:ABC..."
---   export DEEPSEEK_API_KEY="sk-..."   -- optional, for AI commands
---   pipe examples/telegram_bot.pipe
--- Commands:
---   /start              - intro with inline buttons
---   /summarize <text>   - AI summary
---   /translate <text>   - AI translation to German
---   anything else       - echo
--- Buttons: "AI-Demo" (summary + reaction), "Help"
--- ============================================================

import "../pipe-modules/telegram-bot/module.pipe"

--- === AI setup (optional: enables /summarize and /translate) ===

ai_provider "deepseek"
dk: env "DEEPSEEK_API_KEY"
if dk != nil && dk != ""
    ai_set_key "deepseek" dk

fn handle bot msg
    chat_id: get (get msg "chat") "id"
    text: get msg "text"
    if text == nil
        return nil
    t: trim text
    if t == "/start"
        buttons: [[{text: "AI-Demo", callback_data: "ai_demo"}], [{text: "Help", callback_data: "help"}]]
        tg_send_buttons bot chat_id "Echo + AI bot ready!\nSend /summarize <text>, /translate <text>, or press a button." buttons
        return nil
    if (substring t 0 10) == "/summarize"
        prompt: trim (substring t 10 (len t))
        if prompt == ""
            tg_send_text bot chat_id "Usage: /summarize <text>"
            return nil
        tg_send_chat_action bot chat_id "typing"
        s: summarize prompt
        tg_send_md bot chat_id ("*Summary:*\n" ++ s)
        return nil
    if (substring t 0 10) == "/translate"
        prompt: trim (substring t 10 (len t))
        if prompt == ""
            tg_send_text bot chat_id "Usage: /translate <text>"
            return nil
        tr: translate prompt "German"
        tg_send_md bot chat_id ("*Translation (DE):*\n" ++ tr)
        return nil
    tg_send_text bot chat_id ("Echo: " ++ text)

fn handle_callback bot q
    qid: get q "id"
    data: get q "data"
    msg: get q "message"
    if msg == nil
        tg_answer_callback_query bot qid "Done"
        return nil
    chat_id: get (get msg "chat") "id"
    message_id: get msg "message_id"
    if data == "help"
        tg_answer_callback_query bot qid "Commands: /summarize <text>, /translate <text>"
        return nil
    if data == "ai_demo"
        tg_answer_callback_query bot qid "Working..."
        tg_send_chat_action bot chat_id "typing"
        s: summarize "Pipe is an AI-native scripting language with built-in AI functions for summarization, translation and generation."
        tg_reply_text bot chat_id ("AI-Demo summary:\n" ++ s) message_id
        tg_set_reaction bot chat_id message_id "👍"
        return nil
    tg_answer_callback_query bot qid ("Unknown button: " ++ data)

--- === Main loop (long polling) ===

bot: tg_bot nil
me: tg_me bot
print ("Bot @" ++ (get me "username") ++ " running... (Ctrl+C to stop)")

while true
    try
        updates: tg_get_updates bot 25 nil
        for u in updates
            msg: get u "message"
            if msg != nil
                handle bot msg
            else
                q: get u "callback_query"
                if q != nil
                    handle_callback bot q
    catch e
        print ("poll error: " ++ e)
    sleep 200
