--! Text statistics: counts words, shows uppercasing, and checks for terms.

--! Analyzes a text: word count, uppercasing, and term checks.
fn analyze text
    words: split text " "
    print "Text: "
    print text
    print ""
    print "Word count: "
    print (len words)
    print ""
    print "In GROSS: "
    print (upper text)
    print ""
    print "Contains 'world'?"
    print (contains text "Welt")
    print "Contains 'Mars'?"
    print (contains text "Mars")

analyze "Hallo Welt von Pipe"
