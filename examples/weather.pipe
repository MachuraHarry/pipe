-- Wetter-API Client (mock — echte API braucht Key)

fn fetch_weather city
    -- Use httpbin for demo; real API would be:
    -- api_key: env "WEATHER_API_KEY"
    -- url: "https://api.openweathermap.org/data/2.5/weather?q=" ++ city
    url: "https://httpbin.org/get?city=" ++ city
    print "Fetching weather for: "
    print city
    print "URL: "
    print url
    resp: http_get url
    print "Status: "
    print (get resp "status")
    resp

fn process_weather data
    print ""
    print "--- Wetterbericht ---"
    print "Quelle: httpbin.org (Demo)"
    print ""

-- Demo
w: fetch_weather "Berlin"
print "Antwort geladen."
