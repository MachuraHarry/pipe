--! XOR cipher: bytewise encryption with a repeating key, hex view, and roundtrip.

--! Encrypts or decrypts text by XORing each byte with a repeating key.
fn xor_bytes text key
    raw: to_bytes text
    key_raw: to_bytes key
    key_len: len key_raw
    result: to_bytes ""
    i: 0
    while i < (len raw)
        tb: bytes_to_int raw i 1
        kb: bytes_to_int key_raw (i % key_len) 1
        result: bytes_append result (int_to_bytes (bit_xor tb kb) 1)
        i: i + 1
    from_bytes result

--- === Demo ===

print "--- XOR Cipher ---"

message: "SecretMessage42"
key: "mykey"

--- Encrypt
enc: xor_bytes message key

--- Show hex encoding of cipher
print ("Cipher hex: " ++ (hex_encode (to_bytes enc)))

--- Decrypt through pipeline
xor_bytes enc key
    > print

print ""
if (xor_bytes enc key) == message
    print "SUCCESS: Roundtrip works"
else
    print "FAILED: Data corrupted"
