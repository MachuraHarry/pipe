--! Sends GitHub event notifications via a Discord webhook with AI code review.
--! Called from CI; inputs arrive via env (EVENT_NAME, REPO, DISCORD_WEBHOOK, ...).

import "discord.pipe" as d
ai_provider "deepseek"

webhook: env "DISCORD_WEBHOOK"
repo: env "REPO"
ev: env "EVENT_NAME"
key: env "DEEPSEEK_API_KEY"

--! Picks an emoji for a notification subject.
fn emoji_for subj
    if (len subj) < 2
        return "🟣"
    w: lower (get (split subj " ") 0)
    w: replace_all w ":" ""
    if contains w "("
        w: get (split w "(") 0
    w: trim (lower w)
    if w == "feat"
        return "✨"
    else if w == "fix"
        return "🐛"
    else if w == "chore"
        return "🔧"
    else if w == "docs"
        return "📚"
    else if w == "refactor"
        return "♻️"
    else if w == "test"
        return "🧪"
    else if w == "style"
        return "🎨"
    else if w == "ci"
        return "⚙️"
    else if w == "perf"
        return "⚡"
    else if w == "build"
        return "📦"
    else if w == "revert"
        return "⏪"
    else if w == "release"
        return "🚀"
    return "🟣"

fn clip text n
    if (len text) > n
        (substring text 0 n) ++ "…"
    else
        text

fn send_embed title desc fields color
    embed: {title: (clip title 256), description: (clip desc 4096), fields: fields, color: color}
    payload: {embeds: [embed]}
    r: d.d_webhook_send webhook payload
    if is_err r
        print ("Discord-Fehler: " ++ (to_str r))

if ev == "push"
    branch: env "BRANCH"
    commits: []
    if (len (env "COMMITS_JSON")) > 0
        commits: parse_json (env "COMMITS_JSON")
    if (len commits) > 0
        print ("⏳ AI review for " ++ (to_str (len commits)) ++ " commit(s) …")
        for i in (range 0 (len commits))
            c: at commits i
            sha: get c "id"
            short_sha: substring sha 0 7
            subject: get (split (get c "message") "\n") 0
            url: "https://github.com/" ++ repo ++ "/commit/" ++ sha

            diff: get (exec ("git show --stat --patch --format= " ++ sha)) "output"
            lines: split diff "\n"
            if (len lines) > 500
                lines: slice_list lines 0 500
            diff: join lines "\n"
            stat: get (exec ("git show --stat --format= " ++ sha)) "output"

            review: ""
            footer_text: ""
            if (key != nil) && ((len key) > 0)
                sys: "You are an experienced senior developer. Write a CONCISE code review in English (max. 150 words). Plain text without markdown or formatting: no **, ##, backticks, links, or HTML. Structure: 1) What does the commit change in 1-2 sentences? 2) The most important point or 1-2 most important changes. 3) Risks, bugs, or missing tests. Reply ONLY with the review, no introduction."
                try
                    ai_cost "reset"
                    review: ai_chat sys ("Commit: " ++ subject ++ "\n\nFiles:\n" ++ stat ++ "\n\nDiff:\n" ++ diff) 800
                    cm: ai_cost
                    cost_usd: get cm "cost_usd"
                    c2: round (cost_usd * 1000000.0)
                    c2: c2 / 1000000.0
                    footer_text: "DeepSeek · max. 800 Tokens · ~$" ++ (to_str c2)
                catch e
                    review: "AI review failed: " ++ e
            else
                review: "No DEEPSEEK_API_KEY set — no AI review."
            
            review: clip review 1020

            stat_clipped: replace_all (clip stat 1000) "\t" "  "
            fields: []
            push fields ( {name: "Changed Files", value: ("```\n" ++ stat_clipped ++ "\n```"), inline: false} )
            
            if (len review) > 0
                push fields ( {name: "AI Review", value: review, inline: false} )

            color: 3447003
            if contains (lower subject) "fix"
                color: 15158332
            if contains (lower subject) "feat"
                color: 3066993
            if contains (lower subject) "docs"
                color: 10181046

            embed_title: (emoji_for subject) ++ " [" ++ branch ++ "] " ++ subject
            embed_desc: ("`" ++ short_sha ++ "` · " ++ url)

            embed: {title: (clip embed_title 256), description: embed_desc, fields: fields, color: color, footer: {text: footer_text}}
            payload: {embeds: [embed]}
            r: d.d_webhook_send webhook payload
            if is_err r
                print ("Discord-Fehler: " ++ (to_str r))
            print ("✓ " ++ short_sha ++ " — Review sent")
    else
        subject: get (split (env "COMMIT_MSG") "\n") 0
        send_embed ((emoji_for subject) ++ " " ++ subject) ("Branch: " ++ branch ++ "\nRepo: " ++ repo) [] 3447003
else if ev == "release"
    tag: env "RELEASE_TAG"
    url: env "RELEASE_URL"
    name: env "RELEASE_NAME"
    if (len name) < 1
        name: tag
    body: clip (env "RELEASE_BODY") 2048
    pre: env "RELEASE_PRERELEASE"
    draft: env "RELEASE_DRAFT"
    wh: webhook
    rwh: env "DISCORD_RELEASES_WEBHOOK"
    if (rwh != nil) && ((len rwh) > 0)
        wh: rwh
    color: 3066993
    status: "✅ Stable"
    if pre == "true"
        color: 16776960
        status: "🧪 Pre-Release"
    if draft == "true"
        color: 10181046
        status: "📝 Draft"

    fields: []
    push fields ( {name: "Tag", value: tag, inline: true} )
    push fields ( {name: "Status", value: (clip status 50), inline: true} )
    push fields ( {name: "Release", value: url, inline: true} )
    if (len body) > 0
        push fields ( {name: "Highlights", value: body, inline: false} )

    embed: {title: ("🚀 " ++ name), url: url, description: (repo ++ " release"), fields: fields, color: color, footer: {text: tag}}
    payload: {embeds: [embed]}
    r: d.d_webhook_send wh payload
    if is_err r
        print ("Discord-Fehler: " ++ (to_str r))
else if ev == "issues"
    action: env "EVENT_ACTION"
    icon: "📌"
    color: 16776960
    if action == "closed"
        icon: "✅"
        color: 3066993
    if action == "reopened"
        icon: "🔄"
        color: 16776960
    
    fields: []
    push fields ( {name: "Issue", value: (env "ISSUE_NUMBER"), inline: true} )
    push fields ( {name: "Action", value: action, inline: true} )
    
    embed: {title: (icon ++ " " ++ (env "ISSUE_TITLE")), url: (env "ISSUE_URL"), description: ("#" ++ (env "ISSUE_NUMBER") ++ " · " ++ (env "ISSUE_URL")), fields: fields, color: color, footer: {text: repo}}
    payload: {embeds: [embed]}
    r: d.d_webhook_send webhook payload
    if is_err r
        print ("Discord-Fehler: " ++ (to_str r))
else
    r: d.d_webhook_text webhook ("🐙 Event: " ++ ev ++ " in " ++ repo)
    if is_err r
        print ("Discord-Fehler: " ++ (to_str r))

print "Discord notification sent"
