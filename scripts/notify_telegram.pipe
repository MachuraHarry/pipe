--- ============================================================
--- notify_telegram.pipe - Sends GitHub event notifications via the
--- Telegram Bot API. Called from .github/workflows/notify-telegram.yml.
--- On push: reviews EVERY commit (real diff) with the AI (DeepSeek),
--- writes a detailed German code review and sends it via Telegram.
--- Inputs via env: EVENT_NAME, EVENT_ACTION, REPO, BRANCH,
---   COMMITS_JSON, COMMIT_MSG, COMMIT_URL, ISSUE_TITLE, ISSUE_NUMBER,
---   ISSUE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, DEEPSEEK_API_KEY
--- ============================================================

ai_provider "deepseek"

token: env "TELEGRAM_BOT_TOKEN"
chat: env "TELEGRAM_CHAT_ID"
repo: env "REPO"

fn esc text
    t: replace_all text "&" "&amp;"
    t: replace_all t "<" "&lt;"
    replace_all t ">" "&gt;"

fn send_telegram text
    n: len text
    if n > 0
        payload: {chat_id: chat, text: text, parse_mode: "HTML"}
        headers: {}
        set headers "Content-Type" "application/json"
        d: parse_json (get (http_request "POST" ("https://api.telegram.org/bot" ++ token ++ "/sendMessage") headers (to_json payload)) "body")
        if (get d "ok") != true
            raise (get d "description")

fn send_chunked text
    n: len text
    start: 0
    while start < n
        end: start + 3800
        if end > n
            end: n
        send_telegram (substring text start end)
        start: end

fn emoji_for subj
    if (len subj) < 2
        return "🟣"
    w: lower (get (split subj " ") 0)
    w: replace_all w ":" ""
    if contains w "("
        w: get (split w "(") 0
    w: trim (lower w)
    if w == "feat"
        return "✨"
    else if w == "fix"
        return "🐛"
    else if w == "chore"
        return "🔧"
    else if w == "docs"
        return "📚"
    else if w == "refactor"
        return "♻️"
    else if w == "test"
        return "🧪"
    else if w == "style"
        return "🎨"
    else if w == "ci"
        return "⚙️"
    else if w == "perf"
        return "⚡"
    else if w == "build"
        return "📦"
    else if w == "revert"
        return "⏪"
    else if w == "release"
        return "🚀"
    return "🟣"

ev: env "EVENT_NAME"

if ev == "push"
    branch: env "BRANCH"
    key: env "DEEPSEEK_API_KEY"
    commits: []
    if (len (env "COMMITS_JSON")) > 0
        commits: parse_json (env "COMMITS_JSON")
    if (len commits) > 0
        print ("⏳ KI-Review von " ++ (to_str (len commits)) ++ " Commit(s) …")
        for i in (range 0 (len commits))
            c: at commits i
            sha: get c "id"
            short_sha: substring sha 0 7
            subject: get (split (get c "message") "\n") 0
            url: "https://github.com/" ++ repo ++ "/commit/" ++ sha

            diff: get (exec ("git show --stat --patch --format= " ++ sha)) "output"
            lines: split diff "\n"
            if (len lines) > 500
                lines: slice_list lines 0 500
            diff: join lines "\n"
            stat: get (exec ("git show --stat --format= " ++ sha)) "output"

            review: ""
            footer: ""
            if (len key) > 0
                sys: "Du bist ein erfahrener Senior-Entwickler. Schreibe ein KOMPAKTES deutsches Code-Review (max. 150 Wörter). Klartext ohne Markdown und ohne Formatierungszeichen: keine **, ##, Backticks, Links oder HTML. Struktur: 1) Was ändert der Commit in 1-2 Sätzen? 2) Der wichtigste Punkt bzw. die 1-2 wichtigsten Änderungen. 3) Risiken, Bugs oder fehlende Tests. Antworte NUR mit dem Review, ohne Einleitung."
                try
                    ai_cost "reset"
                    review: esc (ai_chat sys ("Commit-Betreff: " ++ subject ++ "\n\nDateien:\n" ++ stat ++ "\n\nDiff:\n" ++ diff) 800)
                    cm: ai_cost
                    cost_usd: get cm "cost_usd"
                    c: round (cost_usd * 1000000.0)
                    c: c / 1000000.0
                    footer: "<i>DeepSeek · max. 800 Tokens · ~$" ++ (to_str c) ++ "</i>"
                catch e
                    review: "<s>" ++ (esc ("KI-Review fehlgeschlagen: " ++ e)) ++ "</s>"
            else
                review: "<i>Kein DEEPSEEK_API_KEY gesetzt — nur Commit-Infos gesendet.</i>"
            if (len review) > 2800
                review: (substring review 0 2800) ++ " …"

            msg: "<b>🐙 " ++ (esc repo) ++ "</b> · <code>" ++ (esc branch) ++ "</code>\n\n"
            msg: msg ++ (emoji_for subject) ++ " <b>" ++ (esc subject) ++ "</b>\n"
            msg: msg ++ "🔗 <code>" ++ (esc short_sha) ++ "</code> · <a href=\"" ++ url ++ "\">Commit ansehen</a>\n\n"
            msg: msg ++ "📊 <b>Geänderte Dateien</b>\n<pre>" ++ (esc (trim stat)) ++ "</pre>"

            if (len review) > 0
                msg: msg ++ "\n\n🤖 <b>KI-Review</b>\n<blockquote>" ++ review ++ "</blockquote>"
                if (len footer) > 0
                    msg: msg ++ "\n" ++ footer

            send_chunked msg
            print ("✓ " ++ short_sha ++ " — Review gesendet")
    else
        commit_first_line: get (split (env "COMMIT_MSG") "\n") 0
        m2: "<b>🐙 " ++ (esc repo) ++ "</b> — 📦 Push <code>" ++ (esc (env "BRANCH")) ++ "</code>\n\n"
        m2: m2 ++ (emoji_for commit_first_line) ++ " <b>" ++ (esc commit_first_line) ++ "</b>\n"
        m2: m2 ++ "🔗 <a href=\"" ++ (env "COMMIT_URL") ++ "\">Commit ansehen</a>"
        send_telegram m2
else if ev == "issues"
    m3: "<b>🐙 " ++ (esc repo) ++ "</b> — 🗂 <b>Issue <i>" ++ (esc (env "EVENT_ACTION")) ++ "</i></b>\n\n"
    m3: m3 ++ "📌 <b>" ++ (esc (env "ISSUE_TITLE")) ++ "</b>\n"
    m3: m3 ++ "🔗 <code>#" ++ (esc (env "ISSUE_NUMBER")) ++ "</code> · <a href=\"" ++ (env "ISSUE_URL") ++ "\">Issue ansehen</a>"
    send_telegram m3
else
    send_telegram ("<b>🐙 " ++ (esc repo) ++ "</b>")

print "Fertig."
