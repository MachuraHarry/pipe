--! Tests for pipe-docs security: path traversal prevention.
--! Exercises safe_resolve_path from examples/lib/pipe_docs_lib.pipe — the
--! single gate behind read_doc and read_source in the MCP server.
--! Run from the repository root: pipe scripts/pipe-docs-security-test.pipe

import "examples/lib/pipe_docs_lib.pipe"

--- === Setup: create temp fixture === ---

root: "/tmp/pipe-docs-security-test"
make_dir root
make_dir (root ++ "/safe/dir")
write_file (root ++ "/hello.txt") "hello world"
write_file (root ++ "/safe/dir/nested.txt") "nested content"

--- === safe_resolve_path: accepted paths === --

test "safe_resolve_path resolves valid file"
    r: safe_resolve_path root "hello.txt"
    assert_eq (get r "ok") true
    assert_eq (read_file (get r "full")) "hello world"

test "safe_resolve_path resolves nested file"
    r: safe_resolve_path root "safe/dir/nested.txt"
    assert_eq (get r "ok") true
    assert_eq (read_file (get r "full")) "nested content"

--- === safe_resolve_path: rejected paths === --

test "safe_resolve_path rejects nil"
    r: safe_resolve_path root nil
    assert_eq (get r "ok") false
    assert_eq (get r "err") "missing path"

test "safe_resolve_path rejects empty string"
    r: safe_resolve_path root ""
    assert_eq (get r "ok") false
    assert_eq (get r "err") "missing path"

test "safe_resolve_path rejects path traversal with .."
    r: safe_resolve_path root "../etc/passwd"
    assert_eq (get r "ok") false
    assert_eq (get r "err") "invalid path"

test "safe_resolve_path rejects embedded .."
    r: safe_resolve_path root "safe/../../etc/passwd"
    assert_eq (get r "ok") false
    assert_eq (get r "err") "invalid path"

test "safe_resolve_path rejects trailing .."
    r: safe_resolve_path root "safe/dir/.."
    assert_eq (get r "ok") false
    assert_eq (get r "err") "invalid path"

test "safe_resolve_path rejects .. at start"
    r: safe_resolve_path root ".."
    assert_eq (get r "ok") false
    assert_eq (get r "err") "invalid path"

test "safe_resolve_path rejects absolute paths"
    r: safe_resolve_path root "/etc/passwd"
    assert_eq (get r "ok") false
    assert_eq (get r "err") "invalid path"

test "safe_resolve_path reports missing files"
    r: safe_resolve_path root "nonexistent.txt"
    assert_eq (get r "ok") false
    assert_contains (get r "err") "file not found"

--- === read_with_numbers integration on resolved paths === --

test "numbered read works through resolved path"
    r: safe_resolve_path root "hello.txt"
    n: read_with_numbers (get r "full") 0
    assert_contains (get n "text") "1\thello world"

print "=== pipe-docs security tests complete ==="
