--! Tests for repo-rag indexing helpers: URL/slug parsing, junk-dir and
--! extension classification, Python/JS-TS/Rust/generic declaration parsers,
--! the junk-aware tree walker and relative path mapping.
--! Exercises examples/lib/repo_rag_lib.pipe against fixtures and inline
--! strings. No network or AI key required.
--! Run from the repository root: pipe scripts/repo-rag-code-index-test.pipe

import "examples/lib/repo_rag_lib.pipe"

--- === String helper tests ===

test "has_prefix basic"
    assert_eq (has_prefix "export fn foo" "export ") true
    assert_eq (has_prefix "export fn foo" "import ") false
    assert_eq (has_prefix "ex" "export ") false
    assert_eq (has_prefix "" "") true

test "strip_suffix removes only exact tail"
    assert_eq (strip_suffix "repo.git" ".git") "repo"
    assert_eq (strip_suffix "repo" ".git") "repo"
    assert_eq (strip_suffix "a/" "/") "a"

test "index_of finds first occurrence"
    assert_eq (index_of "hello world" "o") 4
    assert_eq (index_of "abc" "x") (0 - 1)
    assert_eq (index_of "abc" "") 0
    assert_eq (index_of "a:b:c" ":") 1

test "ltrim strips spaces and tabs"
    assert_eq (ltrim "  hi") "hi"
    assert_eq (ltrim "\t\tx") "x"
    assert_eq (ltrim "none") "none"
    assert_eq (ltrim "") ""

--- === slug_parts tests ===

test "slug_parts parses github https url"
    r: slug_parts "https://github.com/octocat/Hello-World.git"
    assert_eq (get r "ok") true
    assert_eq (get r "owner") "octocat"
    assert_eq (get r "repo") "Hello-World"
    assert_eq (get r "slug") "octocat__Hello-World"

test "slug_parts tolerates trailing slash"
    r: slug_parts "https://github.com/owner/repo/"
    assert_eq (get r "ok") true
    assert_eq (get r "repo") "repo"

test "slug_parts parses scp-like git url"
    r: slug_parts "git@github.com:owner/repo.git"
    assert_eq (get r "ok") true
    assert_eq (get r "owner") "owner"
    assert_eq (get r "repo") "repo"

test "slug_parts takes last two segments"
    r: slug_parts "https://gitlab.com/group/sub/repo"
    assert_eq (get r "ok") true
    assert_eq (get r "owner") "sub"
    assert_eq (get r "repo") "repo"

test "slug_parts handles local paths"
    r: slug_parts "/home/me/projects/tool"
    assert_eq (get r "ok") true
    assert_eq (get r "owner") "projects"
    assert_eq (get r "repo") "tool"

test "slug_parts rejects unusable input"
    assert_eq (get (slug_parts "justname") "ok") false
    assert_eq (get (slug_parts "") "ok") false
    assert_eq (get (slug_parts nil) "ok") false

--- === classification tests ===

test "is_junk_dir flags build noise only"
    assert_eq (is_junk_dir "node_modules") true
    assert_eq (is_junk_dir "__pycache__") true
    assert_eq (is_junk_dir "Pods") true
    assert_eq (is_junk_dir "") true
    assert_eq (is_junk_dir "src") false
    -- bin is deliberately NOT junk (some repos keep scripts there)
    assert_eq (is_junk_dir "bin") false

test "ext_lang maps dedicated languages"
    assert_eq (ext_lang ".go") "go"
    assert_eq (ext_lang ".pipe") "pipe"
    assert_eq (ext_lang ".py") "python"
    assert_eq (ext_lang ".pyi") "python"
    assert_eq (ext_lang ".jsx") "javascript"
    assert_eq (ext_lang ".mts") "typescript"
    assert_eq (ext_lang ".rs") "rust"
    assert_eq (ext_lang ".java") ""
    assert_eq (ext_lang ".png") ""

test "is_fallback_ext covers text languages not binaries"
    assert_eq (is_fallback_ext ".java") true
    assert_eq (is_fallback_ext ".rb") true
    assert_eq (is_fallback_ext ".sh") true
    -- dedicated scanners take precedence, fallback flag irrelevant
    assert_eq (is_fallback_ext ".rs") false
    assert_eq (is_fallback_ext ".png") false
    assert_eq (is_fallback_ext ".zip") false

test "lang_for_file labels census buckets"
    assert_eq (lang_for_file "a/b.go") "go"
    assert_eq (lang_for_file "a/b.tsx") "typescript"
    assert_eq (lang_for_file "a/b.java") "generic"
    assert_eq (lang_for_file "a/b.png") ""

--- === py_decl tests ===

test "py_decl detects functions and classes"
    r: py_decl "def compute(a, b):"
    assert_eq (get r "kind") "func"
    assert_eq (get r "symbol") "compute"
    r: py_decl "async def fetch_all():"
    assert_eq (get r "kind") "func"
    assert_eq (get r "symbol") "fetch_all"
    r: py_decl "class Animal(Base):"
    assert_eq (get r "kind") "class"
    assert_eq (get r "symbol") "Animal"

test "py_decl ignores non-declarations"
    assert_eq (py_decl "import os") nil
    assert_eq (py_decl "# def fake():") nil
    assert_eq (py_decl "    def nested():") nil

--- === js_decl tests ===

test "js_decl detects plain and exported functions"
    r: js_decl "function greet(name) {"
    assert_eq (get r "kind") "func"
    assert_eq (get r "symbol") "greet"
    r: js_decl "export default function handler() {"
    assert_eq (get r "symbol") "handler"
    r: js_decl "export async function load() {"
    assert_eq (get r "symbol") "load"
    r: js_decl "function* gen() {}"
    assert_eq (get r "symbol") "gen"

test "js_decl detects classes interfaces enums types"
    assert_eq (get (js_decl "class Foo extends Bar {") "symbol") "Foo"
    assert_eq (get (js_decl "interface User {") "kind") "interface"
    assert_eq (get (js_decl "enum Color {") "kind") "enum"
    assert_eq (get (js_decl "type Alias = string;") "kind") "type"
    assert_eq (get (js_decl "type Alias = string;") "symbol") "Alias"

test "js_decl classifies bindings by right-hand side"
    r: js_decl "const handler = async (req) => {"
    assert_eq (get r "kind") "func"
    assert_eq (get r "symbol") "handler"
    r: js_decl "const add = (a, b) => a + b"
    assert_eq (get r "kind") "func"
    r: js_decl "const limit = 10;"
    assert_eq (get r "kind") "var"
    r: js_decl "let total = items.reduce(sum, 0)"
    assert_eq (get r "kind") "var"
    r: js_decl "var legacy = function () {}"
    assert_eq (get r "kind") "func"

--- === rs_decl tests ===

test "rs_decl detects functions incl pub variants"
    assert_eq (get (rs_decl "fn main() {") "symbol") "main"
    r: rs_decl "pub fn new() -> Self {"
    assert_eq (get r "kind") "func"
    assert_eq (get r "symbol") "new"
    r: rs_decl "pub(crate) fn helper() {"
    assert_eq (get r "symbol") "helper"

test "rs_decl detects structs enums traits mods"
    assert_eq (get (rs_decl "struct Point {") "kind") "struct"
    assert_eq (get (rs_decl "struct Wrapper<T> {") "symbol") "Wrapper"
    assert_eq (get (rs_decl "enum Mode {") "kind") "enum"
    assert_eq (get (rs_decl "trait Speak {") "kind") "trait"
    assert_eq (get (rs_decl "mod utils;") "kind") "module"
    assert_eq (get (rs_decl "type Alias = u32;") "symbol") "Alias"
    assert_eq (get (rs_decl "const MAX: usize = 10;") "kind") "const"
    assert_eq (get (rs_decl "static NAME: &str = \"x\";") "kind") "const"

test "rs_decl extracts impl targets"
    assert_eq (get (rs_decl "impl Config {") "kind") "impl"
    assert_eq (get (rs_decl "impl Config {") "symbol") "Config"
    assert_eq (get (rs_decl "impl Trait for Dog {") "symbol") "Dog"
    assert_eq (get (rs_decl "impl<T> Parser<T> for Json {") "symbol") "Json"

--- === generic_decl tests ===

test "generic_decl handles visibility modifiers"
    r: generic_decl "public class Main {"
    assert_eq (get r "kind") "class"
    assert_eq (get r "symbol") "Main"
    r: generic_decl "final class Utility {"
    assert_eq (get r "symbol") "Utility"

test "generic_decl covers common bare keywords"
    assert_eq (get (generic_decl "struct Point {") "kind") "struct"
    assert_eq (get (generic_decl "def ruby_method") "symbol") "ruby_method"
    assert_eq (get (generic_decl "module Cache") "kind") "module"

test "generic_decl skips comments and decorators"
    assert_eq (generic_decl "# def fake()") nil
    assert_eq (generic_decl "// struct fake") nil
    assert_eq (generic_decl "@decorator") nil
    assert_eq (generic_decl "") nil

--- === scanner fixture tests ===

test "scan_py_file parses top level only"
    tmp: "/tmp/repo-rag-test-py"
    make_dir tmp
    write_file (tmp ++ "/mod.py") "import os\n\n# comment\n\ndef top_fn(a):\n    return a\n\nclass Animal:\n\n    def speak(self):\n        pass\n\ndef second():\n    return 2\n"
    decls: scan_py_file (tmp ++ "/mod.py")
    assert_eq (len decls) 3
    assert_eq (get (at decls 0) "symbol") "top_fn"
    assert_eq (get (at decls 0) "line_start") 5
    assert_eq (get (at decls 1) "kind") "class"
    assert_eq (get (at decls 1) "line_start") 8
    -- indented method must NOT appear as top-level symbol
    assert_eq (get (at decls 2) "symbol") "second"

test "scan_js_ts_file parses mixed declarations"
    tmp: "/tmp/repo-rag-test-js"
    make_dir tmp
    write_file (tmp ++ "/app.ts") "import {x} from \"y\"\n\nexport class Server {\n    start() {}\n}\n\nconst port = 3000\n\nexport const handler = async (req) => {\n    return req\n}\n\nfunction plain() {}\n"
    decls: scan_js_ts_file (tmp ++ "/app.ts")
    assert_eq (len decls) 4
    assert_eq (get (at decls 0) "kind") "class"
    assert_eq (get (at decls 0) "line_start") 3
    assert_eq (get (at decls 1) "kind") "var"
    assert_eq (get (at decls 1) "symbol") "port"
    assert_eq (get (at decls 2) "kind") "func"
    assert_eq (get (at decls 2) "symbol") "handler"
    assert_eq (get (at decls 3) "symbol") "plain"

test "scan_rs_file parses rust declarations"
    tmp: "/tmp/repo-rag-test-rs"
    make_dir tmp
    write_file (tmp ++ "/lib.rs") "use std::fmt;\n\npub struct Counter {\n    n: i64,\n}\n\nimpl Counter {\n    pub fn bump(&mut self) {}\n}\n\nenum State {\n    On,\n    Off,\n}\n\ntrait Reset {\n    fn reset(&self);\n}\n"
    decls: scan_rs_file (tmp ++ "/lib.rs")
    -- methods inside impl blocks are indented -> only top-level decls count
    assert_eq (len decls) 4
    assert_eq (get (at decls 0) "kind") "struct"
    assert_eq (get (at decls 1) "kind") "impl"
    assert_eq (get (at decls 1) "symbol") "Counter"
    assert_eq (get (at decls 2) "kind") "enum"
    assert_eq (get (at decls 3) "kind") "trait"

test "scan_any_file dispatches by extension"
    tmp: "/tmp/repo-rag-test-any"
    make_dir tmp
    write_file (tmp ++ "/thing.py") "def api():\n    pass\n"
    write_file (tmp ++ "/Thing.java") "public class Thing {\n}\n"
    write_file (tmp ++ "/logo.png") "binary-ish"
    assert_eq (len (scan_any_file (tmp ++ "/thing.py"))) 1
    j: scan_any_file (tmp ++ "/Thing.java")
    assert_eq (len j) 1
    assert_eq (get (at j 0) "kind") "class"
    assert_eq (len (scan_any_file (tmp ++ "/logo.png"))) 0

test "scan_any_file handles go and pipe via private mirrors"
    tmp: "/tmp/repo-rag-test-mirror"
    make_dir tmp
    write_file (tmp ++ "/srv.go") "package main\n\nfunc (s *Server) Start() error {\n\treturn nil\n}\n\ntype Config struct{}\n"
    write_file (tmp ++ "/mod.pipe") "-- lib\n\nexport fn public_api\n    42\n\ntest basic\n    assert_eq 1 1\n"
    g: scan_any_file (tmp ++ "/srv.go")
    assert_eq (len g) 2
    assert_eq (get (at g 0) "kind") "func"
    assert_eq (get (at g 0) "symbol") "Start"
    assert_eq (get (at g 1) "kind") "type"
    p: scan_any_file (tmp ++ "/mod.pipe")
    assert_eq (len p) 2
    assert_eq (get (at p 0) "kind") "fn"
    assert_eq (get (at p 0) "symbol") "public_api"
    assert_eq (get (at p 1) "kind") "test"

--- === walk_tree tests ===

test "walk_tree skips junk and dotted directories"
    root: "/tmp/repo-rag-test-walk"
    exec ("rm -rf \"" ++ root ++ "\"")
    make_dir (root ++ "/src")
    make_dir (root ++ "/node_modules/pkg")
    make_dir (root ++ "/.hidden")
    make_dir (root ++ "/vendor")
    write_file (root ++ "/README.md") "docs"
    write_file (root ++ "/src/main.go") "package main\n"
    write_file (root ++ "/node_modules/pkg/index.js") "x"
    write_file (root ++ "/.hidden/secret.txt") "x"
    write_file (root ++ "/vendor/lib.rs") "x"
    files: walk_tree root
    assert_eq (len files) 2
    joined: join files "|"
    assert_contains joined "src/main.go"
    assert_contains joined "README.md"
    assert_eq (contains joined "node_modules") false
    assert_eq (contains joined "vendor") false
    assert_eq (contains joined "hidden") false

test "rel_path strips source prefix"
    assert_eq (rel_path "/r/src" "/r/src/pkg/a.go") "pkg/a.go"
    assert_eq (rel_path "/r/src" "/elsewhere/x.go") "/elsewhere/x.go"

print "=== repo-rag code-index tests complete ==="
