--- ============================================================
--- repo_bot.pipe — Slash-Commands in GitHub Issue-Kommentaren
--- Commands: /help, /search <query>, /read <path>, /grep <pattern>,
---   /issues, /ask <frage>
--- Env inputs: COMMENT_BODY, COMMENT_AUTHOR, ALLOWED_USERS,
---   ISSUE_NUMBER, REPO, GITHUB_TOKEN,
---   DEEPSEEK_API_KEY (optional, nur fuer /ask)
--- ============================================================

ai_provider "deepseek"
dk: env "DEEPSEEK_API_KEY"
if (len dk) > 0
    ai_set_key "deepseek" dk

body: trim (env "COMMENT_BODY")
author: env "COMMENT_AUTHOR"
allowed: env "ALLOWED_USERS"
issue: env "ISSUE_NUMBER"
repo: env "REPO"
token: env "GITHUB_TOKEN"

ok_user: contains ("," ++ allowed ++ ",") ("," ++ author ++ ",")
parts: split body " "
parts0: get parts 0
cmd: lower parts0

reply: ""
if ok_user == false
    reply: "⛔ Zugriff verweigert — `" ++ author ++ "` steht nicht in der Allowlist (`ALLOWED_USERS`)."
else if cmd == "/help"
    reply: "🤖 **Repo-Bot** — ich beantworte Slash-Commands in diesem Repository:\n"
    reply: reply ++ "`/help` — diese Hilfe\n"
    reply: reply ++ "`/search <query>` — GitHub-Code-Suche (Dateipfade)\n"
    reply: reply ++ "`/read <path>` — Dateiinhalt anzeigen (max. 4 KB)\n"
    reply: reply ++ "`/grep <pattern>` — Regex-Suche im lokalen Checkout\n"
    reply: reply ++ "`/issues` — offene Issues\n"
    reply: reply ++ "`/ask <frage>` — AI-Antwort mit Repo-Kontext"
else if cmd == "/search"
    if (len parts) < 2
        reply: "❓ Nutzung: `/search <query>`"
    else
        q: replace_all (trim (replace body parts0 "")) " " "+"
        surl: "https://api.github.com/search/code?q=" ++ q ++ "+repo:" ++ repo
        sh: {}
        set sh "Authorization" ("token " ++ token)
        set sh "Accept" "application/vnd.github+json"
        sr: http_request "GET" surl sh ""
        sd: parse_json (get sr "body")
        m1: get sd "message"
        if m1 != nil && (contains (to_str m1) "try again")
            exec "sleep 13"
            sr: http_request "GET" surl sh ""
            sd: parse_json (get sr "body")
        total: get sd "total_count"
        if total == nil
            reply: "⚠️ Suche fehlgeschlagen: " ++ (get sd "message")
        else if total == 0
            reply: "🔍 Keine Treffer für `" ++ (get parts 1) ++ "`."
        else
            items: get sd "items"
            paths: []
            for it in items
                push paths ("- `" ++ (get it "path") ++ "`")
            reply: "🔍 " ++ (to_str total) ++ " Treffer für `" ++ (get parts 1) ++ "` (Top " ++ (to_str (len paths)) ++ "):\n" ++ (join paths "\n")
else if cmd == "/read"
    if (len parts) < 2
        reply: "❓ Nutzung: `/read <path>`"
    else
        rp: get parts 1
        if contains rp ".."
            reply: "⛔ Pfad-Traversal nicht erlaubt."
        else
            rr: exec ("head -c 4000 " ++ rp)
            if (get rr "status") == 0
                reply: "📄 `" ++ rp ++ "`:\n```\n" ++ (get rr "output") ++ "\n```"
            else
                reply: "❌ Datei nicht lesbar: `" ++ rp ++ "`"
else if cmd == "/grep"
    if (len parts) < 2
        reply: "❓ Nutzung: `/grep <pattern>`"
    else
        gp: replace_all (get parts 1) "'" ""
        gr: exec ("git grep -n -i '" ++ gp ++ "' | head -c 3500")
        out: get gr "output"
        if (get gr "status") != 0 || (len out) == 0
            reply: "🔍 Keine Treffer für `" ++ (get parts 1) ++ "`."
        else
            reply: "🔍 `git grep -i '" ++ (get parts 1) ++ "'`:\n```\n" ++ out ++ "\n```"
else if cmd == "/issues"
    iurl: "https://api.github.com/repos/" ++ repo ++ "/issues?state=open&per_page=10"
    ih: {}
    set ih "Authorization" ("token " ++ token)
    set ih "Accept" "application/vnd.github+json"
    ir: http_request "GET" iurl ih ""
    ids: parse_json (get ir "body")
    lines: []
    for it in ids
        if (get it "pull_request") == nil
            push lines ("#" ++ (to_str (get it "number")) ++ " " ++ (get it "title"))
    if (len lines) == 0
        reply: "🎉 Keine offenen Issues."
    else
        reply: "📋 **Offene Issues:**\n" ++ (join lines "\n")
else if cmd == "/ask"
    q: trim (replace body parts0 "")
    if (len q) == 0
        reply: "❓ Nutzung: `/ask <frage>`"
    else if (len dk) == 0
        reply: "⚠️ `/ask` ist deaktiviert — es ist kein `DEEPSEEK_API_KEY`-Secret gesetzt."
    else
        words: split q " "
        pats: []
        npat: 0
        for w in words
            if npat < 3
                lw: lower w
                lw: replace_all lw "." ""
                lw: replace_all lw "?" ""
                lw: replace_all lw "!" ""
                lw: replace_all lw "," ""
                lw: replace_all lw ";" ""
                lw: replace_all lw ":" ""
                lw: replace_all lw "(" ""
                lw: replace_all lw ")" ""
                lw: replace_all lw "'" ""
                sw: contains ("," ++ "der,die,das,den,dem,des,und,oder,zu,mit,nach,aus,auf,um,in,bei,ein,eine,einer,einen,was,wie,ist,sind,sein,wird,werden,war,waren,hat,haben,hast,hatte,kann,kannst,koennen,konnte,soll,muss,muessen,machen,macht,macht,geben,gibt,es,sich,mein,dein,seine,ihre,fuer,für,ueber,über,von,vom,wo,wann,warum,welche,welcher,welches,dieser,diese,dieses,pipe,bitte,bzw,oder,aber,noch,nur,auch,schon,mehr,immer" ++ ",") ("," ++ lw ++ ",")
                if (len lw) > 2 && sw == false
                    push pats lw
                    npat: npat + 1
        pat: join pats "|"
        if (len pat) == 0
            pat: replace_all (lower (get words 0)) "'" ""
        cx: exec ("git grep -il -i -E '" ++ pat ++ "' | head -6")
        files: split (trim (get cx "output")) "\n"
        ctx: ""
        for f in files
            if (len ctx) < 7000 && (len f) > 0
                rr: exec ("git grep -n -i -A12 -B12 -E '" ++ pat ++ "' '" ++ f ++ "' | head -c 1500")
                ctx: ctx ++ "===== " ++ f ++ " =====\n" ++ (get rr "output") ++ "\n"
        sysp: "Du bist Repo-Bot fuer das Repository " ++ repo ++ ". Beantworte die Frage ausschliesslich anhand des mitgelieferten Kontexts. Antworte auf Deutsch, kompakt (max. 10 Zeilen). Nenne relevante Dateipfade im Format `pfad:zeile`, wenn erkennbar."
        a: ai_chat sysp ("Kontext:\n" ++ ctx ++ "\n\nFrage: " ++ q)
        reply: "🤖 **AI-Antwort** (Kontext: " ++ (to_str (len files)) ++ " Datei(en)):\n\n" ++ a
else
    reply: "🤖 Unbekannter Befehl `" ++ cmd ++ "`. `/help` zeigt alle Befehle."

--- Antwort als Kommentar posten
purl: "https://api.github.com/repos/" ++ repo ++ "/issues/" ++ issue ++ "/comments"
ph: {}
set ph "Authorization" ("token " ++ token)
set ph "Accept" "application/vnd.github+json"
pp: {body: reply}
pr: http_request "POST" purl ph (to_json pp)
if (get pr "status") != 201
    print "Posting fehlgeschlagen:"
    print (get pr "body")
else
    print "Antwort gepostet."
