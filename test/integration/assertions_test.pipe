test "basic arithmetic"
    assert_eq (2 + 2) 4
    assert_lt 3 5
    assert_gt 10 3
    assert_not_eq 5 6

test "string"
    assert_eq ("hello" ++ " world") "hello world"
    assert (len "hello") == 5

test "list"
    my_list: [1,2,3]
    assert_eq (len my_list) 3

test "floating point"
    assert_near 3.1415926 3.14159 0.00001

test "containment"
    assert_contains ([1, 2, 3]) 2
    assert_contains "hello world" "world"
    m: {name: "pipe"}
    assert_contains m "name"
