test "constant folding arithmetic"
    assert_eq (2 + 3 * 4) 14
    assert_eq ((2 + 3) * 4) 20
    assert_eq (10 - 2 - 3) 5
    assert_eq ((1 + 2) * (3 + 4)) 21

test "constant folding floats"
    assert_eq (1 + 2.5) 3.5
    assert_eq (7.5 - 7) 0.5
    assert_eq (2.5 * 4) 10.0

test "constant folding strings and booleans"
    assert_eq ("a" ++ "b" ++ "c") "abc"
    assert_eq (1 < 2 && 3 < 4) true
    assert_eq ("abc" < "abd") true
    assert_eq (10 >= 5 * 2) true
    assert_eq (5 * (2 + 2) == 20) true

test "constant folding prefix"
    assert_eq (-(2 + 3)) (-5)
    assert_eq (-(-5)) 5
    assert !0 == false
    assert !"" == false

test "division and modulo stay runtime"
    assert_eq (100 / (2 + 3)) 20
    assert_eq (7 % (2 + 1)) 1
