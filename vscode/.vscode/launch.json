{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pipe Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "pipe-lsp: build"
    }
  ]
}
