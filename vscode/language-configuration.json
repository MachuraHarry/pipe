{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|while|for|fn|match|try|catch|defer)\\b(?!.*\\b(else)\\b)",
    "decreaseIndentPattern": "^\\s*(else|else if|catch)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*--\\s*region",
      "end": "^\\s*--\\s*endregion"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
