{
  "name": "pipe-syntax",
  "displayName": "Pipe Language Support",
  "description": "Syntax highlighting & IntelliSense (LSP) for the Pipe scripting language (.pipe files)",
  "version": "1.3.0",
  "publisher": "pipe-lang",
  "license": "MIT",
  "icon": "icons/pipe-icon.png",
  "homepage": "https://github.com/MachuraHarry/pipe",
  "repository": {
    "type": "git",
    "url": "https://github.com/MachuraHarry/pipe.git"
  },
  "bugs": {
    "url": "https://github.com/MachuraHarry/pipe/issues"
  },
  "keywords": [
    "pipe",
    "pipeline",
    "spr",
    "semantic",
    "language",
    "lsp",
    "intellisense",
    "ai"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pipe"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pipe",
        "aliases": [
          "Pipe",
          "pipe"
        ],
        "extensions": [
          ".pipe"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pipe-icon.png",
          "dark": "./icons/pipe-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "pipe",
        "scopeName": "source.pipe",
        "path": "./syntaxes/pipe.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pipe",
        "path": "./snippets/pipe.json"
      }
    ],
    "configuration": {
      "title": "Pipe",
      "properties": {
        "pipe.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the pipe-lsp server binary. Leave empty to auto-detect (extension bin/, then <workspace>/bin/pipe-lsp, then PATH)."
        },
        "pipe.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to start the Pipe language server."
        },
        "pipe.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the pipe CLI binary (used by \"Run File\"/\"Open REPL\"). Leave empty to auto-detect (<workspace>/bin/pipe, then PATH)."
        }
      }
    },
    "commands": [
      {
        "command": "pipe.runFile",
        "title": "Pipe: Run File",
        "category": "Pipe"
      },
      {
        "command": "pipe.runFileVM",
        "title": "Pipe: Run File (VM Mode)",
        "category": "Pipe"
      },
      {
        "command": "pipe.openRepl",
        "title": "Pipe: Open REPL",
        "category": "Pipe"
      }
    ],
    "keybindings": [
      {
        "command": "pipe.runFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == pipe"
      }
    ]
  },
  "scripts": {
    "build:server": "go build -o bin/pipe-lsp ../cmd/pipe-lsp",
    "vscode:prepublish": "npm run compile && npm run build:server",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "vitest run"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
