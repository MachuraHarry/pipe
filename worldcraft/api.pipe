--! api.pipe — JSON layer for the Worldcraft HTTP server.
--! Converts engine state into structured maps and generates player-facing
--! choice options: deterministic ones from state, dialog choices via LLM.

import "state.pipe"
import "tools.pipe"
import "turns.pipe"

-- ---- State serialization ----

--! Full game-state map for API responses.
fn api_state _
    p: (get_player 0)
    if p == nil
        {error: {code: "no_player", message: "Kein Spiel gestartet"}}
    else
        rid: get p "room"
        room: get_room rid
        exits: []
        items: []
        if room != nil
            exits: keys (parse_json (get room "exits"))
            raw_items: parse_json (get room "items")
            pack: get_pack 0
            for it in raw_items
                desc: ""
                if pack != nil
                    def: find_pack_item pack it
                    if def != nil && get def "desc" != nil
                        desc: get def "desc"
                push items {id: it, name: it, desc: desc}
        npcs: []
        for nid in (npcs_in_room rid)
            npc_row: get_npc nid
            push npcs {id: nid, name: (get npc_row "name"), role: (get npc_row "role")}
        monsters: []
        for m in (monsters_in_room rid)
            push monsters {id: (get m "id"), name: (get m "name"), hp: (get m "hp"), max_hp: (get m "max_hp")}
        quests: []
        for q in (all_quests 0)
            push quests {id: (get q "id"), name: (get q "name"), state: (get q "state")}
        buffs_list: []
        for b in (all_buffs 0)
            push buffs_list {art: (get b "art"), wert: (get b "wert"), runden: (get b "runden")}
        spells_list: []
        for sp in (player_spells 0)
            push spells_list {id: (get sp "id"), name: (get sp "name"), typ: (get sp "typ"), manakosten: (get sp "manakosten"), schaden: (get sp "schaden")}
        xp_val: 0
        if get p "xp" != nil
            xp_val: get p "xp"
        won_flag: (get p "won") == 1
        rname: ""
        if room != nil
            rname_raw: get room "name"
            if rname_raw != nil && rname_raw != ""
                rname: rname_raw
            else
                rname: rid
        {world: (get_meta "world_name"), room: rid, room_name: rname, room_description: (look 0), exits: exits, items: items, npcs: npcs, monsters: monsters, hp: (get p "hp"), max_hp: (get p "max_hp"), gold: (get p "gold"), mana: (get p "mana"), max_mana: (get p "max_mana"), xp: xp_val, level: (player_level 0), inventory: parse_json (get p "inventory"), quests: quests, spells: spells_list, buffs: buffs_list, won: won_flag}

-- ---- Option generation ----

--! Deterministic options from current state (fast-path compatible).
fn build_options _
    p: (get_player 0)
    opts: []
    if p != nil
        rid: get p "room"
        room: get_room rid
        if room != nil
            exits: parse_json (get room "exits")
            for k in keys exits
                push opts ("geh nach " ++ k)
            for it in (parse_json (get room "items"))
                push opts ("nimm " ++ it)
            for nid in (npcs_in_room rid)
                npc_row: get_npc nid
                rolle: get npc_row "role"
                push opts ("rede mit " ++ nid)
                if rolle == "haendler"
                    push opts ("kauf ...")
                    push opts ("verkauf ...")
            for m in (monsters_in_room rid)
                push opts ("greife " ++ (get m "id") ++ " an")
                --! Add spell options for monsters
                sp_list: player_spells 0
                for sp in sp_list
                    if (get sp "typ") == "angriff"
                        push opts ("zauber " ++ (get sp "id") ++ " auf " ++ (get m "id"))
                push opts ("wehre dich")
            --! Show usable items in inventory (data-driven via pack)
            inv: parse_json (get p "inventory")
            pack: get_pack 0
            for it in inv
                if pack != nil
                    def: find_pack_item pack it
                    if item_usable def
                        push opts ("benutze " ++ it)
            --! Show spell list option if player knows spells
            if len (player_spells 0) > 0
                push opts ("magie")
        push opts ("inventar")
        push opts ("quests")
        opts
    else
        opts

-- ---- Dialog choices ----

--! Objective-aware deterministic dialog choices used when AI is unavailable.
--! Surfaces the concrete next step of the open quest instead of a static trio.
fn dialog_choice_fallback npc_id
    opts: []
    obj: next_open_objective 0
    if obj != nil
        ziel: get obj "target"
        wem: get obj "npc"
        if (get obj "kind") == "give"
            if wem == npc_id
                if player_carries ziel
                    push opts ("gib " ++ wem ++ " " ++ ziel)
            else
                push opts ("rede mit " ++ wem)
        if (get obj "kind") == "kill" || (get obj "kind") == "fetch"
            push opts ("inventar")
    push opts ("frag " ++ npc_id ++ " nach hinweisen")
    push opts ("quests")
    push opts ("geh weiter")
    opts

--! Asks the model for 3 short follow-up commands after an NPC exchange.
--! Falls back to objective-driven choices when AI is unavailable.
fn gen_dialog_choices npc_id reply
    fallback: (dialog_choice_fallback npc_id)
    try
        roh: ai_chat_json "Du assistierst einem Textadventure-Spieler. Antworte nur als JSON." ("NPC-Antwort war: \"" ++ reply ++ "\"\nSchlage 3 kurze nächste Spieler-Befehle auf Deutsch an (je 2-4 Wörter, imperative Kurzform wie im Spiel). JSON: {choices: [str, str, str]}") 300
        choices: or_default_list (get roh "choices")
        if len choices >= 1
            choices
        else
            fallback
    catch
        fallback

--! Builds a dialog envelope from the last captured exchange (nil if none).
fn api_dialog _
    d: take_last_dialog 0
    if d == nil
        nil
    else
        {speaker: (get d "name"), npc: (get d "npc"), player_line: (get d "player"), reply: (get d "reply"), choices: (gen_dialog_choices (get d "npc") (get d "reply"))}

-- ---- Turn envelope ----

--! Processes one input and wraps everything into the API response map.
fn api_turn inp
    erg: process_turn inp
    antwort: {narration: (get erg "narration"), type: (get erg "type"), dialog: (api_dialog 0), state: (api_state 0), options: (build_options 0)}
    if (get erg "error") != ""
        set antwort "error" {code: "ai_unavailable", message: (get erg "error")}
    antwort

--! Intro payload right after session boot.
fn api_intro _
    {narration: (look 0), dialog: nil, state: (api_state 0), options: (build_options 0)}

-- ---- JSON response helper ----

--! CORS + JSON headers (keys with dashes need set, not literals).
JSON_HEADERS: {}
set JSON_HEADERS "Content-Type" "application/json"
set JSON_HEADERS "Access-Control-Allow-Origin" "*"
set JSON_HEADERS "Access-Control-Allow-Headers" "Authorization, Content-Type"
set JSON_HEADERS "Access-Control-Allow-Methods" "GET, POST, DELETE, OPTIONS"

--! JSON response with CORS headers.
fn json_res status body_map
    {status: status, headers: JSON_HEADERS, body: to_json body_map}

--! Standard error envelope.
fn json_err status code message
    json_res status {error: {code: code, message: message}}
