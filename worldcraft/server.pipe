--! server.pipe — Worldcraft supervisor: one OS process per game session.
--! Run from the worldcraft/ directory:   ../bin/pipe server.pipe
--! Optional auth:  export WORLDCRAFT_TOKEN="..."
--!
--! POST /api/v1/sessions        {world} | {world, briefing, profil}
--! GET  /api/v1/worlds
--! *    /api/v1/sessions/{id}/...      → proxied to the session worker
--! DELETE /api/v1/sessions/{id}        → shutdown + cleanup

import "state.pipe"

KEIN_H: {}

HTTP_PORT: "8080"
PORT_BASE: 8100
PORT_COUNTER: [0]
SESSIONS: {}
SESSION_COUNTER: [0]

-- ---- Helpers ----

fn env_or key default
    v: env key
    if v == nil || v == ""
        default
    else
        v

fn json_headers_extra h
    set h "Access-Control-Allow-Origin" "*"
    set h "Access-Control-Allow-Headers" "Authorization, Content-Type"
    set h "Access-Control-Allow-Methods" "GET, POST, DELETE, OPTIONS"
    h

JSONH: {}
set JSONH "Content-Type" "application/json"
set JSONH "Access-Control-Allow-Origin" "*"
set JSONH "Access-Control-Allow-Headers" "Authorization, Content-Type"
set JSONH "Access-Control-Allow-Methods" "GET, POST, DELETE, OPTIONS"

fn jres status body
    {status: status, headers: JSONH, body: to_json body}

fn jerr status code message
    jres status {error: {code: code, message: message}}

fn authorized req
    token: env_or "WORLDCRAFT_TOKEN" ""
    if token == ""
        true
    else
        headers: get req "headers"
        if headers == nil
            false
        else
            auth: get headers "Authorization"
            if auth == nil
                false
            else
                auth == ("Bearer " ++ token)

fn next_port _
    set PORT_COUNTER 0 ((at PORT_COUNTER 0) + 1)
    to_str (PORT_BASE + (at PORT_COUNTER 0))

fn new_session_id _
    set SESSION_COUNTER 0 ((at SESSION_COUNTER 0) + 1)
    "s" ++ (to_str (now)) ++ "_" ++ (to_str (at SESSION_COUNTER 0))

--! Registers a session in the in-memory registry.
fn register_session sid world port handle
    set SESSIONS sid {id: sid, world: world, port: port, proc: handle}

fn get_session sid
    get SESSIONS sid

fn drop_session sid
    -- maps have no delete; keep a tombstone so lookups fail cleanly.
    set SESSIONS sid nil

--! Waits until the worker's /health answers (max ~15 s). Network errors
--! count as "not healthy yet", never as crashes.
fn wait_healthy port
    ok: false
    i: 0
    while i < 30 && !ok
        sleep 500
        try
            r: http_get ("http://localhost:" ++ port ++ "/health")
            if (get r "status") == 200
                ok: true
        catch
            print ("  (warte auf Worker an :" ++ port ++ ")")
        i: i + 1
    ok

-- ---- Session creation ----

fn create_session body_raw
    cfg: parse_json body_raw
    if cfg == nil
        jerr 400 "bad_json" "Body muss JSON sein"
    else
        weltname: get cfg "world"
        briefing: get cfg "briefing"
        if (weltname == nil || weltname == "") && (briefing == nil || briefing == "")
            jerr 400 "missing_world" "'world' oder 'briefing' angeben"
        else
            sid: new_session_id 0
            if weltname == nil || weltname == ""
                weltname: sid
            port: next_port 0
            -- Config für den Worker schreiben (Welt oder Briefing + Profil).
            if !file_exists ".sessions"
                make_dir ".sessions"
            write_file (".sessions/" ++ sid ++ ".config.json") (to_json cfg)
            cmd: "../bin/pipe worldd.pipe " ++ sid ++ " " ++ port
            handle: proc_start cmd
            if wait_healthy port
                register_session sid weltname port handle
                health: http_get ("http://localhost:" ++ port ++ "/health")
                hbody: parse_json (get health "body")
                bereit: get hbody "ready"
                holder: [nil, nil]
                if bereit == true
                    intro: http_get ("http://localhost:" ++ port ++ "/state")
                    state_map: parse_json (get intro "body")
                    if state_map != nil
                        set holder 0 (get state_map "state")
                        set holder 1 (get state_map "options")
                jres 201 {session_id: sid, world: weltname, ready: (bereit == true), state: (at holder 0), options: (at holder 1)}
            else
                drop_session sid
                jerr 502 "worker_start_failed" ("Worker auf Port " ++ port ++ " nicht gesund geworden")

-- ---- Proxying ----

fn proxy sess suffix method body_raw
    url: "http://localhost:" ++ (get sess "port") ++ suffix
    r: http_request method url KEIN_H body_raw
    {status: (get r "status"), body: (get r "body")}

fn proxy_session sid suffix method body_raw
    sess: get_session sid
    if sess == nil || (get sess "port") == nil
        jerr 404 "unknown_session" ("Keine Session: " ++ sid)
    else
        antwort: nil
        fehler: ""
        try
            antwort: proxy sess suffix method body_raw
        catch e
            fehler: e
        if fehler != ""
            jerr 502 "worker_unreachable" ("Session-Prozess antwortet nicht: " ++ fehler)
        else
            status: get antwort "status"
            if status == nil || status == 0
                jerr 502 "worker_unreachable" "Session-Prozess antwortet nicht"
            else
                {status: status, headers: JSONH, body: (get antwort "body")}

-- ---- Routing ----

fn route req
    method: get req "method"
    path: get req "path"
    body: get req "body"
    if method == "OPTIONS"
        jres 200 {}
    else
        if !authorized req
            jerr 401 "unauthorized" "Fehlender oder falscher Bearer-Token"
        else
            if path == "/api/v1/worlds" && method == "GET"
                welten: []
                for f in (list_dir "worlds")
                    if contains f ".json"
                        push welten (replace f ".json" "")
                jres 200 {worlds: welten}
            else
                if path == "/api/v1/sessions" && method == "POST"
                    create_session body
                else
                    teile: split path "/"
                    -- /api/v1/sessions/<id>[/<suffix>]
                    if len teile >= 5 && (at teile 1) == "api" && (at teile 2) == "v1" && (at teile 3) == "sessions"
                        sid: at teile 4
                        rest: ""
                        i: 5
                        while i < len teile
                            rest: rest ++ "/" ++ (at teile i)
                            i: i + 1
                        if rest == "" && method == "DELETE"
                            sess: get_session sid
                            if sess == nil
                                jerr 404 "unknown_session" ("Keine Session: " ++ sid)
                            else
                                proxy sess "/shutdown" "POST" ""
                                drop_session sid
                                jres 200 {status: "terminated", session_id: sid}
                        else
                            if rest == "" && method == "GET"
                                proxy_session sid "/health" "GET" ""
                            else
                                if rest != ""
                                    m: method
                                    if m != "GET" && m != "POST" && m != "DELETE"
                                        m: "GET"
                                    proxy_session sid rest m body
                                else
                                    jerr 400 "bad_request" "Unvollständiger Pfad"
                    else
                        jerr 404 "not_found" ("Unbekannter Pfad: " ++ path)

--! Last line of defence: a handler crash must never kill the supervisor.
fn route_safe req
    try
        route req
    catch e
        jerr 500 "internal" ("Interner Fehler: " ++ e)

-- ---- Main ----

if !file_exists "worlds"
    make_dir "worlds"
print ("Worldcraft Server — http://localhost:" ++ HTTP_PORT)
token: env_or "WORLDCRAFT_TOKEN" ""
if token != ""
    print "Auth: Bearer-Token aktiv."
print "Beenden mit Ctrl+C."
srv: http_server ("0.0.0.0:" ++ HTTP_PORT) route_safe
while true
    sleep 1000
