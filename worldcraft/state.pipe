--! state.pipe — sqlite-backed game state for "Worldcraft"
--! All game truth lives in the DB. Unlike adventure/state.pipe nothing is
--! hardcoded: the whole world (rooms, NPC placement, monsters, quests,
--! objectives, mechanics) is seeded at runtime from a world document.

import "sqlite"

-- Mutable module state wrapped in a list (lists are mutable via set).
DBH: [nil]

--! Opens an in-memory database once and returns the handle.
fn open_db _
    if (at DBH 0) == nil
        set DBH 0 (db_open ":memory:")
    at DBH 0

--! Makes a string safe for Pipes mini-SQL parser: the tokenizer does not
--! support ''-escaping, so apostrophes become typographic quotes.
fn sql_escape s
    replace s "'" "’"

--! Creates all tables if they do not exist.
fn init_db _
    h: (open_db 0)
    db_exec h "CREATE TABLE IF NOT EXISTS meta (mkey TEXT PRIMARY KEY, mval TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS player (id INTEGER PRIMARY KEY, room TEXT, hp INTEGER, max_hp INTEGER, gold INTEGER, mana INTEGER, max_mana INTEGER, xp INTEGER, inventory TEXT, won INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS rooms (id TEXT PRIMARY KEY, description TEXT, items TEXT, exits TEXT, name TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS npcs (id TEXT PRIMARY KEY, name TEXT, role TEXT, temperament TEXT, buys_pct INTEGER, sells_pct INTEGER, persona TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS npc_placement (npc TEXT PRIMARY KEY, room TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS npc_memory (npc TEXT PRIMARY KEY, summary TEXT, turns INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS flavor (room TEXT PRIMARY KEY, body TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS monsters (id TEXT PRIMARY KEY, name TEXT, room TEXT, hp INTEGER, max_hp INTEGER, defense INTEGER, loot TEXT, defeated INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS quests (id TEXT PRIMARY KEY, name TEXT, description TEXT, state TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS objectives (id TEXT PRIMARY KEY, kind TEXT, target TEXT, npc TEXT, state TEXT, quest TEXT, main INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS reputation (fraktion TEXT PRIMARY KEY, punkte INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS buffs (spieler INTEGER, art TEXT, wert INTEGER, runden INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS spells (id TEXT PRIMARY KEY, name TEXT, typ TEXT, manakosten INTEGER, schaden INTEGER, effekt TEXT, beschreibung TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS player_spells (spieler INTEGER, spell_id TEXT)"
    db_exec h "CREATE TABLE IF NOT EXISTS monster_abilities (monster TEXT, ability TEXT, effekt TEXT, wert INTEGER, runden INTEGER, chance INTEGER)"
    db_exec h "CREATE TABLE IF NOT EXISTS custom_items (id TEXT PRIMARY KEY, name TEXT, type TEXT, value INTEGER, tags TEXT, desc TEXT, damage_bonus INTEGER, ranged INTEGER, use_effect TEXT, use_value INTEGER, buff_stat TEXT, buff_value INTEGER, buff_rounds INTEGER, clear_stat TEXT, use_text INTEGER)"
    -- Migration: add 'name' column to rooms if missing
    try
        db_exec h "ALTER TABLE rooms ADD COLUMN name TEXT"
    catch
        nil

--! Deletes all rows (fresh game / test isolation).
fn reset_state _
    h: (open_db 0)
    for t in ["meta", "player", "rooms", "npcs", "npc_placement", "npc_memory", "flavor", "monsters", "quests", "objectives", "reputation", "buffs", "spells", "player_spells", "monster_abilities", "custom_items"]
        db_exec h ("DELETE FROM " ++ t)

--! Reads a meta value (empty string if unknown).
fn get_meta key
    rows: db_query (open_db 0) ("SELECT mval FROM meta WHERE mkey = '" ++ (sql_escape key) ++ "'")
    if len rows > 0
        get (at rows 0) "mval"
    else
        ""

--! Writes a meta value.
fn set_meta key value
    h: (open_db 0)
    esc: sql_escape value
    rows: db_query h ("SELECT mkey FROM meta WHERE mkey = '" ++ (sql_escape key) ++ "'")
    if len rows > 0
        db_exec h ("UPDATE meta SET mval = '" ++ esc ++ "' WHERE mkey = '" ++ (sql_escape key) ++ "'")
    else
        db_exec h ("INSERT INTO meta (mkey, mval) VALUES ('" ++ (sql_escape key) ++ "', '" ++ esc ++ "')")

--! Joins a list of strings with a separator.
fn join_list lst sep
    out: ""
    n: 0
    for item in lst
        if n > 0
            out: out ++ sep
        out: out ++ item
        n: n + 1
    out

--! Normalizes a name into a safe file slug (shared by save/load).
fn safe_name name
    join_list (split (replace name " " "_") "/") "_"

--! Seeds one room row from a room map {description, items, exits}.
fn seed_room_row id r
    h: (open_db 0)
    n: db_query h ("SELECT id FROM rooms WHERE id = '" ++ (sql_escape id) ++ "'")
    rname: or_default_str (get r "name")
    sql: "INSERT INTO rooms VALUES ('" ++ (sql_escape id) ++ "', '" ++ (sql_escape (get r "description")) ++ "', '" ++ (sql_escape (to_json (get r "items"))) ++ "', '" ++ (sql_escape (to_json (get r "exits"))) ++ "', '" ++ (sql_escape rname) ++ "')"
    if len n > 0
        sql: "UPDATE rooms SET description = '" ++ (sql_escape (get r "description")) ++ "', items = '" ++ (sql_escape (to_json (get r "items"))) ++ "', exits = '" ++ (sql_escape (to_json (get r "exits"))) ++ "', name = '" ++ (sql_escape rname) ++ "' WHERE id = '" ++ (sql_escape id) ++ "'"
    db_exec h sql

--! Seeds one npc row (map incl. room placement).
fn seed_npc_row npc
    h: (open_db 0)
    db_exec h ("INSERT INTO npcs VALUES ('" ++ (sql_escape (get npc "id")) ++ "', '" ++ (sql_escape (get npc "name")) ++ "', '" ++ (sql_escape (get npc "role")) ++ "', '" ++ (sql_escape (get npc "temperament")) ++ "', " ++ (to_str (get npc "buys_pct")) ++ ", " ++ (to_str (get npc "sells_pct")) ++ ", '" ++ (sql_escape (get npc "persona")) ++ "')")
    db_exec h ("INSERT INTO npc_placement VALUES ('" ++ (sql_escape (get npc "id")) ++ "', '" ++ (sql_escape (get npc "room")) ++ "')")

--! Seeds one monster row (stats expected final, e.g. from pack normalization).
fn seed_monster_row mon
    h: (open_db 0)
    db_exec h ("INSERT INTO monsters VALUES ('" ++ (sql_escape (get mon "id")) ++ "', '" ++ (sql_escape (get mon "name")) ++ "', '" ++ (sql_escape (get mon "room")) ++ "', " ++ (to_str (get mon "hp")) ++ ", " ++ (to_str (get mon "max_hp")) ++ ", " ++ (to_str (get mon "defense")) ++ ", '" ++ (sql_escape (get mon "loot")) ++ "', 0)")

--! Seeds one quest row.
fn seed_quest_row qst
    db_exec (open_db 0) ("INSERT INTO quests VALUES ('" ++ (sql_escape (get qst "id")) ++ "', '" ++ (sql_escape (get qst "name")) ++ "', '" ++ (sql_escape (get qst "description")) ++ "', '" ++ (sql_escape (get qst "state")) ++ "')")

--! Seeds one objective row (quest coupling optional for old worlds).
fn seed_objective_row obj
    quest: or_default_str (get obj "quest")
    main: 1
    if (get obj "main") == 0
        main: 0
    db_exec (open_db 0) ("INSERT INTO objectives VALUES ('" ++ (sql_escape (get obj "id")) ++ "', '" ++ (sql_escape (get obj "kind")) ++ "', '" ++ (sql_escape (get obj "target")) ++ "', '" ++ (sql_escape (get obj "npc")) ++ "', '" ++ (sql_escape (get obj "state")) ++ "', '" ++ (sql_escape quest) ++ "', " ++ (to_str main) ++ ")")

--! Returns v, or an empty string when nil.
fn or_default_str v
    if v == nil
        ""
    else
        v

--! Seeds the whole world from a world document map:
--! {name, start_room, rooms:{id:{description,items,exits}},
--!  npcs:[{id,name,role,temperament,buys_pct,sells_pct,persona,room}],
--!  monsters:[{id,name,room,hp,max_hp,defense,loot}],
--!  quests:[{id,name,description,state}],
--!  objectives:[{id,kind,target,npc,state}],
--!  factions:[[id,punkte]],
--!  mechanics:{start_hp,start_gold,respawn_hp},
--!  lore:[strings]}
fn seed_world doc
    h: (open_db 0)
    set_meta "world_name" (get doc "name")
    set_meta "start_room" (get doc "start_room")
    thema: or_default_str (get doc "thema")
    if thema != ""
        set_meta "theme" thema
    ton: or_default_str (get doc "ton")
    if ton != ""
        set_meta "ton" ton
    m: get doc "mechanics"
    if m == nil
        m: {start_hp: 10, start_gold: 20, respawn_hp: 10}
    --! Persist the full mechanics map so pack-tuned mana/attack/heal values
    --! are honored by new_game / respawn_player / attack_enemy / use_item.
    set_meta "mechanics" (to_json m)
    set_meta "start_hp" (to_str (get m "start_hp"))
    set_meta "start_gold" (to_str (get m "start_gold"))
    set_meta "respawn_hp" (to_str (get m "respawn_hp"))
    set_meta "start_items" (to_json (or_default_list (get m "start_items")))
    profil: get doc "profil"
    if profil == nil
        profil: {stil: "normal", schwierigkeit: "normal"}
    set_meta "profil_stil" (get profil "stil")
    set_meta "profil_schwierigkeit" (get profil "schwierigkeit")
    rooms: get doc "rooms"
    for id in keys rooms
        seed_room_row id (get rooms id)
    for npc in (get doc "npcs")
        seed_npc_row npc
    for mon in (get doc "monsters")
        seed_monster_row mon
    for qst in (get doc "quests")
        seed_quest_row qst
    for obj in (get doc "objectives")
        seed_objective_row obj
    for frak in (get doc "factions")
        rep: 0
        if len frak > 1
            rep: (at frak 1)
        db_exec h ("INSERT INTO reputation VALUES ('" ++ (sql_escape (at frak 0)) ++ "', " ++ (to_str rep) ++ ")")
    --! Seed custom items if present in world doc
    custom_items_raw: or_default_list (get doc "custom_items")
    if len custom_items_raw > 0
        seed_custom_items custom_items_raw

--! Seeds spells and monster abilities from the resource pack.
fn seed_pack_extras pack
    h: (open_db 0)
    spells: or_default_list (get pack "spells")
    for sp in spells
        db_exec h ("INSERT INTO spells VALUES ('" ++ (sql_escape (get sp "id")) ++ "', '" ++ (sql_escape (get sp "name")) ++ "', '" ++ (sql_escape (get sp "typ")) ++ "', " ++ (to_str (get sp "manakosten")) ++ ", " ++ (to_str (get sp "schaden")) ++ ", '" ++ (sql_escape (or_default_str (get sp "effekt"))) ++ "', '" ++ (sql_escape (get sp "beschreibung")) ++ "')")
    mon_abs: or_default_list (get pack "monster_abilities")
    for ma in mon_abs
        db_exec h ("INSERT INTO monster_abilities VALUES ('" ++ (sql_escape (get ma "monster")) ++ "', '" ++ (sql_escape (get ma "ability")) ++ "', '" ++ (sql_escape (or_default_str (get ma "effekt"))) ++ "', " ++ (to_str (get ma "wert")) ++ ", " ++ (to_str (get ma "runden")) ++ ", " ++ (to_str (get ma "chance")) ++ ")")

-- ---- Custom items (AI-generated, stored in world doc + DB) ----

--! Seeds custom items from a list into the custom_items table.
fn seed_custom_items items
    h: (open_db 0)
    for it in items
        tags_str: or_default_str (to_json (get it "tags"))
        dmg: 0
        if get it "damage_bonus" != nil
            dmg: get it "damage_bonus"
        ranged: 0
        if (get it "ranged") == true
            ranged: 1
        uv: 0
        if get it "use_value" != nil
            uv: get it "use_value"
        bv: 0
        if get it "buff_value" != nil
            bv: get it "buff_value"
        br: 0
        if get it "buff_rounds" != nil
            br: get it "buff_rounds"
        ut: 0
        if (get it "use_text") == true
            ut: 1
        db_exec h ("INSERT INTO custom_items VALUES ('" ++ (sql_escape (get it "id")) ++ "', '" ++ (sql_escape (or_default_str (get it "name"))) ++ "', '" ++ (sql_escape (or_default_str (get it "type"))) ++ "', " ++ (to_str (or_default_val (get it "value") 0)) ++ ", '" ++ (sql_escape tags_str) ++ "', '" ++ (sql_escape (or_default_str (get it "desc"))) ++ "', " ++ (to_str dmg) ++ ", " ++ (to_str ranged) ++ ", '" ++ (sql_escape (or_default_str (get it "use_effect"))) ++ "', " ++ (to_str uv) ++ ", '" ++ (sql_escape (or_default_str (get it "buff_stat"))) ++ "', " ++ (to_str bv) ++ ", " ++ (to_str br) ++ ", '" ++ (sql_escape (or_default_str (get it "clear_stat"))) ++ "', " ++ (to_str ut) ++ ")")

--! Returns a custom item row as map (nil if unknown or table missing).
fn find_custom_item item_id
    try
        rows: db_query (open_db 0) ("SELECT * FROM custom_items WHERE id = '" ++ (sql_escape item_id) ++ "'")
        if len rows > 0
            r: at rows 0
            -- Reconstruct as map matching pack item format
            ut: get r "use_text"
            use_text_flag: false
            if ut != nil && ut == 1
                use_text_flag: true
            ranged_flag: false
            if (get r "ranged") == 1
                ranged_flag: true
            {id: (get r "id"), name: (get r "name"), type: (get r "type"), value: (get r "value"), tags: (parse_json (get r "tags")), desc: (get r "desc"), damage_bonus: (get r "damage_bonus"), ranged: ranged_flag, use_effect: (get r "use_effect"), use_value: (get r "use_value"), buff_stat: (get r "buff_stat"), buff_value: (get r "buff_value"), buff_rounds: (get r "buff_rounds"), clear_stat: (get r "clear_stat"), use_text: use_text_flag}
        else
            nil
    catch
        nil

--! Returns v when it is a non-nil value, else the default.
fn or_default_val v def
    if v == nil
        def
    else
        v

--! Returns v when it is a non-nil list, else an empty list.
fn or_default_list v
    if v == nil
        []
    else
        v

--! Starts a new game in the seeded world (incl. profile start items).
fn new_game _
    h: (open_db 0)
    db_exec h "DELETE FROM player"
    start_mana: 8
    max_mana_val: 15
    m_raw: get_meta "mechanics"
    if m_raw != ""
        m: parse_json m_raw
        if get m "start_mana" != nil
            start_mana: get m "start_mana"
        if get m "max_mana" != nil
            max_mana_val: get m "max_mana"
    db_exec h ("INSERT INTO player VALUES (1, '" ++ (sql_escape (get_meta "start_room")) ++ "', " ++ (get_meta "start_hp") ++ ", " ++ (get_meta "start_hp") ++ ", " ++ (get_meta "start_gold") ++ ", " ++ (to_str start_mana) ++ ", " ++ (to_str max_mana_val) ++ ", 0, '[]', 0)")
    for it in (parse_json (get_meta "start_items"))
        inventory_add it

--! Returns the player row map or nil.
fn get_player _
    rows: db_query (open_db 0) "SELECT * FROM player WHERE id = 1"
    if len rows > 0
        at rows 0
    else
        nil

--! Returns a room row map or nil.
fn get_room room_id
    rows: db_query (open_db 0) ("SELECT * FROM rooms WHERE id = '" ++ (sql_escape room_id) ++ "'")
    if len rows > 0
        at rows 0
    else
        nil

--! Moves the player to another room.
fn set_player_room room_id
    db_exec (open_db 0) ("UPDATE player SET room = '" ++ (sql_escape room_id) ++ "' WHERE id = 1")

--! Adds an item to the player's inventory.
fn inventory_add item_name
    p: (get_player 0)
    inv: parse_json (get p "inventory")
    push inv item_name
    db_exec (open_db 0) ("UPDATE player SET inventory = '" ++ (sql_escape (to_json inv)) ++ "' WHERE id = 1")

--! Removes an item from the player's inventory.
fn inventory_remove item_name
    p: (get_player 0)
    old: parse_json (get p "inventory")
    neu: []
    for it in old
        if it != item_name
            push neu it
    db_exec (open_db 0) ("UPDATE player SET inventory = '" ++ (sql_escape (to_json neu)) ++ "' WHERE id = 1")

--! True when the player carries the given item.
fn inventory_has item_name
    p: (get_player 0)
    contains (parse_json (get p "inventory")) item_name

--! Removes an item from a room and returns true on success.
fn room_take_item room_id item_name
    room: get_room room_id
    if room == nil
        false
    else
        items: parse_json (get room "items")
        if contains items item_name
            rest: []
            for it in items
                if it != item_name
                    push rest it
            db_exec (open_db 0) ("UPDATE rooms SET items = '" ++ (sql_escape (to_json rest)) ++ "' WHERE id = '" ++ (sql_escape room_id) ++ "'")
            true
        else
            false

--! Places an item into a room (used by loot drops).
fn room_add_item room_id item_name
    room: get_room room_id
    if room != nil
        items: parse_json (get room "items")
        push items item_name
        db_exec (open_db 0) ("UPDATE rooms SET items = '" ++ (sql_escape (to_json items)) ++ "' WHERE id = '" ++ (sql_escape room_id) ++ "'")

-- ---- NPCs ----

--! Returns the npc row map or nil.
fn get_npc npc_id
    rows: db_query (open_db 0) ("SELECT * FROM npcs WHERE id = '" ++ (sql_escape npc_id) ++ "'")
    if len rows > 0
        at rows 0
    else
        nil

--! Room where an NPC stands (empty string if unknown).
fn get_npc_room npc_id
    rows: db_query (open_db 0) ("SELECT room FROM npc_placement WHERE npc = '" ++ (sql_escape npc_id) ++ "'")
    if len rows > 0
        get (at rows 0) "room"
    else
        ""

--! All NPC ids standing in a room.
fn npcs_in_room room_id
    rows: db_query (open_db 0) ("SELECT npc FROM npc_placement WHERE room = '" ++ (sql_escape room_id) ++ "'")
    out: []
    for row in rows
        push out (get row "npc")
    out

--! Returns the stored memory summary of an NPC (empty string if unknown).
fn get_npc_memory npc
    rows: db_query (open_db 0) ("SELECT summary FROM npc_memory WHERE npc = '" ++ (sql_escape npc) ++ "'")
    if len rows > 0
        get (at rows 0) "summary"
    else
        ""

--! Number of dialogue exchanges with an NPC so far.
fn npc_turns npc
    rows: db_query (open_db 0) ("SELECT turns FROM npc_memory WHERE npc = '" ++ (sql_escape npc) ++ "'")
    if len rows > 0
        get (at rows 0) "turns"
    else
        0

--! Overwrites (not appends) the compressed NPC memory; bumps the turn counter.
fn set_npc_memory npc summary
    h: (open_db 0)
    rows: db_query h ("SELECT turns FROM npc_memory WHERE npc = '" ++ (sql_escape npc) ++ "'")
    esc: sql_escape summary
    if len rows > 0
        db_exec h ("UPDATE npc_memory SET summary = '" ++ esc ++ "', turns = turns + 1 WHERE npc = '" ++ (sql_escape npc) ++ "'")
    else
        db_exec h ("INSERT INTO npc_memory VALUES ('" ++ (sql_escape npc) ++ "', '" ++ esc ++ "', 1)")

-- ---- Objectives / win condition (data-driven) ----

--! Marks the game as won.
fn set_won _
    db_exec (open_db 0) "UPDATE player SET won = 1 WHERE id = 1"

--! Marks one objective as done; closes its coupled quest and, when all
--! main objectives are done, wins the game. Side objectives (main=0) never
--! block the win -- they only close their own quest.
fn objective_complete obj_id
    h: (open_db 0)
    rows: db_query h ("SELECT quest FROM objectives WHERE id = '" ++ (sql_escape obj_id) ++ "'")
    if len rows > 0
        qid: get (at rows 0) "quest"
        if qid != "" && qid != nil
            quest_set qid "erledigt"
    db_exec h ("UPDATE objectives SET state = 'erledigt' WHERE id = '" ++ (sql_escape obj_id) ++ "'")
    offen: db_query h "SELECT COUNT(*) AS n FROM objectives WHERE state != 'erledigt' AND main = 1"
    alle: (get (at offen 0) "n") == 0
    if alle
        set_won 0
    alle

--! Clears the won flag so a new adventure can begin.
fn reset_won _
    db_exec (open_db 0) "UPDATE player SET won = 0 WHERE id = 1"

--! Checks give-objectives after handing target to npc; completes matching ones.
fn check_give_objective target npc
    h: (open_db 0)
    rows: db_query h ("SELECT id FROM objectives WHERE kind = 'give' AND target = '" ++ (sql_escape target) ++ "' AND npc = '" ++ (sql_escape npc) ++ "' AND state != 'erledigt'")
    won: false
    for row in rows
        if objective_complete (get row "id")
            won: true
    won

--! Checks kill-objectives after a monster fell; matches on monster loot tag
--! fallback: any kill objective whose target equals the monster id or its loot.
fn check_kill_objective monster_id loot
    h: (open_db 0)
    rows: db_query h ("SELECT id FROM objectives WHERE kind = 'kill' AND state != 'erledigt' AND (target = '" ++ (sql_escape monster_id) ++ "' OR target = '" ++ (sql_escape loot) ++ "')")
    won: false
    for row in rows
        if objective_complete (get row "id")
            won: true
    won

--! Checks explore-objectives after entering a room.
fn check_explore_objective room_id
    h: (open_db 0)
    rows: db_query h ("SELECT id FROM objectives WHERE kind = 'explore' AND state != 'erledigt' AND target = '" ++ (sql_escape room_id) ++ "'")
    won: false
    for row in rows
        if objective_complete (get row "id")
            won: true
    won

--! Checks fetch-objectives after picking up an item; completes matching ones.
fn check_fetch_objective item_name
    h: (open_db 0)
    rows: db_query h ("SELECT id FROM objectives WHERE kind = 'fetch' AND target = '" ++ (sql_escape item_name) ++ "' AND state != 'erledigt'")
    won: false
    for row in rows
        if objective_complete (get row "id")
            won: true
    won

-- ---- Quests & reputation ----

--! Returns the quest row map or nil.
fn get_quest quest_id
    rows: db_query (open_db 0) ("SELECT * FROM quests WHERE id = '" ++ (sql_escape quest_id) ++ "'")
    if len rows > 0
        at rows 0
    else
        nil

--! Sets the state of a quest (offen/aktiv/erledigt).
fn quest_set quest_id state
    db_exec (open_db 0) ("UPDATE quests SET state = '" ++ (sql_escape state) ++ "' WHERE id = '" ++ (sql_escape quest_id) ++ "'")

--! Closes every quest whose id appears as objective target of given kinds.
fn quest_set_by_id quest_id state
    quest_set quest_id state

--! Returns all quests as row maps.
fn all_quests _
    db_query (open_db 0) "SELECT * FROM quests ORDER BY id"

--! Adjusts faction reputation by delta (never below zero). Upserts so even
--! factions not seeded into the world still accumulate reputation.
fn rep_add fraktion delta
    h: (open_db 0)
    rows: db_query h ("SELECT punkte FROM reputation WHERE fraktion = '" ++ (sql_escape fraktion) ++ "'")
    if len rows > 0
        neu: (get (at rows 0) "punkte") + delta
        if neu < 0
            neu: 0
        db_exec h ("UPDATE reputation SET punkte = " ++ (to_str neu) ++ " WHERE fraktion = '" ++ (sql_escape fraktion) ++ "'")
    else
        neu: delta
        if neu < 0
            neu: 0
        db_exec h ("INSERT INTO reputation VALUES ('" ++ (sql_escape fraktion) ++ "', " ++ (to_str neu) ++ ")")

--! Returns the reputation score of a faction (0 if unknown).
fn rep_get fraktion
    rows: db_query (open_db 0) ("SELECT punkte FROM reputation WHERE fraktion = '" ++ (sql_escape fraktion) ++ "'")
    if len rows > 0
        get (at rows 0) "punkte"
    else
        0

-- ---- Buffs (temporary stat modifications) ----

--! Applies a buff to the player. Replaces existing buff of same art.
fn apply_buff art wert runden
    h: (open_db 0)
    db_exec h ("DELETE FROM buffs WHERE spieler = 1 AND art = '" ++ (sql_escape art) ++ "'")
    db_exec h ("INSERT INTO buffs VALUES (1, '" ++ (sql_escape art) ++ "', " ++ (to_str wert) ++ ", " ++ (to_str runden) ++ ")")

--! Reduces all buff durations by 1; removes expired buffs.
fn tick_buffs _
    h: (open_db 0)
    db_exec h "UPDATE buffs SET runden = runden - 1 WHERE spieler = 1"
    db_exec h "DELETE FROM buffs WHERE spieler = 1 AND runden <= 0"

--! Returns the buff value for a given art (0 if none active).
fn get_buff art
    rows: db_query (open_db 0) ("SELECT wert FROM buffs WHERE spieler = 1 AND art = '" ++ (sql_escape art) ++ "'")
    if len rows > 0
        get (at rows 0) "wert"
    else
        0

--! Removes all buffs of a given art.
fn clear_buff art
    db_exec (open_db 0) ("DELETE FROM buffs WHERE spieler = 1 AND art = '" ++ (sql_escape art) ++ "'")

--! Returns all active buffs as row maps.
fn all_buffs _
    db_query (open_db 0) "SELECT art, wert, runden FROM buffs WHERE spieler = 1"

-- ---- Monsters & combat support ----

--! Returns all alive monsters in a room.
fn monsters_in_room room_id
    db_query (open_db 0) ("SELECT * FROM monsters WHERE room = '" ++ (sql_escape room_id) ++ "' AND defeated = 0")

--! Applies damage to a monster; returns remaining hp.
fn monster_hit monster_id dmg
    h: (open_db 0)
    rows: db_query h ("SELECT hp FROM monsters WHERE id = '" ++ (sql_escape monster_id) ++ "'")
    if len rows == 0
        -1
    else
        hp: (get (at rows 0) "hp") - dmg
        if hp < 0
            hp: 0
        db_exec h ("UPDATE monsters SET hp = " ++ (to_str hp) ++ " WHERE id = '" ++ (sql_escape monster_id) ++ "'")
        hp

--! Marks a monster defeated and drops its loot into its room.
fn monster_defeat monster_id
    h: (open_db 0)
    rows: db_query h ("SELECT room, loot FROM monsters WHERE id = '" ++ (sql_escape monster_id) ++ "'")
    if len rows == 0
        nil
    else
        m: at rows 0
        db_exec h ("UPDATE monsters SET defeated = 1 WHERE id = '" ++ (sql_escape monster_id) ++ "'")
        loot: get m "loot"
        if loot != ""
            room_add_item (get m "room") loot
        rep_add "doerfer" 1
        check_kill_objective monster_id loot

-- ---- Player vitals & gold ----

--! Updates the player's hp (capped at max_hp).
fn set_player_hp hp
    p: (get_player 0)
    mh: get p "max_hp"
    if mh != nil && hp > mh
        hp: mh
    if hp < 0
        hp: 0
    db_exec (open_db 0) ("UPDATE player SET hp = " ++ (to_str hp) ++ " WHERE id = 1")

--! Adjusts the player's gold by delta (never below zero); returns new amount.
fn adjust_gold delta
    p: (get_player 0)
    neu: (get p "gold") + delta
    if neu < 0
        neu: 0
    db_exec (open_db 0) ("UPDATE player SET gold = " ++ (to_str neu) ++ " WHERE id = 1")
    neu

-- ---- Mana ----

--! Adjusts mana by delta (clamped to 0..max_mana); returns new amount.
fn adjust_mana delta
    p: (get_player 0)
    aktuell: get p "mana"
    maximum: get p "max_mana"
    neu: aktuell + delta
    if neu < 0
        neu: 0
    if neu > maximum
        neu: maximum
    db_exec (open_db 0) ("UPDATE player SET mana = " ++ (to_str neu) ++ " WHERE id = 1")
    neu

--! True when the player has enough mana for a spell.
fn has_mana cost
    p: (get_player 0)
    (get p "mana") >= cost

--! Spends mana; returns true on success.
fn spend_mana cost
    p: (get_player 0)
    if (get p "mana") < cost
        false
    else
        adjust_mana (-cost)
        true

-- ---- Spells (learned by player) ----

--! Learns a spell from the pack.
fn learn_spell spell_id
    h: (open_db 0)
    rows: db_query h ("SELECT id FROM player_spells WHERE spieler = 1 AND spell_id = '" ++ (sql_escape spell_id) ++ "'")
    if len rows > 0
        false
    else
        db_exec h ("INSERT INTO player_spells VALUES (1, '" ++ (sql_escape spell_id) ++ "')")
        true

--! Returns all spells the player has learned.
fn player_spells _
    h: (open_db 0)
    ps_rows: db_query h "SELECT spell_id FROM player_spells WHERE spieler = 1"
    if len ps_rows == 0
        []
    else
        all_spells: db_query h "SELECT * FROM spells"
        result: []
        for sp in all_spells
            sp_id: get sp "id"
            for pr in ps_rows
                if sp_id == (get pr "spell_id")
                    push result sp
        result

--! Returns a spell definition by id.
fn get_spell spell_id
    rows: db_query (open_db 0) ("SELECT * FROM spells WHERE id = '" ++ (sql_escape spell_id) ++ "'")
    if len rows > 0
        at rows 0
    else
        nil

--! Checks if the player knows a spell.
fn knows_spell spell_id
    rows: db_query (open_db 0) ("SELECT id FROM player_spells WHERE spieler = 1 AND spell_id = '" ++ (sql_escape spell_id) ++ "'")
    len rows > 0

-- ---- Monster abilities ----

--! Returns all abilities for a monster type.
fn get_monster_abilities monster_id
    db_query (open_db 0) ("SELECT * FROM monster_abilities WHERE monster = '" ++ (sql_escape monster_id) ++ "'")

--! Theme-aware narrator system prompt.
fn narrator_system _
    theme: get_meta "theme"
    if theme == "" || theme == nil
        theme: "Fantasy"
    ton: get_meta "ton"
    if ton == "" || ton == nil
        ton: "düster"
    "Du bist der Erzähler eines " ++ ton ++ "en " ++ theme ++ "-Textabenteuers (deutsch). Nutze die Werkzeuge, die der Spieler braucht, und fasse die Tool-Ergebnisse atmosphärisch in höchstens 3 Sätzen zusammen. Erfinde keine Gegenstände, Untiere oder Wege, die es nicht gibt. Bei Untieren ermutige den Spieler zum Angriff (attack_enemy), bei Händlern zum Handel (buy_item/sell_item)."

--! Narrator prompt for lore/enrichment generation (shorter, author-focused).
fn narrator_author _
    theme: get_meta "theme"
    if theme == "" || theme == nil
        theme: "Fantasy"
    ton: get_meta "ton"
    if ton == "" || ton == nil
        ton: "düster"
    "Du bist ein fantasievoller Autor für " ++ ton ++ "e " ++ theme ++ "-Textabenteuer (deutsch). Halte dich exakt an die geforderte Länge."

-- ---- Player XP / Level ----

--! Adds XP to the player; returns new total.
fn add_xp amount
    p: (get_player 0)
    xp: 0
    if get p "xp" != nil
        xp: get p "xp"
    neu: xp + amount
    db_exec (open_db 0) ("UPDATE player SET xp = " ++ (to_str neu) ++ " WHERE id = 1")
    neu

--! Returns the player's XP.
fn get_xp _
    p: (get_player 0)
    if get p "xp" != nil
        get p "xp"
    else
        0

--! Respawns the player at the start room after death.
fn respawn_player _
    h: (open_db 0)
    respawn_mana: 4
    m_raw: get_meta "mechanics"
    if m_raw != ""
        m: parse_json m_raw
        if get m "respawn_mana" != nil
            respawn_mana: get m "respawn_mana"
    db_exec h ("UPDATE player SET room = '" ++ (sql_escape (get_meta "start_room")) ++ "', hp = " ++ (get_meta "respawn_hp") ++ ", mana = " ++ (to_str respawn_mana) ++ " WHERE id = 1")
    rep_add "doerfer" (-1)

--! Returns all rooms as row maps.
fn all_rooms
    db_query (open_db 0) "SELECT * FROM rooms ORDER BY id"

-- ---- Flavor ----

--! Returns the stored atmospheric description of a room (empty if none).
fn get_flavor room_id
    rows: db_query (open_db 0) ("SELECT body FROM flavor WHERE room = '" ++ (sql_escape room_id) ++ "'")
    if len rows > 0
        get (at rows 0) "body"
    else
        ""

--! Stores an atmospheric room description (newlines flattened for SQL).
fn set_flavor room_id raw
    h: (open_db 0)
    flat: join_list (split raw "\n") " "
    esc: sql_escape flat
    rows: db_query h ("SELECT room FROM flavor WHERE room = '" ++ (sql_escape room_id) ++ "'")
    if len rows > 0
        db_exec h ("UPDATE flavor SET body = '" ++ esc ++ "' WHERE room = '" ++ (sql_escape room_id) ++ "'")
    else
        db_exec h ("INSERT INTO flavor VALUES ('" ++ (sql_escape room_id) ++ "', '" ++ esc ++ "')")

-- ---- Save / Load (game state) ----

--! Saves all mutable tables as JSON under saves/.
fn save_game name
    safe: join_list (split (replace name " " "_") "/") "_"
    h: (open_db 0)
    data: {player: db_query h "SELECT * FROM player", rooms: db_query h "SELECT * FROM rooms", monsters: db_query h "SELECT * FROM monsters", quests: db_query h "SELECT * FROM quests", objectives: db_query h "SELECT * FROM objectives", reputation: db_query h "SELECT * FROM reputation", npc_memory: db_query h "SELECT * FROM npc_memory", flavor: db_query h "SELECT * FROM flavor", buffs: db_query h "SELECT * FROM buffs", npcs: db_query h "SELECT * FROM npcs", npc_placement: db_query h "SELECT * FROM npc_placement", custom_items: db_query h "SELECT * FROM custom_items", spells: db_query h "SELECT * FROM spells", player_spells: db_query h "SELECT * FROM player_spells", monster_abilities: db_query h "SELECT * FROM monster_abilities"}
    if !file_exists "saves"
        make_dir "saves"
    write_file ("saves/" ++ safe ++ ".json") (to_json data)
    "Spielstand \"" ++ safe ++ "\" gespeichert."

--! Loads a saved game from saves/.
fn load_game name
    safe: safe_name name
    path: "saves/" ++ safe ++ ".json"
    if file_exists path
        data: parse_json (read_file path)
        restore_save data
        "Spielstand \"" ++ safe ++ "\" geladen."
    else
        "Kein Spielstand namens \"" ++ safe ++ "\" gefunden."

--! Restores tables from a save document.
fn restore_save data
    h: (open_db 0)
    db_exec h "DELETE FROM player"
    db_exec h "DELETE FROM rooms"
    db_exec h "DELETE FROM monsters"
    db_exec h "DELETE FROM quests"
    db_exec h "DELETE FROM objectives"
    db_exec h "DELETE FROM reputation"
    db_exec h "DELETE FROM flavor"
    db_exec h "DELETE FROM npc_memory"
    db_exec h "DELETE FROM buffs"
    db_exec h "DELETE FROM npcs"
    db_exec h "DELETE FROM npc_placement"
    db_exec h "DELETE FROM custom_items"
    db_exec h "DELETE FROM spells"
    db_exec h "DELETE FROM player_spells"
    db_exec h "DELETE FROM monster_abilities"
    for row in (get data "monsters")
        db_exec h ("INSERT INTO monsters VALUES ('" ++ (sql_escape (get row "id")) ++ "', '" ++ (sql_escape (get row "name")) ++ "', '" ++ (sql_escape (get row "room")) ++ "', " ++ (to_str (get row "hp")) ++ ", " ++ (to_str (get row "max_hp")) ++ ", " ++ (to_str (get row "defense")) ++ ", '" ++ (sql_escape (get row "loot")) ++ "', " ++ (to_str (get row "defeated")) ++ ")")
    for row in (get data "quests")
        db_exec h ("INSERT INTO quests VALUES ('" ++ (sql_escape (get row "id")) ++ "', '" ++ (sql_escape (get row "name")) ++ "', '" ++ (sql_escape (get row "description")) ++ "', '" ++ (sql_escape (get row "state")) ++ "')")
    for row in (get data "objectives")
        main_val: 1
        if (get row "main") == 0
            main_val: 0
        db_exec h ("INSERT INTO objectives VALUES ('" ++ (sql_escape (get row "id")) ++ "', '" ++ (sql_escape (get row "kind")) ++ "', '" ++ (sql_escape (get row "target")) ++ "', '" ++ (sql_escape (get row "npc")) ++ "', '" ++ (sql_escape (get row "state")) ++ "', '" ++ (sql_escape (or_default_str (get row "quest"))) ++ "', " ++ (to_str main_val) ++ ")")
    for row in (get data "reputation")
        db_exec h ("INSERT INTO reputation VALUES ('" ++ (sql_escape (get row "fraktion")) ++ "', " ++ (to_str (get row "punkte")) ++ ")")
    for row in (get data "player")
        --! Backwards compatible: old saves have 6 columns, new saves have 10
        mana_val: 8
        max_mana_val: 15
        xp_val: 0
        max_hp_val: 10
        if get row "max_hp" != nil
            max_hp_val: get row "max_hp"
        if get row "mana" != nil
            mana_val: get row "mana"
        if get row "max_mana" != nil
            max_mana_val: get row "max_mana"
        if get row "xp" != nil
            xp_val: get row "xp"
        db_exec h ("INSERT INTO player VALUES (" ++ (to_str (get row "id")) ++ ", '" ++ (sql_escape (get row "room")) ++ "', " ++ (to_str (get row "hp")) ++ ", " ++ (to_str max_hp_val) ++ ", " ++ (to_str (get row "gold")) ++ ", " ++ (to_str mana_val) ++ ", " ++ (to_str max_mana_val) ++ ", " ++ (to_str xp_val) ++ ", '" ++ (sql_escape (get row "inventory")) ++ "', " ++ (to_str (get row "won")) ++ ")")
    for row in (get data "rooms")
        db_exec h ("INSERT INTO rooms VALUES ('" ++ (sql_escape (get row "id")) ++ "', '" ++ (sql_escape (get row "description")) ++ "', '" ++ (sql_escape (get row "items")) ++ "', '" ++ (sql_escape (get row "exits")) ++ "')")
    for row in (get data "npc_memory")
        db_exec h ("INSERT INTO npc_memory VALUES ('" ++ (sql_escape (get row "npc")) ++ "', '" ++ (sql_escape (get row "summary")) ++ "', " ++ (to_str (get row "turns")) ++ ")")
    --! Restore flavor if saved (backwards compatible with old saves)
    flav: or_default_list (get data "flavor")
    for row in flav
        db_exec h ("INSERT INTO flavor VALUES ('" ++ (sql_escape (get row "room")) ++ "', '" ++ (sql_escape (get row "body")) ++ "')")
    --! Restore buffs if saved (backwards compatible)
    buff_data: or_default_list (get data "buffs")
    for row in buff_data
        db_exec h ("INSERT INTO buffs VALUES (" ++ (to_str (get row "spieler")) ++ ", '" ++ (sql_escape (get row "art")) ++ "', " ++ (to_str (get row "wert")) ++ ", " ++ (to_str (get row "runden")) ++ ")")
    --! Restore player spells if saved (backwards compatible)
    ps_data: or_default_list (get data "player_spells")
    for row in ps_data
        db_exec h ("INSERT INTO player_spells VALUES (" ++ (to_str (get row "spieler")) ++ ", '" ++ (sql_escape (get row "spell_id")) ++ "')")
    --! Restore monster abilities if saved (backwards compatible)
    ma_data: or_default_list (get data "monster_abilities")
    for row in ma_data
        db_exec h ("INSERT INTO monster_abilities VALUES ('" ++ (sql_escape (get row "monster")) ++ "', '" ++ (sql_escape (get row "ability")) ++ "', '" ++ (sql_escape (get row "effekt")) ++ "', " ++ (to_str (get row "wert")) ++ ", " ++ (to_str (get row "runden")) ++ ", " ++ (to_str (get row "chance")) ++ ")")
    --! Restore world-structure tables (re-seeded from world doc on load, but
    --! may carry expansion-added rows in the live DB — persist them too).
    for row in (or_default_list (get data "npcs"))
        db_exec h ("INSERT INTO npcs VALUES ('" ++ (sql_escape (get row "id")) ++ "', '" ++ (sql_escape (or_default_str (get row "name"))) ++ "', '" ++ (sql_escape (or_default_str (get row "role"))) ++ "', '" ++ (sql_escape (or_default_str (get row "temperament"))) ++ "', " ++ (to_str (or_default_val (get row "buys_pct") 0)) ++ ", " ++ (to_str (or_default_val (get row "sells_pct") 0)) ++ ", '" ++ (sql_escape (or_default_str (get row "persona"))) ++ "')")
    for row in (or_default_list (get data "npc_placement"))
        db_exec h ("INSERT INTO npc_placement VALUES ('" ++ (sql_escape (get row "npc")) ++ "', '" ++ (sql_escape (or_default_str (get row "room"))) ++ "')")
    for row in (or_default_list (get data "custom_items"))
        db_exec h ("INSERT INTO custom_items VALUES ('" ++ (sql_escape (get row "id")) ++ "', '" ++ (sql_escape (or_default_str (get row "name"))) ++ "', '" ++ (sql_escape (or_default_str (get row "type"))) ++ "', " ++ (to_str (or_default_val (get row "value") 0)) ++ ", '" ++ (sql_escape (or_default_str (get row "tags"))) ++ "', '" ++ (sql_escape (or_default_str (get row "desc"))) ++ "', " ++ (to_str (or_default_val (get row "damage_bonus") 0)) ++ ", " ++ (to_str (or_default_val (get row "ranged") 0)) ++ ", '" ++ (sql_escape (or_default_str (get row "use_effect"))) ++ "', " ++ (to_str (or_default_val (get row "use_value") 0)) ++ ", '" ++ (sql_escape (or_default_str (get row "buff_stat"))) ++ "', " ++ (to_str (or_default_val (get row "buff_value") 0)) ++ ", " ++ (to_str (or_default_val (get row "buff_rounds") 0)) ++ ", '" ++ (sql_escape (or_default_str (get row "clear_stat"))) ++ "', " ++ (to_str (or_default_val (get row "use_text") 0)) ++ ")")
    for row in (or_default_list (get data "spells"))
        db_exec h ("INSERT INTO spells VALUES ('" ++ (sql_escape (get row "id")) ++ "', '" ++ (sql_escape (or_default_str (get row "name"))) ++ "', '" ++ (sql_escape (or_default_str (get row "typ"))) ++ "', " ++ (to_str (or_default_val (get row "manakosten") 0)) ++ ", " ++ (to_str (or_default_val (get row "schaden") 0)) ++ ", '" ++ (sql_escape (or_default_str (get row "effekt"))) ++ "', '" ++ (sql_escape (or_default_str (get row "beschreibung"))) ++ "')")

--! Saves the full world document (as produced by gen_world / loaded from disk)
--! plus current state snapshot under worlds/. A saved world stays reusable:
--! loading it re-seeds a fresh DB without any AI call.
fn save_world_doc name doc
    safe: safe_name name
    if !file_exists "worlds"
        make_dir "worlds"
    write_file ("worlds/" ++ safe ++ ".json") (to_json doc)
    "Welt \"" ++ safe ++ "\" gespeichert."

--! Loads a world document from worlds/ and seeds the DB. Returns the doc.
fn load_world_doc name
    safe: safe_name name
    path: "worlds/" ++ safe ++ ".json"
    if file_exists path
        set_meta "world_file" name
        doc: parse_json (read_file path)
        seed_world doc
        doc
    else
        nil

--! Saves the currently loaded world document back to its file.
fn save_current_world doc
    save_world_doc (get_meta "world_file") doc
-- ---- Hint / dialogue-context helpers (deterministic, no AI) ----

--! First unfinished objective row or nil.
fn next_open_objective _
    rows: db_query (open_db 0) "SELECT * FROM objectives WHERE state != 'erledigt' ORDER BY id LIMIT 1"
    if len rows > 0
        at rows 0
    else
        nil

--! True when the player carries item_name.
fn player_carries item_name
    p: get_player 0
    inv: []
    try
        inv: parse_json (get p "inventory")
    catch
        inv: []
    if inv != nil
        contains inv item_name
    else
        false

--! Room row whose items list contains item_name, or nil.
fn room_holding_item item_name
    rows: db_query (open_db 0) "SELECT * FROM rooms"
    found: [nil]
    for r in rows
        if (at found 0) == nil
            liste: []
            try
                liste: parse_json (get r "items")
            catch
                liste: []
            if liste != nil
                if contains liste item_name
                    set found 0 r
    at found 0

--! Room id of an undefeated monster matching target (id or loot), or "".
fn monster_target_room target
    rows: db_query (open_db 0) ("SELECT room FROM monsters WHERE defeated != 1 AND (id = '" ++ (sql_escape target) ++ "' OR loot = '" ++ (sql_escape target) ++ "')")
    if len rows > 0
        get (at rows 0) "room"
    else
        ""

--! Undefeated monster row that carries item_name as loot, or nil.
fn monster_carrying_item item_name
    rows: db_query (open_db 0) ("SELECT * FROM monsters WHERE defeated != 1 AND loot = '" ++ (sql_escape item_name) ++ "'")
    if len rows > 0
        at rows 0
    else
        nil

--! Display name of a room row: name column when set, else the room id.
fn room_display_name rmap
    nm: get rmap "name"
    if nm == nil || nm == ""
        get rmap "id"
    else
        nm

--! Nice display name of a room id (looks it up; "" stays "").
fn room_name_of room_id
    rows: db_query (open_db 0) ("SELECT * FROM rooms WHERE id = '" ++ (sql_escape room_id) ++ "'")
    if len rows > 0
        room_display_name (at rows 0)
    else
        ""

