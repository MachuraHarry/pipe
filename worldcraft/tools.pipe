--! tools.pipe — AI-callable game actions for "Worldcraft"
--! The LLM never mutates state directly: every ai_tool below goes through
--! pure functions in state.pipe, so the DB stays the single source of truth.
--! Win conditions and NPC placement are data-driven (objectives/npc_placement).

import "state.pipe"
import "lore.pipe"

-- Module-held resource pack (set once at startup by worldcraft.pipe).
PACK: [nil]

--! Stores the loaded resource pack for AI-facing wrappers.
fn set_pack p
    set PACK 0 p

--! Returns the stored resource pack.
fn get_pack _
    at PACK 0

-- Module-held world document (set once after loading/generation).
DOC_HOLDER: [nil]

--! Stores the current world document.
fn set_doc doc
    set DOC_HOLDER 0 doc

--! Returns the current world document.
fn get_doc _
    at DOC_HOLDER 0

--! Factual description of the current room (the narrator LLM wraps this).
fn look _
    p: (get_player 0)
    room: get_room (get p "room")
    if room == nil
        "Du schwebst im Nichts. (Fehler: Raum unbekannt)"
    else
        rid: get p "room"
        fl: get_flavor rid
        basis: get room "description"
        if fl != ""
            basis: fl
        rname: get room "name"
        if rname == nil || rname == ""
            rname: pretty_room_name rid
        beschr: "== " ++ rname ++ " ==\n" ++ basis
        npcs: npcs_in_room rid
        if len npcs > 0
            namen: []
            for n in npcs
                npc: get_npc n
                push namen (get npc "name")
            beschr: beschr ++ "\nHier sind: " ++ (join_list namen ", ")
        items: parse_json (get room "items")
        if len items > 0
            pack: get_pack 0
            item_listen: []
            for it in items
                eintrag: it
                if pack != nil
                    def: find_pack_item pack it
                    if def != nil && get def "desc" != nil
                        eintrag: it ++ " -- " ++ (get def "desc")
                push item_listen eintrag
            beschr: beschr ++ "\nHier liegt: " ++ (join_list item_listen "\n  ")
        ms: monsters_in_room rid
        if len ms > 0
            mons: []
            for m in ms
                push mons (get m "name")
            beschr: beschr ++ "\nUntier hier: " ++ (join_list mons ", ")
        exits: parse_json (get room "exits")
        if len exits > 0
            beschr: beschr ++ "\nAusgänge: " ++ (join_list (keys exits) ", ")
        beschr

--! Moves through an exit; returns the new room description.
fn move_to exit_name
    p: (get_player 0)
    room: get_room (get p "room")
    if room == nil
        "Dein Ort ist unbekannt. (Fehler)"
    else
        exits: parse_json (get room "exits")
        -- Normalize: try direct match first, then ue→ü and ü→ue variants
        norm: exit_name
        if contains (keys exits) norm
            nil
        else
            if contains norm "ü"
                norm: replace norm "ü" "ue"
            else
                if contains norm "ue"
                    norm: replace norm "ue" "ü"
        if contains (keys exits) norm
            ziel: get exits norm
            set_player_room ziel
            check_explore_objective ziel
            look 0
        else
            "Dorthin führt kein Weg."

--! Picks up an item from the current room.
fn take_item item_name
    p: (get_player 0)
    if inventory_has item_name
        "Das trägst du bereits."
    else
        if room_take_item (get p "room") item_name
            inventory_add item_name
            check_fetch_objective item_name
            "Du nimmst: " ++ item_name
        else
            "Das liegt hier nicht."

--! Offers an item to an NPC present in the room. Completes give-objectives;
--! giving anything raises reputation with the alte_ordnung slightly.
fn give_item item_name npc_id
    p: (get_player 0)
    npc_here: get_npc_room npc_id
    if npc_here != (get p "room")
        "Hier ist niemand namens " ++ npc_id ++ "."
    else
        if !inventory_has item_name
            "Das trägst du bei dir nicht."
        else
            inventory_remove item_name
            rep_add "alte_ordnung" 1
            won: check_give_objective item_name npc_id
            meldung: npc_id ++ " betrachtet " ++ item_name ++ " schweigend und legt es beiseite."
            if won
                meldung: npc_id ++ " nimmt " ++ item_name ++ " mit beiden Händen entgegen. Etwas Altes und Verwundetes löst sich -- die Aufgabe ist erfüllt."
            meldung

--! Finds an alive monster in the current room matching the given name/id.
fn find_monster name_or_id
    p: (get_player 0)
    ms: monsters_in_room (get p "room")
    found: [nil]
    for m in ms
        if (at found 0) == nil
            if (get m "id") == name_or_id
                set found 0 m
            else
                if contains (lower (get m "name")) (lower name_or_id)
                    set found 0 m
    at found 0

-- ---- Magic system ----

--! Shows all spells the player has learned.
fn show_spells _
    spells: player_spells 0
    p: (get_player 0)
    mana: 0
    max_mana: 0
    if p != nil
        if get p "mana" != nil
            mana: get p "mana"
        if get p "max_mana" != nil
            max_mana: get p "max_mana"
    if len spells == 0
        "Du kennst keine Zauber. (Mana: " ++ (to_str mana) ++ "/" ++ (to_str max_mana) ++ ")"
    else
        out: "Mana: " ++ (to_str mana) ++ "/" ++ (to_str max_mana) ++ "\nZauber:"
        for sp in spells
            sp_name: or_default_str (get sp "name")
            sp_typ: or_default_str (get sp "typ")
            sp_kosten: 0
            if get sp "manakosten" != nil
                sp_kosten: get sp "manakosten"
            sp_schaden: 0
            if get sp "schaden" != nil
                sp_schaden: get sp "schaden"
            sp_beschreibung: or_default_str (get sp "beschreibung")
            out: out ++ "\n  " ++ sp_name ++ " (" ++ sp_typ ++ ") -- " ++ (to_str sp_kosten) ++ " Mana"
            if sp_schaden > 0
                out: out ++ ", " ++ (to_str sp_schaden) ++ " Schaden"
            out: out ++ "\n    " ++ sp_beschreibung
        out

--! Learns a spell if the player doesn't know it yet (user-facing with message).
fn learn_spell_ui spell_id
    sp: get_spell spell_id
    if sp == nil
        "Diesen Zauber gibt es nicht."
    else
        if knows_spell spell_id
            "Du kennst diesen Zauber bereits."
        else
            learn_spell spell_id
            "Du hast gelernt: " ++ (get sp "name") ++ " -- " ++ (get sp "beschreibung")

--! Casts a spell on a target.
fn cast_spell spell_name target
    sp: nil
    -- Find spell by name or id
    all_spells: player_spells 0
    for s in all_spells
        sid: or_default_str (get s "id")
        sname: or_default_str (get s "name")
        if sid == spell_name || lower sname == lower spell_name
            sp: s
    if sp == nil
        "Du kennst diesen Zauber nicht oder er existiert nicht."
    else
        kosten: get sp "manakosten"
        if !has_mana kosten
            "Nicht genug Mana. (" ++ (to_str kosten) ++ " benötigt, " ++ (to_str (get (get_player 0) "mana")) ++ " vorhanden)"
        else
            typ: get sp "typ"
            if typ == "angriff"
                m: find_monster target
                if m == nil
                    "Hier gibt es kein Untier namens " ++ target ++ "."
                else
                    spend_mana kosten
                    schaden: get sp "schaden"
                    eff: get sp "effekt"
                    bericht: "Du wirbst " ++ (get sp "name") ++ "! Ein Schauer aus Energie trifft " ++ (get m "name") ++ " für " ++ (to_str schaden) ++ " Schaden."
                    hp: monster_hit (get m "id") schaden
                    if hp <= 0
                        monster_defeat (get m "id")
                        bericht: bericht ++ "\nDas Untier ist besiegt!"
                        if (get m "loot") != ""
                            bericht: bericht ++ " Sein Fall legt frei: " ++ (get m "loot") ++ "."
                    else
                        if eff == "paralyse"
                            apply_buff ("paralyse_" ++ (get m "id")) 1 1
                            bericht: bericht ++ "\n" ++ (get m "name") ++ " ist gelähmt und kann nicht zurückschlagen!"
                        else
                            -- Monster retaliates normally
                            rache: random_range 1 3
                            php: (get (get_player 0) "hp") - rache
                            set_player_hp php
                            bericht: bericht ++ "\nEs schlägt zurück für " ++ (to_str rache) ++ " Schaden. (HP: " ++ (to_str php) ++ ")"
                            if php <= 0
                                (respawn_player 0)
                                bericht: bericht ++ "\nSchwarz wird es vor deinen Augen. Du erwachst am Anfang."
                    bericht
            else
                if typ == "heilung"
                    spend_mana kosten
                    heil: 5
                    eff: get sp "effekt"
                    if eff != "" && contains eff "heal_"
                        heil_str: replace eff "heal_" ""
                        heil: (to_num heil_str)
                    p: (get_player 0)
                    neu: (get p "hp") + heil
                    max_hp_val: 10
                    if get_meta "start_hp" != ""
                        max_hp_val: (to_num (get_meta "start_hp"))
                    if neu > max_hp_val
                        neu: max_hp_val
                    set_player_hp neu
                    "Du wirbst " ++ (get sp "name") ++ ". Wärme durchströmt deinen Körper. (HP: " ++ (to_str neu) ++ ")"
                else
                    if typ == "verteidigung"
                        spend_mana kosten
                        eff: get sp "effekt"
                        if eff == "block_1"
                            apply_buff "eis_schild" 1 1
                            "Du wirbst " ++ (get sp "name") ++ ". Ein eisiger Schimmer umhüllt dich -- ein Angriff wird absorbiert."
                        else
                            if contains eff "defense_"
                                runden: 3
                                if contains eff "3runden"
                                    runden: 3
                                apply_buff "verteidigung" 2 runden
                                "Du wirbst " ++ (get sp "name") ++ ". Ein unsichtbarer Schutz lagert sich um dich. (+2 Verteidigung für " ++ (to_str runden) ++ " Runden)"
                            else
                                apply_buff "verteidigung" 1 2
                                "Du wirbst " ++ (get sp "name") ++ ". Dein Körper fühlt sich fester an."
                    else
                        "Dieser Zaubertyp ist noch nicht implementiert."

--! Defends without a spell: reduces incoming damage for one round.
fn defend _
    apply_buff "verteidigung" 2 1
    "Du positionierst dich defensiv. (+2 Verteidigung für diese Runde)"

--! Attacks a monster in the current room; the monster strikes back.
fn attack_enemy target
    p: (get_player 0)
    m: find_monster target
    if m == nil
        "Hier gibt es kein Untier dieses Namens."
    else
        pack: get_pack 0
        mechanics_raw: get_meta "mechanics"
        mechanics: {}
        if mechanics_raw != ""
            mechanics: parse_json mechanics_raw
        waffen_bonus: 2
        if mechanics != {} && get mechanics "attack_bonus_waffe" != nil
            waffen_bonus: get mechanics "attack_bonus_waffe"
        bonus: 0
        --! Data-driven weapon bonuses: each weapon in inventory contributes damage_bonus from pack
        inv: parse_json (get p "inventory")
        for it in inv
            if pack != nil
                def: find_pack_item pack it
                if def != nil
                    itype: or_default_str (get def "type")
                    if itype == "waffe"
                        dbonus: get def "damage_bonus"
                        if dbonus != nil
                            bonus: bonus + dbonus
                        else
                            bonus: bonus + waffen_bonus
                    else
                        if (get def "use_effect") == "buff" && (get def "buff_stat") == "angriff"
                            bonus: bonus + 1
        --! Apply buff/debuff modifiers
        buff_bonus: get_buff "angriff"
        debuff: get_buff "schwaeche"
        debuff2: get_buff "angriff_down"
        bonus: bonus + buff_bonus - debuff - debuff2
        if bonus < 0
            bonus: 0
        dmg: (random_range 1 6) + bonus - (get m "defense")
        --! Verteidigungsbuff des Spielers
        verteidigung: get_buff "verteidigung"
        if dmg < 0
            dmg: 0
        hp: monster_hit (get m "id") dmg
        bericht: "Dein Angriff trifft für " ++ (to_str dmg) ++ " Schaden."
        if hp <= 0
            monster_defeat (get m "id")
            mon_diff: 1
            if get m "difficulty" != nil
                mon_diff: get m "difficulty"
            xp_betrag: mon_diff * 10
            add_xp xp_betrag
            bericht: bericht ++ "\nDas Untier ist tot! (+" ++ (to_str xp_betrag) ++ " XP)"
            if (get m "loot") != ""
                bericht: bericht ++ " Sein Fall legt frei: " ++ (get m "loot") ++ "."
        else
            --! Check if monster is paralyzed
            paralyzed: get_buff ("paralyse_" ++ (get m "id"))
            if paralyzed > 0
                bericht: bericht ++ "\n" ++ (get m "name") ++ " ist gelähmt und kann nicht zurückschlagen."
            else
                --! Monster ability check
                mon_type: (get m "id")
                abilities: get_monster_abilities mon_type
                ability_angewendet: false
                for ab in abilities
                    if !ability_angewendet
                        chance: get ab "chance"
                        roll: random_range 1 100
                        if roll <= chance
                            ability_angewendet: true
                            eff: get ab "effekt"
                            wert: get ab "wert"
                            runden: get ab "runden"
                            bericht: bericht ++ "\n" ++ (get m "name") ++ " setzt " ++ (get ab "ability") ++ " ein!"
                            if eff == "gift"
                                apply_buff "gift" wert runden
                                bericht: bericht ++ " Du wirst vergiftet! (-" ++ (to_str wert) ++ " HP pro Runde)"
                            else
                                if eff == "schwaeche"
                                    apply_buff "schwaeche" wert runden
                                    bericht: bericht ++ " Du fühlst dich schwächer."
                                else
                                    if eff == "schreck"
                                        apply_buff "schreck" wert runden
                                        bericht: bericht ++ " Ein Schauer des Grausen überläuft dich."
                                    else
                                        if eff == "angriff_down"
                                            apply_buff "angriff_down" wert runden
                                            bericht: bericht ++ " Dein Angriff wird geschwächt."
                                        else
                                            if eff == "langsam"
                                                apply_buff "langsam" wert runden
                                                bericht: bericht ++ " Du wirst langsamer."
                                            else
                                                if eff == "defense_up"
                                                    apply_buff ("monster_def_" ++ mon_type) wert runden
                                                    bericht: bericht ++ " Die Haut wird fester."
                                                else
                                                    -- Direct damage ability (e.g. wurfdolch)
                                                    php: (get (get_player 0) "hp") - wert
                                                    set_player_hp php
                                                    bericht: bericht ++ " trifft dich für " ++ (to_str wert) ++ " Schaden! (HP: " ++ (to_str php) ++ ")"
                                                    if php <= 0
                                                        respawn_player 0
                                                        bericht: bericht ++ "\nSchwarz wird es vor deinen Augen. Du erwachst am Anfang."
                --! Monster retaliates (if not paralyzed and no eis_schild)
                eis_schild: get_buff "eis_schild"
                if !ability_angewendet || eis_schild > 0
                    if eis_schild > 0
                        clear_buff "eis_schild"
                        bericht: bericht ++ "\nDein Eis-Schild absorbiert den Schlag."
                    else
                        rache: random_range 1 3
                        --! Reduce damage by player defense buff
                        rache: rache - verteidigung
                        if rache < 0
                            rache: 0
                        --! Check monster defense_up buff
                        mon_def_buff: get_buff ("monster_def_" ++ mon_type)
                        -- Monster defense_up doesn't reduce retaliation, only incoming damage
                        php: (get p "hp") - rache
                        set_player_hp php
                        bericht: bericht ++ "\nEs schlägt zurück für " ++ (to_str rache) ++ " Schaden. (HP: " ++ (to_str php) ++ ")"
                        if php <= 0
                            (respawn_player 0)
                            bericht: bericht ++ "\nSchwarz wird es vor deinen Augen. Du erwachst am Anfang -- hereingetragen von fremden Händen."
        bericht

-- ---- Trade ----

--! True when a haendler NPC stands in the player's room; returns its id.
fn trader_in_room _
    p: (get_player 0)
    hier: npcs_in_room (get p "room")
    found: [""]
    for nid in hier
        if (at found 0) == ""
            npc: get_npc nid
            if (get npc "role") == "haendler"
                set found 0 nid
    at found 0

--! Price the trader charges for an item (value * sells_pct / 100).
fn buy_price npc_row value
    ((value * (get npc_row "sells_pct")) + 50) / 100

--! Price the trader pays for an item (value * buys_pct / 100).
fn sell_price npc_row value
    (value * (get npc_row "buys_pct")) / 100

--! Looks up an item definition row by id or name fragment (pack + custom items).
fn find_pack_item pack name_or_id
    found: [nil]
    if pack != nil
        for it in (get pack "items")
            if (at found 0) == nil
                if (get it "id") == name_or_id
                    set found 0 it
                else
                    if contains (lower (get it "name")) (lower name_or_id)
                        set found 0 it
    -- Also check custom items (AI-generated)
    if (at found 0) == nil
        custom: find_custom_item name_or_id
        if custom != nil
            set found 0 custom
    at found 0

--! Buys an item from the trader in the current room.
fn buy_item pack item_name
    t: trader_in_room 0
    if t == ""
        "Hier kann niemand etwas verkaufen."
    else
        def: find_pack_item pack item_name
        if def == nil
            "Das führt kein Händler im Sortiment."
        else
            npc: get_npc t
            preis: buy_price npc (get def "value")
            p: (get_player 0)
            if (get p "gold") < preis
                "Dafür fehlt dir das Gold (" ++ (to_str preis) ++ " benötigt)."
            else
                adjust_gold (-preis)
                inventory_add (get def "id")
                "Du kaufst " ++ (get def "id") ++ " für " ++ (to_str preis) ++ " Gold. (Rest: " ++ (to_str (get (get_player 0) "gold")) ++ ")"

--! Sells an item from the inventory to the trader in the current room.
fn sell_item pack item_name
    t: trader_in_room 0
    if t == ""
        "Hier gibt es niemanden, der kauft."
    else
        if !inventory_has item_name
            "Das trägst du nicht bei dir."
        else
            def: find_pack_item pack item_name
            if def == nil
                "Das interessiert hier niemanden."
            else
                npc: get_npc t
                preis: sell_price npc (get def "value")
                inventory_remove (get def "id")
                gold: adjust_gold preis
                "Du verkaufst " ++ (get def "id") ++ " für " ++ (to_str preis) ++ " Gold. (Kasse: " ++ (to_str gold) ++ ")"

--! Checks if a pack item is usable (consumable or use_text tool).
fn item_usable def
    if def == nil
        false
    else
        typ: get def "type"
        if typ == "konsum"
            true
        else
            (get def "use_text") == true

--! Uses an item from the inventory (data-driven via pack).
fn use_item item_name
    if !inventory_has item_name
        "Das trägst du nicht bei dir."
    else
        pack: get_pack 0
        def: nil
        if pack != nil
            def: find_pack_item pack item_name
        if def == nil
            "Das lässt sich gerade nicht gebrauchen."
        else
            eff: get def "use_effect"
            if eff == nil || eff == "none" || eff == ""
                if (get def "use_text") == true
                    desc: or_default_str (get def "desc")
                    name: or_default_str (get def "name")
                    if desc == ""
                        desc: name
                    "Du benutzt " ++ name ++ ". " ++ desc
                else
                    itype: or_default_str (get def "type")
                    if itype == "waffe"
                        name: or_default_str (get def "name")
                        "Der " ++ name ++ " ist eine Waffe. Greife ein Untier damit an, statt ihn zu benutzen."
                    else
                        "Das lässt sich gerade nicht gebrauchen."
            else
                inventory_remove item_name
                name: or_default_str (get def "name")
                if eff == "heal"
                    heal_val: 4
                    uv: get def "use_value"
                    if uv != nil
                        heal_val: uv
                    mechanics_raw: get_meta "mechanics"
                    if mechanics_raw != ""
                        mechanics: parse_json mechanics_raw
                        if get mechanics "heiltrank_heilung" != nil
                            heal_val: get mechanics "heiltrank_heilung"
                    p: (get_player 0)
                    neu: (get p "hp") + heal_val
                    set_player_hp neu
                    pn: (get_player 0)
                    "Du benutzt " ++ name ++ ". Wärme breitet sich aus. (HP: " ++ (to_str (get pn "hp")) ++ ")"
                else
                    if eff == "buff"
                        stat: or_default_str (get def "buff_stat")
                        bv: 3
                        br: 3
                        bv_raw: get def "buff_value"
                        if bv_raw != nil
                            bv: bv_raw
                        br_raw: get def "buff_rounds"
                        if br_raw != nil
                            br: br_raw
                        apply_buff stat bv br
                        "Du benutzt " ++ name ++ ". (+" ++ (to_str bv) ++ " " ++ stat ++ " für " ++ (to_str br) ++ " Runden)"
                    else
                        if eff == "clear_buff"
                            stat: or_default_str (get def "clear_stat")
                            clear_buff stat
                            "Du benutzt " ++ name ++ ". Der Effekt nachlässt."
                        else
                            inventory_add item_name
                            "Das lässt sich gerade nicht gebrauchen."

-- ---- Quest log & inventory display ----

--! Lists the quest log with states.
fn show_quests _
    qs: (all_quests 0)
    if len qs == 0
        "Keine Einträge im Quest-Log."
    else
        out: ""
        for qst in qs
            mark: "[ ]"
            if (get qst "state") == "erledigt"
                mark: "[x]"
            out: out ++ "\n" ++ mark ++ " " ++ (get qst "name") ++ ": " ++ (get qst "description")
        "Quest-Log:" ++ out

--! Shows what the player carries plus gold and hp.
fn show_inventory _
    p: (get_player 0)
    inv: parse_json (get p "inventory")
    kopf: "Stufe: " ++ (to_str (player_level 0)) ++ " | Gold: " ++ (to_str (get p "gold")) ++ " | HP: " ++ (to_str (get p "hp")) ++ "/" ++ (to_str (get p "max_hp")) ++ " | Mana: " ++ (to_str (get p "mana")) ++ "/" ++ (to_str (get p "max_mana")) ++ " | XP: " ++ (to_str (get p "xp")) ++ "/50"
    buffs: all_buffs 0
    if len buffs > 0
        buff_texte: []
        for b in buffs
            push buff_texte ((get b "art") ++ " (+" ++ (to_str (get b "wert")) ++ ", " ++ (to_str (get b "runden")) ++ " Runden)")
        kopf: kopf ++ "\nBuffs: " ++ (join_list buff_texte ", ")
    if len inv > 0
        kopf ++ "\nDu trägst bei dir: " ++ (join_list inv ", ")
    else
        kopf ++ "\nDeine Hände sind leer."

--! Talks to an NPC; reply comes from the LLM, memory is compressed via summarize.
--! The last dialog exchange is captured for API frontends (see api.pipe).
LAST_DIALOG: [nil]

--! Reads and clears the last captured dialog exchange (nil if none).
fn take_last_dialog _
    d: at LAST_DIALOG 0
    set LAST_DIALOG 0 nil
    d

fn talk_to npc_id last_message
    p: (get_player 0)
    npc_here: get_npc_room npc_id
    if npc_here != (get p "room")
        "Hier ist niemand namens " ++ npc_id ++ "."
    else
        alt: get_npc_memory npc_id
        turns: npc_turns npc_id
        mem: alt
        if (turns % 3) == 2
            try
                mem: summarize (alt ++ "\nSpieler: " ++ last_message)
            catch
                mem: alt
        persona: get_npc_persona_text npc_id
        lore_ctx: lore_context last_message
        kontext: ""
        if lore_ctx != ""
            kontext: "\n\nRelevantes Weltwissen:\n" ++ lore_ctx
        npc_row: get_npc npc_id
        name: npc_id
        rolle: "Bewohner"
        if npc_row != nil
            if (get npc_row "name") != nil && (get npc_row "name") != ""
                name: get npc_row "name"
            if (get npc_row "role") != nil && (get npc_row "role") != ""
                rolle: get npc_row "role"
        reply: ""
        try
            reply: ask ("Du bist " ++ persona ++ "\n\nBisherige Erinnerung an dieses Gespräch:\n" ++ mem ++ kontext ++ "\nDer Abenteurer sagt: \"" ++ last_message ++ "\"\n\nAntworte in Charakter, 1-3 Sätze.")
        catch
            reply: (fallback_npc_reply npc_id name rolle last_message)
        neumem: ("Gespräch mit dem Abenteurer. " ++ mem ++ "\nSpieler: " ++ last_message ++ "\nAntwort: " ++ reply)
        try
            set_npc_memory npc_id (summarize neumem)
        catch
            set_npc_memory npc_id neumem
        set LAST_DIALOG 0 {npc: npc_id, name: name, player: last_message, reply: reply}
        reply

--! Deterministic NPC reply used when the LLM is unavailable, so dialogue never
--! produces a silent/no-answer turn. Hint/quest questions are answered from the
--! live objectives so the dialogue actually progresses without the AI narrator.
fn fallback_npc_reply npc_id name rolle last_message
    t: lower last_message
    gruss: "Grüße, Abenteurer."
    if contains t "hallo" || contains t "grüß" || contains t "guten tag" || contains t "moin"
        gruss: "Sei gegrüßt."
    fragt_hint: contains t "hinweis" || contains t "tipp" || contains t "hilfe" || contains t "aufgabe" || contains t "quest" || contains t "helfen" || contains t "woher" || contains t "wie weiter"
    if fragt_hint
        gruss ++ " " ++ (hint_text_for npc_id)
    else
        gruss ++ " Ich bin " ++ name ++ ", der " ++ rolle ++ " hier in dieser Welt. Was führt dich zu mir? Frag mich nach Hinweisen, wenn du nicht weiter weißt."

--! Concrete, objective-based hint text for NPC dialogue without AI.
fn hint_text_for npc_id
    obj: next_open_objective 0
    if obj == nil
        "Ich kenne keine offenen Aufgaben mehr — du hast diese Welt wohl im Griff."
    else
        kind: get obj "kind"
        ziel: get obj "target"
        wem: get obj "npc"
        qname: get obj "quest"
        kopf: "Deine Aufgabe: "
        if qname != nil
            if qname != ""
                kopf: "Zur Aufgabe \"" ++ qname ++ "\": "
        if kind == "give"
            ich_bin_ziel: npc_id == wem
            ort: ""
            rm: room_holding_item ziel
            if rm != nil
                ort: " Man munkelt, \"" ++ (room_display_name rm) ++ "\" sei ein guter Ort dafür."
            else
                mrow: monster_carrying_item ziel
                if mrow != nil
                    ort: " Das Übel \"" ++ (get mrow "name") ++ "\" trägt " ++ ziel ++ " bei sich — es wurde bei \"" ++ (room_name_of (get mrow "room")) ++ "\" gesichtet."
            if player_carries ziel
                if ich_bin_ziel
                    kopf ++ "Du trägst " ++ ziel ++ " bereits bei dir — gib es mir einfach (\"gib " ++ wem ++ " " ++ ziel ++ "\")."
                else
                    kopf ++ "Du trägst " ++ ziel ++ " bereits bei dir — bring es zu " ++ (npc_display_name wem) ++ "."
            else
                anh: ""
                if ich_bin_ziel
                    anh: " Bring es zu mir (\"gib " ++ wem ++ " " ++ ziel ++ "\")."
                else
                    anh: " Es gehört zu " ++ (npc_display_name wem) ++ "."
                kopf ++ "Besorge " ++ ziel ++ "." ++ ort ++ anh
        else
            if kind == "kill"
                ort: monster_target_room ziel
                otxt: ""
                if ort != ""
                    otxt: " Gesichtet wurde es bei \"" ++ (room_name_of ort) ++ "\"."
                kopf ++ "Erledige das Übel namens \"" ++ ziel ++ "\"." ++ otxt
            else
                if kind == "explore"
                    kopf ++ "Begib dich zu dem Ort \"" ++ (room_name_of ziel) ++ "\"."
                else
                    kopf ++ "Nimm \"" ++ ziel ++ "\" an dich und trage es bei dir."

--! Nice display name for an NPC id.
fn npc_display_name nid
    n: get_npc nid
    if n != nil
        nm: get n "name"
        if nm != nil && nm != ""
            nm
        else
            nid
    else
        nid

--! Builds the persona prompt for an NPC from its DB row.
fn get_npc_persona_text npc_id
    npc: get_npc npc_id
    if npc == nil
        "ein mysteriöser Fremder. Antworte knapp."
    else
        "ein NPC dieser Welt:\nName: " ++ (get npc "name") ++ "\nRolle: " ++ (get npc "role") ++ "\nWesen: " ++ (get npc "temperament") ++ "\nHintergrund: " ++ (get npc "persona")

-- ---- Fast path commands (no AI) ----

--! Extracts all words after the first as lowercase item/target name.
fn first_word s
    ws: split s " "
    if len ws > 0
        at ws 0
    else
        ""

fn rest_words cmd
    w: split cmd " "
    out: []
    i: 1
    if len w > 1
        a: lower (at w 1)
        if a == "die" || a == "den" || a == "der" || a == "das" || a == "dem" || a == "einen" || a == "eine" || a == "ein" || a == "the"
            i: 2
    while i < (len w)
        push out (lower (at w i))
        i: i + 1
    join_list out " "

--! Returns the second word of a command (index 2) or empty string.
fn second_word cmd
    w: split cmd " "
    if len w > 2
        at w 2
    else
        ""

--! Handles common commands locally (no AI): returns {handled, text}.
fn fast_command cmd pack
    t: lower (trim cmd)
    w: split t " "
    erstes: at w 0
    if erstes == "norden" || erstes == "n" || (erstes == "geh" && contains t "norden")
        {handled: true, out: move_to "norden"}
    else
        if erstes == "sueden" || erstes == "süden" || erstes == "s" || (erstes == "geh" && (contains t "sueden" || contains t "süden"))
            {handled: true, out: move_to "süden"}
        else
            if erstes == "osten" || erstes == "o" || (erstes == "geh" && contains t "osten")
                {handled: true, out: move_to "osten"}
            else
                if erstes == "westen" || erstes == "w" || (erstes == "geh" && contains t "westen")
                    {handled: true, out: move_to "westen"}
                else
                    if erstes == "oben" || erstes == "rauf" || (erstes == "geh" && contains t "oben")
                        {handled: true, out: move_to "oben"}
                    else
                        if erstes == "unten" || erstes == "runter" || (erstes == "geh" && contains t "unten")
                            {handled: true, out: move_to "unten"}
                        else
                            if erstes == "nimm" && len w > 1
                                {handled: true, out: take_item (rest_words t)}
                            else
                                if (erstes == "kauf" || erstes == "kaufe") && len w > 1
                                    {handled: true, out: buy_item pack (rest_words t)}
                                else
                                    if (erstes == "verkauf" || erstes == "verkaufe") && len w > 1
                                        {handled: true, out: sell_item pack (rest_words t)}
                                    else
                                        if (erstes == "benutze" || erstes == "trinke") && len w > 1
                                            {handled: true, out: use_item (rest_words t)}
                                        else
                                            if erstes == "inventar" || erstes == "inv" || erstes == "i"
                                                {handled: true, out: show_inventory 0}
                                            else
                                                if erstes == "quests" || erstes == "aufgaben" || erstes == "log"
                                                    {handled: true, out: show_quests 0}
                                                else
                                                    if (erstes == "schau" || erstes == "umschauen" || erstes == "look")
                                                        {handled: true, out: look 0}
                                                    else
                                                    if (erstes == "greife" || erstes == "angriff" || erstes == "kämpfe")
                                                        if len w > 1
                                                            {handled: true, out: attack_enemy (first_word (rest_words t))}
                                                        else
                                                            -- Attack first monster in room if no target specified
                                                            mons: monsters_in_room (get (get_player 0) "room")
                                                            if mons != nil && len mons > 0
                                                                {handled: true, out: attack_enemy (get (at mons 0) "id")}
                                                            else
                                                                {handled: true, out: "Hier ist kein Monster."}
                                                    else
                                                            if (erstes == "zauber" || erstes == "zaubere") && len w > 1
                                                                {handled: true, out: cast_spell (first_word (rest_words t)) (second_word t)}
                                                            else
                                                                if erstes == "magie" || erstes == "zauberliste"
                                                                    {handled: true, out: show_spells 0}
                                                                else
                                                                    if (erstes == "wehre" && contains t "dich") || erstes == "verteidige"
                                                                        {handled: true, out: defend 0}
                                                                    else
                                                                        {handled: false, out: ""}

-- ---- Tool registration for ai_with_tools ----

ai_tool "look" "Beschreibe die aktuelle Umgebung" {} look
ai_tool "move_to" "Bewege den Spieler durch einen Ausgang (z.B. norden, sueden, osten, westen)" {exit_name: "Himmelsrichtung des Ausgangs"} move_to
ai_tool "take_item" "Hebe einen Gegenstand aus dem Raum auf" {item_name: "Name des Gegenstands"} take_item
ai_tool "give_item" "Biete einem NPC einen Gegenstand an" {item_name: "Name des Gegenstands", npc: "ID des NPCs"} give_item
ai_tool "show_inventory" "Zeige Inventar, Gold und HP des Spielers" {} show_inventory
ai_tool "talk_to" "Sprich mit einem NPC im Raum" {npc: "ID des NPCs", last_message: "Was der Spieler sagen möchte"} talk_to
ai_tool "attack_enemy" "Greife ein Untier im aktuellen Raum an" {target: "Name oder ID des Untiers"} attack_enemy
ai_tool "show_quests" "Zeige das Quest-Log" {} show_quests
ai_tool "save_game" "Speichere den Spielstand unter einem Namen" {name: "Name des Spielstands"} save_game
ai_tool "load_game" "Lade einen gespeicherten Spielstand" {name: "Name des Spielstands"} load_game
--! AI-facing trade wrappers (pack comes from set_pack).
fn buy_item_ai item_name
    buy_item (get_pack 0) item_name

fn sell_item_ai item_name
    sell_item (get_pack 0) item_name

ai_tool "buy_item" "Kaufe einen Gegenstand beim Händler im Raum" {item_name: "Name des Gegenstands"} buy_item_ai
ai_tool "sell_item" "Verkaufe einen Gegenstand an den Händler im Raum" {item_name: "Name des Gegenstands"} sell_item_ai
ai_tool "cast_spell" "Wirke einen Zauber auf ein Ziel" {spell_name: "Name oder ID des Zaubers", target: "Ziel des Zaubers (Monstername)"} cast_spell
ai_tool "show_spells" "Zeige alle gelernten Zauber und dein Mana" {} show_spells
ai_tool "defend" "Verteidige dich gegen einen Angriff (reduziert incoming Schaden)" {} defend
