--! turns.pipe — shared turn-processing core for Worldcraft frontends.
--! Both the terminal (worldcraft.pipe) and the HTTP worker (worldd.pipe)
--! use these functions, so gameplay behaves identically everywhere.
--! Frontends only add I/O flavor: spinners, ambient lines, JSON envelopes.

import "state.pipe"
import "tools.pipe"
import "gen_world.pipe"
import "log.pipe"

FREE_MODELS: ["big-pickle"]

AI_TIMEOUT_TURN: 120

--! Probes the free models and returns the first that answers.
fn pick_free_model models
    for m in models
        try
            ai_model m
            ask "Antworte mit genau einem Wort: bereit"
            return m
        catch
            print ("  (Modell " ++ m ++ " nicht erreichbar, teste nächstes)")
    "x-preview-f-free"

--! One narrator call with model rotation. Returns the narration text,
--! or "" when every model failed.
fn narrator_reply inp
    log "NARRATOR" "Starte Narrator-Antwort"
    antwort: ""
    ok: false
    for m in FREE_MODELS
        if !ok
            try
                log "NARRATOR" "Teste Modell " ++ m
                ai_model m
                antwort: ai_with_tools (narrator_system 0) inp
                log "NARRATOR" "Modell " ++ m ++ " hat geantwortet (" ++ (to_str (len antwort)) ++ " Zeichen)"
                ok: true
            catch e
                log "NARRATOR" "Modell " ++ m ++ " fehlgeschlagen: " ++ e
    if ok
        antwort
    else
        log_err "NARRATOR" "Alle Modelle fehlgeschlagen"
        ""

--! True when the input asks for a world expansion.
fn is_expand_input t
    erstes: at (split t " ") 0
    erstes == "erweitere" || erstes == "erweitern"

--! Extracts everything after the first word ("erweitere <wunsch>").
fn expand_wunsch_of inp
    ws: split (trim inp) " "
    out: []
    i: 1
    while i < len ws
        push out (at ws i)
        i: i + 1
    join_list out " "

--! True when the input is a structured NPC talk/give command that should be
--! resolved locally (deterministically) instead of going through the AI narrator.
fn is_talk_input t
    w: split t " "
    (at w 0) == "rede" || (at w 0) == "frag" || (at w 0) == "gib"

--! Joins words [from, len) of a split command into one lowercase string.
fn words_from ws from
    out: []
    i: from
    while i < len ws
        push out (at ws i)
        i: i + 1
    join_list out " "

--! Extracts {npc, msg} from an NPC talk command.
--!   "rede mit <npc> [msg]"  -> npc, msg
--!   "frag <npc> [nach msg]"  -> npc, msg
fn talk_args inp
    w: split (lower (trim inp)) " "
    npc: ""
    msg: ""
    if (at w 0) == "rede" && (at w 1) == "mit"
        if len w > 2
            npc: at w 2
            if len w > 3
                msg: words_from w 3
    else
        if (at w 0) == "frag"
            if len w > 1
                npc: at w 1
                if len w > 2
                    msg: words_from w 2
    {npc: npc, msg: msg}

--! Resolves an NPC talk/give command locally (no AI narrator needed).
--! Returns the player-facing text:
--!   * success      -> "" so the dialog bubble (set by talk_to) is rendered
--!   * rejection    -> the plain message (narrated) because no dialog was set
fn process_talk inp
    t: lower (trim inp)
    w: split t " "
    if (at w 0) == "gib"
        if len w >= 3
            give_item (at w 2) (at w 1)
        else
            "Gib was wem?"
    else
        args: talk_args inp
        npc: get args "npc"
        msg: get args "msg"
        if npc == ""
            "Mit wem möchtest du sprechen?"
        else
            if msg == ""
                msg: "Hallo"
            vorher: at LAST_DIALOG 0
            reply: talk_to npc msg
            nachher: at LAST_DIALOG 0
            if vorher == nachher
                reply
            else
                ""

--! Full synchronous turn for headless frontends (HTTP server).
--! Returns {type, narration, error, won}:
--!   type: "fast" | "narrator" | "expand" | "new_adventure"
--!   narration carries the player-facing text; "" on hard failure.
fn process_turn inp
    t: lower (trim inp)
    log "TURN" "Eingabe: " ++ inp
    result: {type: "narrator", narration: "", error: "", won: 0}
    if contains t "neues abenteuer"
        set result "type" "new_adventure"
        log "TURN" "Typ: new_adventure"
        set result "narration" (neues_abenteuer_ai 0)
    else
        if is_expand_input t
            set result "type" "expand"
            log "TURN" "Typ: expand"
            set result "narration" (expand_world_ai (expand_wunsch_of inp))
        else
            if is_talk_input t
                set result "type" "narrator"
                log "TURN" "Typ: talk"
                set result "narration" (process_talk inp)
            else
                fc: fast_command inp (get_pack 0)
                if (get fc "handled") == true
                    set result "type" "fast"
                    log "TURN" "Typ: fast"
                    set result "narration" (get fc "out")
                else
                    log "TURN" "Typ: narrator"
                    text: narrator_reply inp
                    if text == ""
                        set result "error" "alle Modelle nicht erreichbar"
                        log_err "TURN" "Alle Modelle nicht erreichbar"
                    else
                        set result "narration" text
    set result "won" (get (get_player 0) "won")
    tick_buffs 0
    log "TURN" "Fertig: won=" ++ (to_str (get result "won"))
    result

--! Provider boot: select provider + first working model. Safe to call in a
--! background task; prints progress like the terminal version does.
fn ai_boot _
    ai_provider "opencode"
    pick_free_model FREE_MODELS
    ai_timeout AI_TIMEOUT_TURN
