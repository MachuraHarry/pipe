test "apply_profile uses tag-based item lookup"
    init_db 0
    reset_state 0
    doc: parse_json (read_file "testdata/beispielwelt.json")
    -- Add a custom weapon to the pack items in the doc
    custom4: [{id: "energiesabel", name: "Energiesäbel", type: "waffe", value: 60, tags: ["energie", "kampf"], desc: "Ein leuchtender Säbel.", damage_bonus: 4, ranged: false, use_effect: "none", use_value: 0, buff_stat: "", buff_value: 0, buff_rounds: 0, clear_stat: "", use_text: false}]
    set doc "custom_items" custom4
    -- Create a modified pack that includes the custom item
    mod_pack: get_pack 0
    push (get mod_pack "items") (at custom4 0)
    -- apply_profile BEFORE seed_world (same order as worldcraft.pipe)
    apply_profile doc {stil: "kaempfer", schwierigkeit: "normal"} mod_pack
    seed_world_full doc
    new_game 0
    -- Should have the custom weapon (found via "kampf" tag) or the original schwert
    inv: parse_json (get (get_player 0) "inventory")
    expect_gt (len inv) 0 "kaempfer gets a weapon"

test "narrator_system returns theme-aware text"
    init_db 0
    reset_state 0
    set_meta "theme" "Cyberpunk"
    set_meta "ton" "neon-geschwängert"
    result: narrator_system 0
    expect_contains result "Cyberpunk" "theme in narrator"
    expect_contains result "neon-geschwängert" "ton in narrator"

test "narrator_system falls back to fantasy"
    init_db 0
    reset_state 0
    result: narrator_system 0
    expect_contains result "Fantasy" "default theme"
    expect_contains result "düster" "default ton"

--- === Regression: critical bug fixes === ===

test "restore_save re-inserts all persisted tables without PK crash"
    fresh_example 0
    learn_spell "feuerball"
    save_game "wc_resume"
    data: parse_json (read_file "saves/wc_resume.json")
    -- A second restore in the same session (the /resume path) used to crash on
    -- monster_abilities / player_spells PKs because they were re-inserted
    -- without being cleared first.
    restore_save data
    restore_save data
    expect_eq (len (db_query (open_db 0) "SELECT * FROM player_spells")) 1 "player_spells restored"
    expect_gt (len (db_query (open_db 0) "SELECT * FROM npcs")) 0 "npcs restored"
    expect_eq (len (db_query (open_db 0) "SELECT * FROM custom_items")) (len (get data "custom_items")) "custom_items count matches"
    expect_eq (len (db_query (open_db 0) "SELECT * FROM monster_abilities")) (len (get data "monster_abilities")) "monster_abilities count matches"

test "pack-tuned start_mana is honored after seed_world"
    init_db 0
    reset_state 0
    doc: {name: "t", start_room: "r", rooms: {}, npcs: [], monsters: [], quests: [], objectives: [], factions: [], mechanics: {start_hp: 10, start_gold: 20, respawn_hp: 10, start_mana: 42, max_mana: 99}}
    seed_world doc
    new_game 0
    p: (get_player 0)
    expect_eq (get p "mana") 42 "start_mana from mechanics"
    expect_eq (get p "max_mana") 99 "max_mana from mechanics"

test "design with fetch siegesbedingung passes validation"
    design: {thema: "T", ton: "d", raumzahl: 6, items: ["fackel"], npcs: [{id: "h", template: "haendler", name: "H"}], monsters: ["kammerling"], quests: [], siegesbedingung: {kind: "fetch", target: "goldmuenze", npc: ""}}
    expect_eq (len (validate_design design pack)) 0 "fetch design ok"

test "map with fetch objective passes validation"
    doc: parse_json (read_file "testdata/beispielwelt.json")
    set doc "objectives" (push (get doc "objectives") {id: "obj_fetch", kind: "fetch", target: "goldmuenze", npc: "", state: "offen"})
    expect_eq (len (validate_map doc pack)) 0 "fetch objective valid in map"

test "rep_add upserts for unseeded faction"
    fresh_example 0
    rep_add "neue_fraktion" 5
    expect_eq (rep_get "neue_fraktion") 5 "rep created"
    rep_add "neue_fraktion" (-10)
    expect_eq (rep_get "neue_fraktion") 0 "rep clamped at 0"

--- === Main vs. Side objectives (build) === ===

test "side objective alone does not win; main objective wins"
    init_db 0
    reset_state 0
    doc: parse_json (read_file "testdata/beispielwelt.json")
    neue_objs: []
    push neue_objs {id: "obj_main", kind: "give", target: "goldmuenze", npc: "weiser_aldric", state: "offen", main: 1}
    push neue_objs {id: "obj_side", kind: "kill", target: "kammerling", npc: "", state: "offen", main: 0}
    set doc "objectives" neue_objs
    seed_world_full doc
    new_game 0
    objective_complete "obj_side"
    expect_eq (get (get_player 0) "won") 0 "side objective does not trigger win"
    objective_complete "obj_main"
    expect_eq (get (get_player 0) "won") 1 "main objective triggers win"

test "missing main flag defaults to main for old objectives"
    init_db 0
    reset_state 0
    doc: parse_json (read_file "testdata/beispielwelt.json")
    ziele: []
    push ziele {id: "obj_alt", kind: "give", target: "goldmuenze", npc: "weiser_aldric", state: "offen"}
    set doc "objectives" ziele
    seed_world_full doc
    new_game 0
    objective_complete "obj_alt"
    expect_eq (get (get_player 0) "won") 1 "legacy objective treated as main"

test "erweitere_ziele guarantees at least 2 main objectives"
    bestand: []
    push bestand {id: "o1", kind: "give", target: "goldmuenze", npc: "weiser_aldric", state: "offen", main: 1}
    mon: []
    push mon {id: "kammerling"}
    raeume: ["tpl_eingang", "tpl_schatzkammer"]
    ziele: erweitere_ziele bestand mon raeume pack
    expect_truthy (len ziele >= 2) "at least two objectives"
    anzahl_main: 0
    for z in ziele
        if (get z "main") == 1
            anzahl_main: anzahl_main + 1
    expect_truthy (anzahl_main >= 2) "all generated objectives are main"
    kind_kill: false
    for z in ziele
        if (get z "kind") == "kill"
            kind_kill: true
    expect_truthy kind_kill "derives a kill objective from placed monster"

test "merge_expansion marks new objectives as side (main=0)"
    init_db 0
    reset_state 0
    doc: parse_json (read_file "testdata/beispielwelt.json")
    seed_world_full doc
    exp: {rooms: {tpl_dungeon_2: {description: "Neu.", items: []}}, links: [{anchor: "tpl_eingang", dir: "osten", room: "tpl_dungeon_2"}], npcs: [], monsters: [{id: "goblin", room: "tpl_dungeon_2"}], quests: ["q_heilmittel"], objectives: [{id: "obj_erw_x", kind: "kill", target: "goblin", npc: "", quest_id: "q_heilmittel"}]}
    merge_expansion exp doc pack
    o: db_query (open_db 0) "SELECT main FROM objectives WHERE id = 'obj_erw_x'"
    expect_eq (get (at o 0) "main") 0 "expansion objective is a side quest"

test "restore_save preserves main flag"
    init_db 0
    reset_state 0
    doc: parse_json (read_file "testdata/beispielwelt.json")
    ziele: []
    push ziele {id: "obj_main", kind: "give", target: "goldmuenze", npc: "weiser_aldric", state: "offen", main: 1}
    push ziele {id: "obj_side", kind: "kill", target: "kammerling", npc: "", state: "offen", main: 0}
    set doc "objectives" ziele
    seed_world_full doc
    save_game "wc_main"
    data: parse_json (read_file "saves/wc_main.json")
    restore_save data
    m: db_query (open_db 0) "SELECT main FROM objectives WHERE id = 'obj_side'"
    expect_eq (get (at m 0) "main") 0 "side flag survives save/load"
    m2: db_query (open_db 0) "SELECT main FROM objectives WHERE id = 'obj_main'"
    expect_eq (get (at m2 0) "main") 1 "main flag survives save/load"

test "cost baseline persists through save/restore"
    init_db 0
    reset_state 0
    restore_cost_baseline {cost: {cost_usd: 0.0042, calls: 3, tokens: 500, cache_hits: 1, cache_misses: 2}}
    mg: live_cost_state 0
    expect_eq (to_num (get mg "cost_usd")) (to_num 0.0042) "usd baseline"
    expect_eq (get mg "calls") 3 "calls baseline"
    expect_eq (get mg "tokens") 500 "tokens baseline"
    save_game "wc_cost"
    data: parse_json (read_file "saves/wc_cost.json")
    restore_cost_baseline {cost: {}}
    expect_eq (to_num (get (live_cost_state 0) "cost_usd")) 0 "reset to zero"
    restore_save data
    mg2: live_cost_state 0
    expect_eq (to_num (get mg2 "cost_usd")) (to_num 0.0042) "usd survives save/load"
    expect_eq (get mg2 "calls") 3 "calls survive save/load"
    expect_eq (get mg2 "tokens") 500 "tokens survive save/load"

test "pretty_room_name turns template ids into readable names"
    expect_eq (pretty_room_name "tpl_eingang") "Eingang" "prefix stripped and capitalized"
    expect_eq (pretty_room_name "tpl_schatzkammer") "Schatzkammer" "long id readable"
    expect_eq (pretty_room_name "ertrunkene_taverne") "Ertrunkene Taverne" "custom id with underscore"

test "expansion accepts custom themed room ids with name and description"
    doc: beispiel_doc 0
    exp_custom: {rooms: {ertrunkene_taverne: {name: "Die ertrunkene Taverne", description: "Salzwasser steht knöcheltief zwischen umgestürzten Stühlen.", items: ["heiltrank"]}}, links: [{anchor: "tpl_eingang", dir: "osten", room: "ertrunkene_taverne"}], npcs: [], monsters: []}
    expect_eq (len (validate_expansion exp_custom doc pack)) 0 "custom room id valid"

test "expansion rejects custom themed room ids without name or description"
    doc: beispiel_doc 0
    exp_ohne_name: {rooms: {ertrunkene_taverne: {description: "Salzwasser steht knöcheltief.", items: []}}, links: [{anchor: "tpl_eingang", dir: "osten", room: "ertrunkene_taverne"}], npcs: [], monsters: []}
    expect_gt (len (validate_expansion exp_ohne_name doc pack)) 0 "missing name rejected"
    exp_ohne_desc: {rooms: {ertrunkene_taverne: {name: "Die ertrunkene Taverne", items: []}}, links: [{anchor: "tpl_eingang", dir: "osten", room: "ertrunkene_taverne"}], npcs: [], monsters: []}
    expect_gt (len (validate_expansion exp_ohne_desc doc pack)) 0 "missing description rejected"

test "fehler_feedback is empty for first attempt and appends on retry"
    keine: []
    expect_eq (fehler_feedback "basis" nil keine) "basis" "nil prev returns base"
    fehler2: []
    push fehler2 "Fehler 1"
    push fehler2 "Fehler 2"
    fb: fehler_feedback "basis" "voriger" fehler2
    expect_contains fb "Letzter Versuch" "mentions previous attempt"
    expect_contains fb "Fehler 1" "lists first error"
    expect_contains fb "Fehler 2" "lists second error"

--- === Themen-getreue Basis-Karte (freie Raum-IDs) === ===

test "validate_raw_rooms accepts custom room ids with name and description"
    raw_ok: {rooms: {thronsaal: {name: "Der große Thronsaal", description: "Eisige Schwerter ragen aus dem Thron.", items: [], exits: {}}}, name: "X", start_room: "thronsaal", npcs: [], monsters: [], objectives: []}
    expect_eq (len (validate_raw_rooms raw_ok pack)) 0 "custom room valid"

test "validate_raw_rooms rejects custom room ids without name"
    raw_noname: {rooms: {thronsaal: {description: "Düster.", items: [], exits: {}}}, name: "X", start_room: "thronsaal", npcs: [], monsters: [], objectives: []}
    expect_gt (len (validate_raw_rooms raw_noname pack)) 0 "missing name flagged"

test "validate_raw_rooms rejects custom room ids without description"
    raw_nodesc: {rooms: {thronsaal: {name: "Der große Thronsaal", items: [], exits: {}}}, name: "X", start_room: "thronsaal", npcs: [], monsters: [], objectives: []}
    expect_gt (len (validate_raw_rooms raw_nodesc pack)) 0 "missing description flagged"

test "validate_raw_rooms rejects template rooms with kind-copied name"
    kind: get (find_room_template pack "tpl_eingang") "kind"
    raw_kind: {rooms: {tpl_eingang: {name: kind, description: "Ein Eingang.", items: [], exits: {}}}, name: "X", start_room: "tpl_eingang", npcs: [], monsters: [], objectives: []}
    expect_gt (len (validate_raw_rooms raw_kind pack)) 0 "kind-copy name flagged"

test "norm_id transliterates umlauts to clean ascii"
    expect_eq (norm_id "thronsaal") "thronsaal" "plain ascii stays"
    expect_eq (norm_id "gänge_unter_der_burg") "gaenge_unter_der_burg" "a-umlaut -> ae"
    expect_eq (norm_id "Schatzkammer_öst") "schatzkammer_oest" "o-umlaut -> oe + lowercase"
    expect_eq (norm_id "tiefe_höhlung") "tiefe_hoehlung" "u-umlaut -> ue"

test "sanitize_room_ids repairs umlaut ids and every reference"
    rooms_u: frische_map 0
    set rooms_u "gänge_unter_der_burg" {name: "Gänge", description: "Dunkel.", items: [], exits: {norden: "keller_des_ödens"}}
    set rooms_u "keller_des_ödens" {name: "Keller", description: "Feucht.", items: [], exits: {sueden: "gänge_unter_der_burg"}}
    raw_u: {name: "X", start_room: "gänge_unter_der_burg", rooms: rooms_u, npcs: [{id: "n1", room: "keller_des_ödens"}], monsters: [{id: "kammerling", room: "gänge_unter_der_burg"}], objectives: [{id: "o1", kind: "explore", target: "gänge_unter_der_burg"}]}
    raw_s: sanitize_room_ids raw_u
    rooms_s: get raw_s "rooms"
    expect_truthy (get (or_default rooms_s KEIN_MAP) "gaenge_unter_der_burg" != nil) "room key sanitized"
    expect_eq (get raw_s "start_room") "gaenge_unter_der_burg" "start room repaired"
    edu: get (get raw_s "rooms") "gaenge_unter_der_burg"
    expect_eq (get (get edu "exits") "norden") "keller_des_oedens" "exit repaired"
    expect_eq (get (at (or_default (get raw_s "npcs") KEIN_LISTE) 0) "room") "keller_des_oedens" "npc room repaired"
    expect_eq (get (at (or_default (get raw_s "monsters") KEIN_LISTE) 0) "room") "gaenge_unter_der_burg" "monster room repaired"
    expect_eq (get (at (or_default (get raw_s "objectives") KEIN_LISTE) 0) "target") "gaenge_unter_der_burg" "explore target repaired"

test "sanitize_expansion_ids repairs umlaut ids and links"
    rooms_e: frische_map 0
    set rooms_e "schatzkammer_des_östens" {name: "Schatzkammer", description: "Gold.", items: []}
    exp_u: {rooms: rooms_e, links: [{anchor: "tpl_eingang", dir: "osten", room: "schatzkammer_des_östens"}], npcs: [], monsters: []}
    exp_s: sanitize_expansion_ids exp_u
    rooms_es: get exp_s "rooms"
    expect_truthy (get (or_default rooms_es KEIN_MAP) "schatzkammer_des_oestens" != nil) "expansion room sanitized"
    expect_eq (get (at (or_default (get exp_s "links") KEIN_LISTE) 0) "room") "schatzkammer_des_oestens" "link repaired"
    expect_eq (get (at (or_default (get exp_s "links") KEIN_LISTE) 0) "anchor") "tpl_eingang" "existing anchor untouched"

test "normalize_map keeps custom room ids and pretty-falls back without name"
    raw_p: {name: "X", start_room: "thronsaal", rooms: {thronsaal: {name: "Der große Thronsaal", description: "Düster.", items: []}, schmiedegasse: {description: "Heiß und laut.", items: []}}, npcs: [], monsters: [], objectives: []}
    design_p: {quests: []}
    doc_p: normalize_map raw_p pack design_p
    expect_eq (get (get (get doc_p "rooms") "thronsaal") "name") "Der große Thronsaal" "custom name kept"
    expect_eq (get (get (get doc_p "rooms") "schmiedegasse") "name") (pretty_room_name "schmiedegasse") "pretty fallback for custom id"

test "custom thematic map passes full validation"
    design_g: {thema: "Eiserner Thron", ton: "düster", raumzahl: 3, items: ["fackel", "goldmuenze"], npcs: [{id: "lord_eddard", template: "weiser", name: "Lord Eddard"}], monsters: ["kammerling"], quests: [], siegesbedingung: {kind: "give", target: "goldmuenze", npc: "lord_eddard"}}
    raw_g: {name: "Der Eiserne Thron", start_room: "thronsaal", rooms: {thronsaal: {name: "Der große Thronsaal", description: "Eisige Schwerter ragen aus dem Thron.", items: ["fackel"], exits: {osten: "hof_der_roten_burg"}}, hof_der_roten_burg: {name: "Der Hof der Roten Burg", description: "Steinerne Mauern türmen sich.", items: [], exits: {westen: "thronsaal", norden: "drachengruft"}}, drachengruft: {name: "Die dunkle Drachengruft", description: "Knochen riesiger Bestien.", items: ["goldmuenze"], exits: {sueden: "hof_der_roten_burg"}}}, npcs: [{id: "lord_eddard", room: "thronsaal"}], monsters: [{id: "kammerling", room: "drachengruft"}], objectives: [{id: "obj_thron", kind: "give", target: "goldmuenze", npc: "lord_eddard", state: "offen"}]}
    expect_eq (len (validate_raw_rooms raw_g pack)) 0 "custom raw map valid"
    doc_g: normalize_map raw_g pack design_g
    expect_eq (len (validate_map doc_g pack)) 0 "custom map valid"

test "normalize_map drops invented items and monsters instead of failing"
    design_h: {thema: "Eiserner Thron", ton: "düster", raumzahl: 1, items: ["fackel"], npcs: [], monsters: ["kammerling"], quests: [], custom_items: [{id: "drachenei", name: "Drachenei", type: "quest", value: 1, tags: ["quest"], desc: "Ein glühendes Ei."}], siegesbedingung: {kind: "give", target: "goldmuenze", npc: ""}}
    raw_h: {name: "Der Eiserne Thron", start_room: "thronsaal", rooms: {thronsaal: {name: "Der große Thronsaal", description: "Eisig.", items: ["heilkraeuter", "drachenei", "mana_trank"], exits: {}}}, npcs: [], monsters: [{id: "kammerling", room: "thronsaal"}, {id: "eiskreatur", room: "thronsaal"}], objectives: []}
    doc_h: normalize_map raw_h pack design_h
    raum_items: get (get (get doc_h "rooms") "thronsaal") "items"
    expect_falsy (contains raum_items "heilkraeuter") "invented item dropped"
    expect_falsy (contains raum_items "mana_trank") "invented item dropped 2"
    expect_truthy (contains raum_items "drachenei") "custom item kept"
    expect_eq (len (get doc_h "monsters")) 1 "invented monster dropped"
    expect_eq (get (at (get doc_h "monsters") 0) "id") "kammerling" "real monster kept"

