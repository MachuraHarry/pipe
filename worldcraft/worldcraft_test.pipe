    p: (get_player 0)
    rid: get p "room"
    room_add_item rid "fackel"
    desc: look 0
    expect_contains desc "fackel" "item name shown"
    expect_contains desc "Fackel" "item description shown"

--- === Phase 2: Mana, Spells, XP, Monster Abilities === ===

test "mana initialized on new game"
    fresh_example 0
    p: (get_player 0)
    expect_gt (get p "mana") 0 "mana > 0"
    expect_gt (get p "max_mana") 0 "max_mana > 0"

test "spells seeded from pack"
    fresh_example 0
    spells_db: db_query (open_db 0) "SELECT * FROM spells"
    expect_gt (len spells_db) 0 "spells table has entries"

test "learn and know spell"
    fresh_example 0
    learn_spell "feuerball"
    expect_truthy (knows_spell "feuerball") "knows feuerball"
    sp: get_spell "feuerball"
    expect_eq (get sp "typ") "angriff" "spell type is angriff"
    spells: player_spells 0
    expect_eq (len spells) 1 "one spell learned"

test "player_spells lists learned spells"
    fresh_example 0
    learn_spell "feuerball"
    learn_spell "heilzauber"
    spells: player_spells 0
    expect_eq (len spells) 2 "two spells"

test "has_mana and spend_mana"
    fresh_example 0
    p: (get_player 0)
    mana_start: get p "mana"
    expect_gt mana_start 0 "starts with mana"
    spent: spend_mana mana_start
    p2: (get_player 0)
    expect_eq (get p2 "mana") 0 "mana is zero after spending all"
    spent2: spend_mana 1
    p3: (get_player 0)
    expect_eq (get p3 "mana") 0 "mana stays zero when over-spending"

test "adjust_mana caps at max"
    fresh_example 0
    p: (get_player 0)
    max_m: get p "max_mana"
    adjust_mana 999
    p2: (get_player 0)
    expect_eq (get p2 "mana") max_m "capped at max_mana"

test "xp system works"
    fresh_example 0
    expect_eq (get_xp 0) 0 "start with 0 xp"
    add_xp 25
    expect_eq (get_xp 0) 25 "25 xp after add"
    add_xp 10
    expect_eq (get_xp 0) 35 "35 xp after second add"

test "monster abilities seeded from pack"
    fresh_example 0
    abs: get_monster_abilities "ratte"
    expect_gt (len abs) 0 "ratte has abilities"

test "defend applies defense buff"
    fresh_example 0
    result: defend 0
    expect_contains result "Verteidigung" "defend message"
    expect_gt (get_buff "verteidigung") 0 "defense buff active"

test "show_spells shows mana and spells"
    fresh_example 0
    learn_spell "feuerball"
    sp_count: len (player_spells 0)
    expect_gt sp_count 0 "player has spells after learning"
    result: show_spells 0
    expect_contains result "Mana" "shows mana"

test "cast spell on monster"
    init_db 0
    reset_state 0
    set_pack pack
    load_world_doc "beispielwelt"
    seed_pack_extras pack
    new_game 0
    learn_spell "feuerball"
    p: (get_player 0)
    set_player_room "tpl_halle"
    db_exec (open_db 0) "INSERT INTO monsters VALUES ('test_dummi', 'Test Dummy', 'tpl_halle', 30, 30, 0, '', 0)"
    mana_before: get (get_player 0) "mana"
    result: cast_spell "feuerball" "test_dummi"
    expect_contains result "Energie" "spell hit text"
    expect_lt (get (get_player 0) "mana") mana_before "mana spent"

test "cast spell without enough mana"
    fresh_example 0
    learn_spell "feuerball"
    sp: get_spell "feuerball"
    kosten: get sp "manakosten"
    p: (get_player 0)
    adjust_mana (- (get p "mana") + kosten - 1)
    result: cast_spell "feuerball" "nix"
    expect_contains result "Nicht genug Mana" "not enough mana"

test "cast spell unknown spell fails"
    fresh_example 0
    result: cast_spell "nonsens" "nix"
    expect_contains result "kennst" "unknown spell"

test "save and load preserves mana and spells"
    fresh_example 0
    learn_spell "feuerball"
    spend_mana 3
    p: (get_player 0)
    mana_saved: get p "mana"
    save_game "test_phase2"
    init_db 0
    reset_state 0
    load_world_doc "beispielwelt"
    seed_pack_extras pack
    loaded: load_game "test_phase2"
    p2: (get_player 0)
    expect_eq (get p2 "mana") mana_saved "mana preserved after load"
    expect_truthy (knows_spell "feuerball") "spell preserved after load"

test "attack_enemy applies debuffs to damage"
    init_db 0
    reset_state 0
    set_pack pack
    load_world_doc "beispielwelt"
    seed_pack_extras pack
    new_game 0
    p: (get_player 0)
    set_player_room "tpl_halle"
    db_exec (open_db 0) "INSERT INTO monsters VALUES ('test_zombie', 'Zombie', 'tpl_halle', 50, 50, 0, '', 0)"
    apply_buff "schwaeche" 2 3
    inventory_add "schwert"
    result: attack_enemy "test_zombie"
    expect_contains result "Angriff" "attack message"

--- === Phase 5: Custom items, data-driven profiles, theme-aware narrator === ===

test "custom items can be seeded and found"
    init_db 0
    reset_state 0
    custom: [{id: "laserschwert", name: "Laserschwert", type: "waffe", value: 99, tags: ["energie", "kampf"], desc: "Ein schimmerndes Schwert aus reinem Licht.", damage_bonus: 5, ranged: false, use_effect: "none", use_value: 0, buff_stat: "", buff_value: 0, buff_rounds: 0, clear_stat: "", use_text: false}]
    seed_custom_items custom
    found: find_custom_item "laserschwert"
    expect_not_nil found "custom item found"
    expect_eq (get found "damage_bonus") 5 "damage_bonus stored"
    expect_eq (get found "type") "waffe" "type stored"

test "find_pack_item also finds custom items"
    init_db 0
    reset_state 0
    custom2: [{id: "plasmapistole", name: "Plasmapistole", type: "waffe", value: 80, tags: ["energie", "fern", "kampf"], desc: "Eine schwere Plasmapistole.", damage_bonus: 3, ranged: true, use_effect: "none", use_value: 0, buff_stat: "", buff_value: 0, buff_rounds: 0, clear_stat: "", use_text: false}]
    seed_custom_items custom2
    pack: get_pack 0
    found: find_pack_item pack "plasmapistole"
    expect_not_nil found "custom item found via find_pack_item"
    expect_eq (get found "ranged") true "ranged flag preserved"

test "data-driven use_item with custom consumable"
    init_db 0
    reset_state 0
    load_world_doc "beispielwelt"
    seed_pack_extras pack
    new_game 0
    custom3: [{id: "superheiltrank", name: "Superheiltrank", type: "konsum", value: 50, tags: ["heilung"], desc: "Ein leuchtend blauer Trank.", damage_bonus: 0, ranged: false, use_effect: "heal", use_value: 8, buff_stat: "", buff_value: 0, buff_rounds: 0, clear_stat: "", use_text: false}]
    seed_custom_items custom3
    inventory_add "superheiltrank"
    set_player_hp 2
    result: use_item "superheiltrank"
    expect_contains result "Superheiltrank" "custom heal item used"
    expect_eq (get (get_player 0) "hp") 10 "healed for 8"

test "apply_profile uses tag-based item lookup"
    init_db 0
    reset_state 0
    doc: parse_json (read_file "worlds/beispielwelt.json")
    -- Add a custom weapon to the pack items in the doc
    custom4: [{id: "energiesabel", name: "Energiesäbel", type: "waffe", value: 60, tags: ["energie", "kampf"], desc: "Ein leuchtender Säbel.", damage_bonus: 4, ranged: false, use_effect: "none", use_value: 0, buff_stat: "", buff_value: 0, buff_rounds: 0, clear_stat: "", use_text: false}]
    set doc "custom_items" custom4
    -- Create a modified pack that includes the custom item
    mod_pack: get_pack 0
    push (get mod_pack "items") (at custom4 0)
    -- apply_profile BEFORE seed_world (same order as worldcraft.pipe)
    apply_profile doc {stil: "kaempfer", schwierigkeit: "normal"} mod_pack
    seed_world_full doc
    new_game 0
    -- Should have the custom weapon (found via "kampf" tag) or the original schwert
    inv: parse_json (get (get_player 0) "inventory")
    expect_gt (len inv) 0 "kaempfer gets a weapon"

test "narrator_system returns theme-aware text"
    init_db 0
    reset_state 0
    set_meta "theme" "Cyberpunk"
    set_meta "ton" "neon-geschwängert"
    result: narrator_system 0
    expect_contains result "Cyberpunk" "theme in narrator"
    expect_contains result "neon-geschwängert" "ton in narrator"

test "narrator_system falls back to fantasy"
    init_db 0
    reset_state 0
    result: narrator_system 0
    expect_contains result "Fantasy" "default theme"
    expect_contains result "düster" "default ton"
