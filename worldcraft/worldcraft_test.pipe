--- === Phase 1: attack_enemy with pack mechanics === ===

test "attack reads waffen_bonus from pack mechanics"
    init_db 0
    reset_state 0
    load_world_doc "beispielwelt"
    seed_pack_extras pack
    new_game 0
    -- Set mechanics
    set_meta "mechanics" (to_json {attack_bonus_waffe: 5, heiltrank_heilung: 4, start_hp: 10, start_gold: 20, respawn_hp: 10})
    -- Place a weak monster in player room
    p: (get_player 0)
    set_player_room "tpl_halle"
    db_exec (open_db 0) "INSERT INTO monsters VALUES ('test_mon', 'Testmonster', 'tpl_halle', 20, 20, 0, '', 0)"
    inventory_add "schwert"
    -- Attack multiple times, should do at least 5 + 1 = 6 damage (5 waffen_bonus + 1-6 random)
    dmg_min: 999
    i: 0
    while i < 3
        result: attack_enemy "test_mon"
        rows: db_query (open_db 0) "SELECT hp FROM monsters WHERE id = 'test_mon'"
        if len rows > 0
            hp_now: get (at rows 0) "hp"
            if hp_now < dmg_min
                dmg_min: hp_now
        i: i + 1
    expect_lt dmg_min 18 "pack waffen_bonus (5) applied: at least 7 damage in one hit"

