--- === Welt-Wachstum (F4) === ===

fn beispiel_doc _
    parse_json (read_file "testdata/beispielwelt.json")

test "template clone ids are recognized"
    expect_truthy (is_template_id pack "tpl_dungeon_2") "clone recognized"
    expect_truthy (is_template_id pack "tpl_dungeon") "original recognized"
    expect_falsy (is_template_id pack "hoehle_x") "foreign id rejected"

test "valid expansion passes validation"
    doc6: beispiel_doc 0
    exp_neu: {rooms: {tpl_dungeon_2: {description: "Ein neuer Gang.", items: ["dietrich"]}}, links: [{anchor: "tpl_eingang", dir: "osten", room: "tpl_dungeon_2"}], npcs: [{id: "hofnarr_pipkin", room: "tpl_dungeon_2"}], monsters: []}
    expect_eq (len (validate_expansion exp_neu doc6 pack)) 0 "expansion valid"

test "expansion with occupied anchor direction fails"
    doc7: beispiel_doc 0
    exp_kaputt: {rooms: {tpl_dungeon_2: {description: "Gang.", items: []}}, links: [{anchor: "tpl_eingang", dir: "norden", room: "tpl_dungeon_2"}], npcs: [], monsters: []}
    expect_gt (len (validate_expansion exp_kaputt doc7 pack)) 0 "north occupied at entrance"

test "expansion with existing npc fails"
    doc8: beispiel_doc 0
    exp_doppelt: {rooms: {tpl_dungeon_2: {description: "Gang.", items: []}}, links: [{anchor: "tpl_eingang", dir: "osten", room: "tpl_dungeon_2"}], npcs: [{id: "weiser_aldric", room: "tpl_dungeon_2"}], monsters: []}
    expect_gt (len (validate_expansion exp_doppelt doc8 pack)) 0 "npc already placed"

test "merge_expansion grows world and keeps it connected"
    init_db 0
    reset_state 0
    doc9: beispiel_doc 0
    seed_full doc9
    new_game 0
    exp_ok: {rooms: {tpl_brunnen_2: {description: "Ein verborgener Garten.", items: ["heiltrank"]}, tpl_turm_2: {description: "Ein Nebenzimmer des Turms.", items: []}}, links: [{anchor: "tpl_eingang", dir: "osten", room: "tpl_brunnen_2"}, {anchor: "tpl_brunnen_2", dir: "norden", room: "tpl_turm_2"}], npcs: [{id: "kraeuterfrau_mira", room: "tpl_brunnen_2"}], monsters: [{id: "spinnlinge", room: "tpl_turm_2"}]}
    expect_eq (len (validate_expansion exp_ok doc9 pack)) 0 "multi-room expansion valid"
    bericht: merge_expansion exp_ok doc9 pack
    expect_contains bericht "Die Welt wächst" "summary returned"
    expect_eq (get doc9 "expansionen") 1 "counter bumped"
    -- combined map must be fully reachable from start
    kombiniert: validate_map doc9 pack
    expect_eq (len kombiniert) 0 "merged world still consistent"
    -- live DB knows the new rooms
    move_to "osten"
    expect_eq (get (get_player 0) "room") "tpl_brunnen_2" "walked into expansion"
    expect_contains (npcs_in_room "tpl_brunnen_2") "kraeuterfrau_mira" "npc placed in db"
    -- backlink exists automatically
    neu_r: get (get doc9 "rooms") "tpl_brunnen_2"
    expect_eq (get (get neu_r "exits") "westen") "tpl_eingang" "backlink added"

