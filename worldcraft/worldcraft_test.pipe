    set doc10 "quests" neue_q
    obj_mit_quest: [{id: "obj_gabe", kind: "give", target: "goldmuenze", npc: "weiser_aldric", state: "offen", quest: "q_gabe_des_erbes"}]
    set doc10 "objectives" obj_mit_quest
    seed_world_full doc10
    new_game 0
