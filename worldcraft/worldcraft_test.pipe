--- === Phase 2: Mana, Spells, XP, Monster Abilities === ===

test "mana initialized on new game"
    fresh_example 0
    p: (get_player 0)
    expect_gt (get p "mana") 0 "mana > 0"
    expect_gt (get p "max_mana") 0 "max_mana > 0"

test "spells seeded from pack"
    fresh_example 0
    spells_db: db_query (open_db 0) "SELECT * FROM spells"
    expect_gt (len spells_db) 0 "spells table has entries"

test "learn and know spell"
    fresh_example 0
    learn_spell "feuerball"
    expect_truthy (knows_spell "feuerball") "knows feuerball"
    sp: get_spell "feuerball"
    expect_eq (get sp "typ") "angriff" "spell type is angriff"
    spells: player_spells 0
    expect_eq (len spells) 1 "one spell learned"

test "player_spells lists learned spells"
    fresh_example 0
    learn_spell "feuerball"
    learn_spell "heilzauber"
    spells: player_spells 0
    expect_eq (len spells) 2 "two spells"

test "has_mana and spend_mana"
    fresh_example 0
    p: (get_player 0)
    mana_start: get p "mana"
    expect_gt mana_start 0 "starts with mana"
    spent: spend_mana mana_start
    p2: (get_player 0)
    expect_eq (get p2 "mana") 0 "mana is zero after spending all"
    spent2: spend_mana 1
    p3: (get_player 0)
    expect_eq (get p3 "mana") 0 "mana stays zero when over-spending"

test "adjust_mana caps at max"
    fresh_example 0
    p: (get_player 0)
    max_m: get p "max_mana"
    adjust_mana 999
    p2: (get_player 0)
    expect_eq (get p2 "mana") max_m "capped at max_mana"

test "xp system works"
    fresh_example 0
    expect_eq (get_xp 0) 0 "start with 0 xp"
    add_xp 25
    expect_eq (get_xp 0) 25 "25 xp after add"
    add_xp 10
    expect_eq (get_xp 0) 35 "35 xp after second add"

test "leveling increases player stats"
    fresh_example 0
    add_xp 50
    p: get_player 0
    expect_eq (player_level 0) 2 "level two after 50 xp"
    expect_eq (get p "max_hp") 15 "level grants hp"
    expect_eq (get p "hp") 15 "level heals with hp gain"
    expect_eq (get p "max_mana") 17 "level grants mana"

test "monster abilities seeded from pack"
    fresh_example 0
    abs: get_monster_abilities "ratte"
    expect_gt (len abs) 0 "ratte has abilities"

test "defend applies defense buff"
