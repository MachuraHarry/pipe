    expect_contains result "Energie" "spell hit text"
    expect_lt (get (get_player 0) "mana") mana_before "mana spent"

test "cast spell without enough mana"
    fresh_example 0
    learn_spell "feuerball"
    sp: get_spell "feuerball"
    kosten: get sp "manakosten"
    p: (get_player 0)
    adjust_mana (- (get p "mana") + kosten - 1)
    result: cast_spell "feuerball" "nix"
    expect_contains result "Nicht genug Mana" "not enough mana"

test "cast spell unknown spell fails"
    fresh_example 0
    result: cast_spell "nonsens" "nix"
    expect_contains result "kennst" "unknown spell"

test "save and load preserves mana and spells"
    fresh_example 0
    learn_spell "feuerball"
    spend_mana 3
    p: (get_player 0)
    mana_saved: get p "mana"
    save_game "test_phase2"
    init_db 0
    reset_state 0
    load_example_world 0
    seed_pack_extras pack
    loaded: load_game "test_phase2"
    p2: (get_player 0)
    expect_eq (get p2 "mana") mana_saved "mana preserved after load"
    expect_truthy (knows_spell "feuerball") "spell preserved after load"

test "attack_enemy applies debuffs to damage"
